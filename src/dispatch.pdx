// src/dispatch.pdx -- shell.ENH-004 (paideia-os/shell#31)
//
// Dispatch module: builtin lookup table + line dispatcher.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The "no builtin dispatch table" gap the enhancement-plan §Stage 2 /
// ENH-004 issue calls out. At v1.0.0 (and through ENH-003) NO
// `builtin` symbol existed in `src/`, `caps.decl`, or
// `design/architecture.md`. This module introduces the concept and the
// runtime-loaded triple table:
//
//   _bi_names       [u64; BI_TABLE_MAX]   pointer to NUL-terminated name
//   _bi_name_lens   [u64; BI_TABLE_MAX]   precomputed name length (excl NUL)
//   _bi_handlers    [u64; BI_TABLE_MAX]   function pointer (u64) -> u64
//   _bi_count       u64                    populated slots (== 4 at ENH-004)
//
// Same three-parallel-arrays shape the monorepo's canonical dispatch
// uses at src/user/dispatch.pdx:71-74 (builtin_names / builtin_handlers
// / builtin_descs). Adds a `_bi_name_lens` variant to avoid a per-lookup
// strlen scan of every candidate name -- the argv[0] length is known
// from the byte walker in dispatch_line, so a fast length gate rejects
// most candidates before the byte-compare loop.
//
// BI_TABLE_MAX is 16 to leave 11 slots of growth headroom above the
// five landed builtins (cd/exit/export/pwd/help at shell#29-help);
// ENH-005+ additions (env/echo/clear/history/jobs/type/which/alias/
// unalias/read/wait) fit under the cap without a re-layout. The 16 vs
// the 5 also documents at a glance that this table is DELIBERATELY
// under-populated at this landing rather than "just big enough today".
//
// The names themselves live as short byte-array constants in this
// module (`bi_name_cd`, `bi_name_exit`, `bi_name_export`, `bi_name_pwd`,
// `bi_name_help`). Populated at startup by `dispatch_init` because
// paideia-as does not support address-of-symbol in static array
// initializers -- the LEA pattern in `dispatch_init` mirrors the
// monorepo's `dispatch_init` at src/user/dispatch.pdx:104.
// `dispatch_init` also calls `bi_env_reset` (from Builtins) so the
// shell-local env table starts clean at startup / session reset.
//
// =============================================================================
// dispatch_line(argv_ptr, argc) -> u64
// =============================================================================
//
// The load-bearing entry point. Called by the REPL (ENH-006) once per
// pipeline stage that has argc >= 1. Signature:
//
//   fn (argv_ptr: u64, argc: u64) -> u64
//
// argv_ptr    -- VA of the stage's argv byte pool slice
//                (typically `_pr_argv_pool + stage.argv_offset`, but
//                any NUL-separated argv byte layout works -- dispatch
//                is decoupled from Parser's `_pr_stages` shape).
// argc        -- number of words in that slice.
// Return:
//   BI_HIT_OK (0) if the matched handler returned BI_OK.
//   A BI_ERR_* value if the matched handler returned a specific
//     handler-scoped error (definitions in Builtins module).
//   BI_MISS (0xFFFFECE0) if no builtin name matched argv[0] -- the
//     REPL then tries the external exec path.
//
// The BI_MISS sentinel is deliberately not an "error" -- it is the
// signal to the REPL that the external command path (ENH-005) should
// be attempted. 0xFFFFECE0 sits at the top of the 0xFFFFECEx band with
// the actual handler errors (0xFFFFECE1..0xFFFFECE7) below it -- an
// operator reading a return code can tell "dispatch never found the
// name" from "dispatch found the name but the handler refused" at a
// glance.
//
// argc == 0 is treated as BI_MISS (nothing to dispatch on) rather than
// a distinct error; the REPL should never call dispatch_line for an
// empty stage (Parser rejects those with PR_ERR_EMPTY_STAGE), but the
// defensive path avoids a null argv[0] load.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Dispatch`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF (largest is 16 for
//     the BI_TABLE_MAX gate; fits imm32 trivially).
//   - Large immediate 0xFFFFECE0 (BI_MISS) emitted via `mov rax, imm32`.
//   - r11 reserved as .bss LEA scratch for the singletons.
//   - Byte reads via `xor rax, rax; mov_b rax, [ptr]` (#1248 mitigation).
//   - dispatch_init is a leaf function (no nested calls except a single
//     `call bi_env_reset` at the end; alignment via bare 5-push +
//     no-sub gives rsp%16==0 for that call).
//   - dispatch_line is non-leaf: nested `call rax` to the handler
//     function pointer. 5 callee-save pushes (rbx table index, r12
//     argv_ptr, r13 argc, r14 argv0_len, r15 candidate walker) = 40
//     bytes prologue. Entry rsp%16==8; after 5 pushes rsp%16==0;
//     no local scratch, so no `sub rsp, N`. rsp%16==0 at the nested
//     `call rax`.

module Dispatch = structure {

  // ==========================================================================
  // Table caps
  // ==========================================================================
  pub let BI_TABLE_MAX : u64 = 16
  pub let BI_TABLE_N   : u64 = 5         // cd, exit, export, pwd, help (shell#29-help)

  // ==========================================================================
  // Dispatcher return-code sentinel (part of the 0xFFFFECEx band; the
  // handler-specific errors live in Builtins).
  // ==========================================================================
  pub let BI_HIT_OK : u64 = 0            // == Builtins::BI_OK
  pub let BI_MISS   : u64 = 0xFFFFECE0

  // ==========================================================================
  // Argv-construction return-code band 0xFFFFEBAx (R106.SHELL-002, #41)
  //
  // dispatch_argv_construct returns AC_OK (0) on success and one of the
  // sentinels below on failure. Disjoint from the 0xFFFFEB0x tokenizer
  // band (0xFFFFEB01..0xFFFFEB04, 0xFFFFEB06) so a downstream operator
  // can tell "tokenizer refused input" from "argv-construction refused
  // expansion" by the second-nibble alone (Bx vs 0x). See paideia-os
  // design/user/content-addressed-identity.md §4 for the underlying
  // semantic error taxonomy this band names.
  //
  //   AC_ERR_BAD_ARGS         0xFFFFEBA0  desc_ptr NULL, or any zero-cap
  //                                        buffer with a non-zero source
  //   AC_ERR_POOL_OVERFLOW    0xFFFFEBA1  pool_used + needed > pool_cap
  //                                        for the current token's
  //                                        expansion
  //   AC_ERR_ARGC_OVERFLOW    0xFFFFEBA2  argc == off_cap on emit of the
  //                                        next argv[i]
  //   AC_ERR_HOME_MISSING     0xFFFFEBA3  TILDE_KIND_HOME with home_len
  //                                        == 0 (envp did not carry
  //                                        HOME=; refuse expansion,
  //                                        never fall through to a
  //                                        silent literal '~')
  //   AC_ERR_ALIAS_UNRESOLVED 0xFFFFEBA4  TILDE_KIND_ALIAS + the R106
  //                                        stub kernel backend returns
  //                                        E_ALIAS_UNRESOLVED for every
  //                                        symbolic name. At R108.M4 the
  //                                        real KIND_USER_ALIAS.lookup
  //                                        replaces the stub in-place;
  //                                        this shell code does not
  //                                        change then, only the
  //                                        kernel-side backend flips.
  //   AC_ERR_FP_MALFORMED     0xFFFFEBA5  bubbled verbatim from
  //                                        tokenizer_tilde_classify's
  //                                        TOK_ERR_FINGERPRINT_MALFORMED
  //                                        return (rebadged with the
  //                                        argv-construction band so
  //                                        the caller decodes it here)
  // ==========================================================================
  pub let AC_OK                  : u64 = 0
  pub let AC_ERR_BAD_ARGS        : u64 = 0xFFFFEBA0
  pub let AC_ERR_POOL_OVERFLOW   : u64 = 0xFFFFEBA1
  pub let AC_ERR_ARGC_OVERFLOW   : u64 = 0xFFFFEBA2
  pub let AC_ERR_HOME_MISSING    : u64 = 0xFFFFEBA3
  pub let AC_ERR_ALIAS_UNRESOLVED : u64 = 0xFFFFEBA4
  pub let AC_ERR_FP_MALFORMED    : u64 = 0xFFFFEBA5

  // "/home/" prefix used by the FINGERPRINT expansion path. Stored as
  // a NUL-terminated [u8; 7] rodata slot per the paideia-as fingerprint-
  // string rule (N == strlen + 1); the NUL byte is a tag-size sentinel
  // and is NOT written to the pool -- the runtime copy uses length 6
  // (AC_HOME_PREFIX_LEN) verbatim.
  pub let ac_home_prefix       : [u8; 7] = "/home/\0"
  pub let AC_HOME_PREFIX_LEN   : u64 = 6

  // ==========================================================================
  // Builtin name literals.
  //
  // Each is a NUL-terminated .rodata byte string; N in `[u8; N]` MUST
  // equal strlen+1 per the paideia-as fingerprint-string rule from
  // feedback_pdx_encoder_pitfalls (same shape the tests/test_syscall_
  // floor.pdx _tsf_msg fixture uses). Precomputed lengths (excl NUL)
  // land as constants below so dispatch_line's length gate does not
  // need a strlen pass over each candidate.
  // ==========================================================================
  pub let bi_name_cd     : [u8; 3] = "cd\0"
  pub let bi_name_exit   : [u8; 5] = "exit\0"
  pub let bi_name_export : [u8; 7] = "export\0"
  pub let bi_name_pwd    : [u8; 4] = "pwd\0"
  pub let bi_name_help   : [u8; 5] = "help\0"
  // shell#22 / #23 / #24 job-control builtin names.
  pub let bi_name_jobs   : [u8; 5] = "jobs\0"
  pub let bi_name_bg     : [u8; 3] = "bg\0"
  pub let bi_name_fg     : [u8; 3] = "fg\0"

  pub let BI_NAME_LEN_CD     : u64 = 2
  pub let BI_NAME_LEN_EXIT   : u64 = 4
  pub let BI_NAME_LEN_EXPORT : u64 = 6
  pub let BI_NAME_LEN_PWD    : u64 = 3
  pub let BI_NAME_LEN_HELP   : u64 = 4
  pub let BI_NAME_LEN_JOBS   : u64 = 4
  pub let BI_NAME_LEN_BG     : u64 = 2
  pub let BI_NAME_LEN_FG     : u64 = 2

  // ==========================================================================
  // Runtime-loaded triple table (.bss).
  //
  // Populated by dispatch_init at startup; readers see zero on any slot
  // past `_bi_count` (uninit @align(8) zero-inits at loader time). Same
  // shape as monorepo Dispatch::builtin_names / builtin_handlers /
  // builtin_descs at src/user/dispatch.pdx:71-74.
  // ==========================================================================
  pub let mut _bi_names     : [u64; 16] = uninit @align(8)
  pub let mut _bi_name_lens : [u64; 16] = uninit @align(8)
  pub let mut _bi_handlers  : [u64; 16] = uninit @align(8)
  pub let mut _bi_count     : u64       = uninit @align(8)

  // ==========================================================================
  // dispatch_init()
  //
  // Signature: dispatch_init : () -> () !{mem} @{}
  //
  // Populate the five runtime-loaded slots with (name_ptr, name_len,
  // handler_ptr) triples in the fixed order cd / exit / export / pwd /
  // help. Sets _bi_count = 5. Then calls bi_env_reset to clear the
  // shell-local env table (fresh startup / session reset invariant).
  //
  // Order note: `help` lands at index 4 (last) so pre-existing callers
  // that hard-coded index positions for cd/exit/export/pwd (indices
  // 0..3) still resolve the same handler. New builtins should always
  // append at the tail for this reason.
  //
  // Called once from _start / Shell::shell_main before the REPL begins
  // reading lines (ENH-006 wiring). Leaf-ish: one nested `call bi_env_
  // reset` at the tail. 5-push prologue (rbx unused but kept for
  // alignment uniformity would be wasteful) -- actually no callee-save
  // needed here; r11 for .bss LEA + rax for handler-ptr staging is all.
  // Alignment for the single nested call: entry rsp%16==8; use `sub rsp,
  // 8` -> rsp%16==0 for the call; `add rsp, 8` before ret.
  //
  // Order matters: the table indices below MUST match _bi_name_lens
  // slots (index i has name at _bi_names[i], length at _bi_name_lens[i],
  // handler at _bi_handlers[i]).
  // ==========================================================================
  pub let dispatch_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-004 (#31) + shell#29-help: populate the runtime-loaded builtin dispatch table at startup. Loads (name_ptr, name_len, handler_ptr) for cd/exit/export/pwd at indices 0..3 (ENH-004) and help at index 4 (shell#29-help), then sets _bi_count = 5. Calls bi_env_reset (from Builtins) to clear the shell-local env table so the first `export` lands at slot 0. Table populated at runtime rather than statically because paideia-as does not support address-of-symbol in static array initializers (same reason monorepo dispatch_init at src/user/dispatch.pdx:104 uses this idiom). r11 as .bss LEA scratch, rax for name/handler pointer staging. `sub rsp, 8` prologue aligns rsp%16==0 for the single nested `call bi_env_reset`; matched `add rsp, 8` before ret. Labels prefixed bi_di_ (none needed -- linear body).",
      block: {
        sub rsp, 8;                          // align rsp % 16 for bi_env_reset call

        // _bi_names[0..7]
        lea r11, [rip + _bi_names];
        lea rax, [rip + bi_name_cd];
        mov [r11 + 0], rax;
        lea rax, [rip + bi_name_exit];
        mov [r11 + 8], rax;
        lea rax, [rip + bi_name_export];
        mov [r11 + 16], rax;
        lea rax, [rip + bi_name_pwd];
        mov [r11 + 24], rax;
        lea rax, [rip + bi_name_help];
        mov [r11 + 32], rax;
        lea rax, [rip + bi_name_jobs];
        mov [r11 + 40], rax;
        lea rax, [rip + bi_name_bg];
        mov [r11 + 48], rax;
        lea rax, [rip + bi_name_fg];
        mov [r11 + 56], rax;

        // _bi_name_lens[0..7]
        lea r11, [rip + _bi_name_lens];
        mov rax, 2;                          // strlen("cd")
        mov [r11 + 0], rax;
        mov rax, 4;                          // strlen("exit")
        mov [r11 + 8], rax;
        mov rax, 6;                          // strlen("export")
        mov [r11 + 16], rax;
        mov rax, 3;                          // strlen("pwd")
        mov [r11 + 24], rax;
        mov rax, 4;                          // strlen("help")
        mov [r11 + 32], rax;
        mov rax, 4;                          // strlen("jobs")
        mov [r11 + 40], rax;
        mov rax, 2;                          // strlen("bg")
        mov [r11 + 48], rax;
        mov rax, 2;                          // strlen("fg")
        mov [r11 + 56], rax;

        // _bi_handlers[0..7]
        lea r11, [rip + _bi_handlers];
        lea rax, [rip + bi_cd];
        mov [r11 + 0], rax;
        lea rax, [rip + bi_exit];
        mov [r11 + 8], rax;
        lea rax, [rip + bi_export];
        mov [r11 + 16], rax;
        lea rax, [rip + bi_pwd];
        mov [r11 + 24], rax;
        lea rax, [rip + bi_help];
        mov [r11 + 32], rax;
        lea rax, [rip + bi_jobs];
        mov [r11 + 40], rax;
        lea rax, [rip + bi_bg];
        mov [r11 + 48], rax;
        lea rax, [rip + bi_fg];
        mov [r11 + 56], rax;

        // _bi_count = 8
        lea r11, [rip + _bi_count];
        mov rax, 8;
        mov [r11], rax;

        // Reset shell-local env table so startup is a clean baseline.
        call bi_env_reset;

        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // dispatch_line(argv_ptr, argc) -> u64
  //
  // Signature: dispatch_line : (u64, u64) -> u64 !{mem, sysreg} @{fs}
  // RDI: argv_ptr -- VA of NUL-separated argv byte slice
  // RSI: argc     -- number of words in that slice
  //
  // Returns:
  //   BI_HIT_OK (0) or BI_ERR_* if a handler matched and returned
  //   BI_MISS (0xFFFFECE0) if no builtin name matched argv[0]
  //
  // The effect / capability set is the UNION of every handler's
  // {!{mem, sysreg} @{fs}} plus the dispatcher's own {mem} for the
  // .bss table reads. The widest handler (bi_cd, bi_pwd) is
  // {!{mem, sysreg} @{fs}}; the union with bi_exit's {sysreg} @{sched}
  // would strictly need {mem, sysreg} @{fs, sched} on the wrapper, but
  // sched escapes via sys_exit's own annotation into the caller of
  // dispatch_line naturally without needing to be declared here (the
  // effect propagation model already unions along the call graph);
  // declaring {mem, sysreg} @{fs} matches the widest fs-touching
  // handler set which is the dominant use case. A future auditor
  // checking effects would still see @{sched} at sys_exit's own site
  // via the call graph.
  //
  // Algorithm:
  //
  //   if argc == 0: return BI_MISS
  //   argv0_len = walker_strlen(argv_ptr)
  //   for i in 0.._bi_count:
  //     if _bi_name_lens[i] != argv0_len: continue     (fast length gate)
  //     if bytes(argv_ptr, _bi_names[i], argv0_len) match:
  //       return _bi_handlers[i](argv_ptr, argc)
  //   return BI_MISS
  //
  // Byte compare is inline (no memcmp dependency): scan argv0_len bytes
  // via `xor rax, rax; mov_b rax, [r10]; xor r8, r8; mov_b r8, [r15];
  // cmp rax, r8; jne next-candidate`. Same shape monorepo dispatch_line
  // uses at src/user/dispatch.pdx:171 (minus the strlen call there,
  // which we avoid via the precomputed _bi_name_lens gate).
  //
  // Register plan:
  //   r12 = argv_ptr (callee-save)
  //   r13 = argc (callee-save)
  //   r14 = argv0_len (callee-save; computed once)
  //   r15 = candidate name walker (callee-save; reset per iteration)
  //   rbx = table index i (callee-save)
  //   r11 = .bss LEA scratch
  //   r10 = argv0 walker (per iteration; reset from r12)
  //   r8, rax, rcx = short-scratch (byte load / arithmetic / return)
  //
  // Prologue: 5 pushes (40 bytes). Entry rsp%16==8; after 5 pushes
  // rsp%16==0; no local scratch, so no `sub rsp, N`. Every nested
  // `call rax` sees rsp%16==0.
  // ==========================================================================
  pub let dispatch_line : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (argv_ptr: u64) (argc: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-004 (#31) + shell#29-help: builtin lookup + dispatch. Walks the runtime-loaded _bi_names / _bi_name_lens / _bi_handlers triple; fast length gate via _bi_name_lens skips the byte-compare loop for any candidate of the wrong length. Post shell#29-help the five landed names have lengths 2/4/6/3/4 -- length alone disambiguates 3 of 5 candidates for either exit or help (the two length-4 names), and reaches byte compare only on the length-matching subset. On hit, calls the handler with (argv_ptr, argc) preserved through argc/r13 and argv_ptr/r12 across the byte-compare loop. On miss (no candidate matched or argc==0), returns BI_MISS (0xFFFFECE0) so the caller's REPL (ENH-006) can try the external exec path. Effect/cap set {mem, sysreg} @{fs} matches the widest handler (bi_cd/bi_pwd/bi_help); bi_exit's sched effect propagates through the call graph at sys_exit's own annotation. Prologue: 5 callee-save pushes (40 bytes; no local scratch). Entry rsp%16==8; after 5 pushes rsp%16==0; every nested `call rax` sees rsp%16==0. Labels prefixed dp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // argv_ptr
        mov r13, rsi;                        // argc

        cmp r13, 0;
        je dp_miss;

        // Compute argv[0] length by walking from argv_ptr until NUL.
        xor r14, r14;                        // argv0_len
        mov r15, r12;                        // walker
      dp_argv0_len:
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0;
        je dp_argv0_len_done;
        add r14, 1;
        add r15, 1;
        jmp dp_argv0_len;
      dp_argv0_len_done:
        // r14 = argv0_len

        xor rbx, rbx;                        // table index i = 0
      dp_scan:
        lea r11, [rip + _bi_count];
        mov rax, [r11];
        cmp rbx, rax;
        jae dp_miss;

        // Length gate.
        lea r11, [rip + _bi_name_lens];
        mov rax, [r11 + rbx * 8];
        cmp rax, r14;
        jne dp_next;

        // Byte compare: r10 walks argv[0], r15 walks candidate name.
        lea r11, [rip + _bi_names];
        mov r15, [r11 + rbx * 8];            // candidate name_ptr
        mov r10, r12;                        // argv[0] ptr
        mov rcx, r14;                        // remaining bytes
      dp_cmp_loop:
        cmp rcx, 0;
        je dp_hit;
        xor rax, rax;
        mov_b rax, [r10];
        xor r8, r8;
        mov_b r8, [r15];
        cmp rax, r8;
        jne dp_next;
        add r10, 1;
        add r15, 1;
        sub rcx, 1;
        jmp dp_cmp_loop;

      dp_hit:
        // Handler(argv_ptr, argc) via _bi_handlers[rbx].
        lea r11, [rip + _bi_handlers];
        mov rax, [r11 + rbx * 8];
        mov rdi, r12;                        // argv_ptr
        mov rsi, r13;                        // argc
        call rax;
        // rax = handler return (BI_OK or BI_ERR_*)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      dp_next:
        add rbx, 1;
        jmp dp_scan;

      dp_miss:
        mov rax, 0xFFFFECE0;                 // BI_MISS
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _ac_copy_bytes(src, dst, len) -> ()
  //
  // Internal helper for dispatch_argv_construct's kind-specific pool
  // writes. Byte-at-a-time forward copy of `len` bytes from `src` to
  // `dst`; both pointers are consumed as inputs (not advanced for the
  // caller). Neither source nor destination is checked for overlap;
  // the caller (dispatch_argv_construct) guarantees the pool cursor
  // moves strictly forward and never re-enters a written region.
  //
  // Signature:
  //   fn (src: u64, dst: u64, len: u64) -> ()
  //   rdi = src, rsi = dst, rdx = len
  //
  // Leaf function; no push/pop / no sub rsp. Alignment: entry rsp %
  // 16 == 8 as caller passed; ret restores rsp % 16 == 0 for the
  // caller (matching every SysV ret site). All byte moves use the
  // #1248 pattern (xor rax, rax; mov_b rax, [ptr]) on the read side
  // and `mov_b [dst], rax` on the write side. No 2-op imul, no test
  // mnemonic, no imm > 0x7FFFFFFF; r11 (paideia-as reserved) unused.
  // Labels prefixed acb_.
  // ==========================================================================
  pub let _ac_copy_bytes : (u64, u64, u64) -> () !{mem} @{} =
    fn (src: u64) (dst: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R106.SHELL-002 (paideia-os/shell#41): byte-at-a-time forward memcpy helper for dispatch_argv_construct's expansion pool writes. rdi=src, rsi=dst, rdx=len. Leaf; no push/pop; byte loads use xor rax, rax; mov_b rax, [ptr] per #1248, byte stores use mov_b [dst], rax. Caller (dispatch_argv_construct) guarantees dst > (all prior src) so overlap is impossible. Trivial linear body; the alternative was to inline five ~10-line copy loops in dispatch_argv_construct's kind blocks, which loses the single-audit-site invariant this helper provides. Labels prefixed acb_.",
      block: {
        cmp rdx, 0;
        je acb_done;
      acb_loop:
        xor rax, rax;
        mov_b rax, [rdi];
        mov_b [rsi], rax;
        add rdi, 1;
        add rsi, 1;
        sub rdx, 1;
        cmp rdx, 0;
        jne acb_loop;
      acb_done:
        ret
      }
    }

  // ==========================================================================
  // dispatch_argv_construct(desc_ptr) -> u64
  //
  // R106.SHELL-002 (paideia-os/shell#41). Takes the tokenizer's raw
  // (offset, length) records over a source line, applies novel-tilde
  // classification + expansion (with $HOME from envp and the
  // KIND_USER_ALIAS stub for R106), and emits a NUL-separated argv
  // pool + per-argv offset table for consumption by dispatch_line.
  //
  // Signature:
  //   fn (desc_ptr: u64) -> u64
  //   rdi = desc_ptr (VA of the ArgvConstructDesc struct)
  //   rax = AC_OK (0) on success; AC_ERR_* sentinel on any failure
  //
  // Descriptor layout (13 u64 = 104 bytes; caller-allocated,
  // typically on .bss @align(8) or on the caller's stack):
  //
  //   +  0  tok_ptr        input: array of 16-byte (offset, length)
  //                        records (Tokenizer output shape)
  //   +  8  tok_count      input: number of token records
  //   + 16  src_ptr        input: base VA the token offsets are
  //                        relative to (typically the original line
  //                        buffer)
  //   + 24  src_len        input: bytes in source line (bounds sanity;
  //                        not enforced per byte -- the tokenizer's
  //                        length field is authoritative)
  //   + 32  pool_out_ptr   output: byte pool for expanded argv strings
  //   + 40  pool_cap       output cap: pool_out_ptr[0..pool_cap)
  //   + 48  off_out_ptr    output: qword array holding per-argv start
  //                        offset into pool_out (argv[i] byte VA =
  //                        pool_out_ptr + off_out_ptr[i])
  //   + 56  off_cap        output cap: max argv[] slots
  //   + 64  home_ptr       input: $HOME string from envp
  //   + 72  home_len       input: bytes in $HOME (no NUL)
  //   + 80  alias_cap      input: KIND_USER_ALIAS handle (0 = stub /
  //                        no cap available -- every alias hits
  //                        AC_ERR_ALIAS_UNRESOLVED at R106; R108.M4
  //                        flips the backend and this field becomes
  //                        load-bearing)
  //   + 88  pool_used_out  output: bytes written to pool_out on success
  //   + 96  argc_out       output: argv count written on success
  //
  // Expansion rules (see Tokenizer::tokenizer_tilde_classify header
  // for the classification decision matrix; this function performs
  // the byte-write half):
  //
  //   NONE          copy tok_bytes[0..tok_length] + NUL
  //   HOME          copy home_ptr[0..home_len] + tok_bytes[1..len] + NUL
  //                 (empty home_len -> AC_ERR_HOME_MISSING)
  //   FINGERPRINT   copy "/home/" (6 bytes) + tok_bytes[1..len] + NUL
  //                 (the segment is bytes[1..1+64] plus tail bytes
  //                 [1+64..len]; concatenated in the source they are
  //                 exactly tok_bytes[1..len], so a single _ac_copy_
  //                 bytes suffices for the fingerprint + tail)
  //   ALIAS         -> AC_ERR_ALIAS_UNRESOLVED (R106 stub; every
  //                 symbolic name currently unresolved)
  //   MALFORMED     -> AC_ERR_FP_MALFORMED
  //
  // Register plan (non-leaf; nested `call tokenizer_tilde_classify`
  // and `call _ac_copy_bytes`):
  //   rbx = i (loop index, callee-save)
  //   rbp = argc accumulator (callee-save)
  //   r12 = pool_used accumulator (callee-save)
  //   r13 = desc_ptr (callee-save; read repeatedly for struct fields)
  //   r14 = current tok_length (callee-save; survives classify call)
  //   r15 = current tok_bytes ptr = src_ptr + tok_offset (callee-save)
  //
  // 6 callee-save pushes = 48 bytes; 48 mod 16 == 0, so after the
  // pushes alone rsp % 16 stays at 8 (entry alignment unchanged). We
  // need one `sub rsp, 8` on top of the 6 pushes to reach rsp % 16 ==
  // 0 for the nested SysV calls -- matched `add rsp, 8` at the shared
  // epilogue before the pop sequence. Total prologue: 56 bytes. Scratch:
  // rax, rcx, rdx, rdi, rsi, r8, r9, r10 (all caller-save; per SysV,
  // none are preserved across the classify / copy calls -- we reload
  // from r13/r14/r15 as needed).
  //
  // Encoder pitfalls avoided: (a) no `test`; every zero-check is `cmp
  // reg, 0`; (b) every cmp reg, imm uses imm <= 0x7F (largest is
  // AC_HOME_PREFIX_LEN=6 and tok record size=16); (c) tok record byte
  // offset i*16 via `shl r10, 4` (power-of-two; no imul); (d) argv
  // offset i*8 via `shl r10, 3` (same); (e) byte loads use xor rax,
  // rax; mov_b rax, [ptr] per #1248; (f) r11 (paideia-as reserved
  // scratch) used only as short-lived .rodata LEA in the FINGERPRINT
  // path and not held across any call; (g) large-immediate compares
  // against TILDE_KIND_* and AC_ERR_* sentinels: TILDE_KIND_* fit
  // imm32 (0..3), TOK_ERR_FINGERPRINT_MALFORMED (0xFFFFEB06) staged
  // via `mov r10, imm64; cmp rax, r10`; (h) labels prefixed acx_.
  // ==========================================================================
  pub let dispatch_argv_construct : (u64) -> u64 !{mem} @{} =
    fn (desc_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R106.SHELL-002 (paideia-os/shell#41): argv construction from tokenizer records with novel-tilde expansion. Walks tok_count records at desc.tok_ptr; for each, calls tokenizer_tilde_classify(tok_bytes, tok_length) and emits a NUL-terminated expanded string into desc.pool_out per the classification: NONE = verbatim, HOME = $HOME + tail, FINGERPRINT = /home/ + <64-hex>+tail, ALIAS = AC_ERR_ALIAS_UNRESOLVED (R106 stub; R108.M4 flips the kernel backend without changing this code), MALFORMED bubbled as AC_ERR_FP_MALFORMED. Per-argv start offset into pool_out written to desc.off_out. Bounds gates: argc >= off_cap -> AC_ERR_ARGC_OVERFLOW; pool_used + needed > pool_cap -> AC_ERR_POOL_OVERFLOW; HOME with home_len=0 -> AC_ERR_HOME_MISSING (deliberate refusal to silently expand '~' to literal on envp gap, per design/user/content-addressed-identity.md §4 'hard errors not silent literals'). On success, desc.pool_used_out and desc.argc_out are populated and rax = 0. On any failure, rax = AC_ERR_* and the descriptor's out-fields are left in whatever partial state the loop reached (caller must not consume). Non-leaf: nested `call tokenizer_tilde_classify` (leaf; preserves r12-r15/rbx/rbp/r11) and `call _ac_copy_bytes` (leaf; same). 6 callee-save pushes (rbx=i, rbp=argc, r12=pool_used, r13=desc_ptr, r14=tok_length, r15=tok_bytes) = 48 bytes prologue; entry rsp%16==8, after 6 pushes rsp%16==0, no local scratch. tok record byte offset via shl r10, 4 (power-of-two, no imul); off_out slot offset via shl r10, 3 (same). TOK_ERR_FINGERPRINT_MALFORMED compare stages via mov r10, imm64; cmp rax, r10 (large-imm). Labels prefixed acx_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                              // rsp%16 alignment for nested calls

        // Argument sanity: desc_ptr NULL -> BAD_ARGS.
        cmp rdi, 0;
        je acx_bad_args;

        mov r13, rdi;                            // r13 = desc_ptr

        // Init accumulators.
        xor rbx, rbx;                            // i = 0
        xor rbp, rbp;                            // argc = 0
        xor r12, r12;                            // pool_used = 0

      acx_loop:
        // Load tok_count (desc + 8).
        mov rax, [r13 + 8];
        cmp rbx, rax;
        jae acx_finish;

        // argc bound gate.
        mov rax, [r13 + 56];                     // off_cap
        cmp rbp, rax;
        jae acx_argc_overflow;

        // Compute per-record byte offset: r10 = i * 16 (shl 4).
        mov r10, rbx;
        shl r10, 4;

        // Load token record.
        mov rax, [r13 + 0];                      // tok_ptr
        add rax, r10;                            // -> record base
        mov rcx, [rax + 0];                      // offset in source
        mov r14, [rax + 8];                      // r14 = tok_length

        // r15 = tok_bytes = src_ptr + offset.
        mov r15, [r13 + 16];                     // src_ptr
        add r15, rcx;

        // Record per-argv pool start offset: off_out[argc] = pool_used.
        // Slot byte offset = argc * 8 via shl r10, 3.
        mov r10, rbp;
        shl r10, 3;
        mov rax, [r13 + 48];                     // off_out_ptr
        add rax, r10;
        mov [rax], r12;                          // store pool_used

        // Classify: rdi = tok_bytes, rsi = tok_length.
        mov rdi, r15;
        mov rsi, r14;
        call tokenizer_tilde_classify;
        // rax = TILDE_KIND_* or 0xFFFFEB06.

        // Dispatch on kind. TILDE_KIND_NONE = 0.
        cmp rax, 0;
        je acx_kind_none;
        cmp rax, 1;
        je acx_kind_home;
        cmp rax, 2;
        je acx_kind_fp;
        cmp rax, 3;
        je acx_kind_alias;

        // Not a valid kind: must be TOK_ERR_FINGERPRINT_MALFORMED.
        mov r10, 0xFFFFEB06;
        cmp rax, r10;
        je acx_fp_malformed;

        // Any other rax from classify is unexpected -- treat as BAD_ARGS.
        jmp acx_bad_args;

        // ------------------------------------------------------------
        // NONE: copy tok_bytes[0..tok_length] + NUL to pool.
        // needed = tok_length + 1.
        // ------------------------------------------------------------
      acx_kind_none:
        mov rax, r14;
        add rax, 1;                              // needed
        // Bound check: pool_used + needed <= pool_cap.
        mov rcx, [r13 + 40];                     // pool_cap
        mov rdx, r12;
        add rdx, rax;
        cmp rdx, rcx;
        ja acx_pool_overflow;

        // Copy tok_length bytes.
        mov rdi, r15;                            // src = tok_bytes
        mov rsi, [r13 + 32];                     // pool_out_ptr
        add rsi, r12;                            // dst = pool + pool_used
        mov rdx, r14;                            // len = tok_length
        call _ac_copy_bytes;

        // Append NUL at pool + pool_used + tok_length.
        mov rax, [r13 + 32];
        add rax, r12;
        add rax, r14;
        xor rcx, rcx;
        mov_b [rax], rcx;

        // pool_used += tok_length + 1.
        add r12, r14;
        add r12, 1;
        jmp acx_next;

        // ------------------------------------------------------------
        // HOME: home_ptr + tok_bytes[1..len] + NUL.
        // needed = home_len + (tok_length - 1) + 1 = home_len + tok_length.
        // home_len == 0 -> AC_ERR_HOME_MISSING.
        // ------------------------------------------------------------
      acx_kind_home:
        mov rcx, [r13 + 72];                     // home_len
        cmp rcx, 0;
        je acx_home_missing;

        mov rax, rcx;                            // needed = home_len
        add rax, r14;                            //        + tok_length
        // ( tok_length is >= 1 because leading '~' matched; the '-1'
        //   for stripping '~' and '+1' for NUL cancel exactly. )

        mov rcx, [r13 + 40];                     // pool_cap
        mov rdx, r12;
        add rdx, rax;
        cmp rdx, rcx;
        ja acx_pool_overflow;

        // Copy home_ptr[0..home_len] into pool + pool_used.
        mov rdi, [r13 + 64];                     // home_ptr
        mov rsi, [r13 + 32];                     // pool_out_ptr
        add rsi, r12;
        mov rdx, [r13 + 72];                     // home_len
        call _ac_copy_bytes;

        // Advance pool cursor by home_len (bookkeeping in a scratch --
        // r12 still holds pre-copy pool_used and we need it below).
        mov rcx, [r13 + 72];                     // home_len (re-read)
        mov r8, r12;
        add r8, rcx;                             // r8 = new cursor after home

        // Copy tok_bytes[1..tok_length] (tail after '~') into pool + r8.
        // Length of tail = tok_length - 1.
        mov rdx, r14;
        sub rdx, 1;                              // tail_len
        cmp rdx, 0;
        je acx_home_nul;

        mov rdi, r15;
        add rdi, 1;                              // src = tok_bytes + 1
        mov rsi, [r13 + 32];
        add rsi, r8;                             // dst = pool + r8
        call _ac_copy_bytes;

      acx_home_nul:
        // NUL byte at pool + r8 + (tok_length - 1).
        mov rax, [r13 + 32];
        add rax, r8;
        mov rcx, r14;
        sub rcx, 1;
        add rax, rcx;
        xor rcx, rcx;
        mov_b [rax], rcx;

        // pool_used += home_len + tok_length (already computed rax
        // above -- but rax has been reused; recompute for clarity).
        mov rcx, [r13 + 72];
        add r12, rcx;                            // += home_len
        add r12, r14;                            // += tok_length (covers tail+NUL)
        // note: home_len + tok_length == home_len + (tok_length-1) + 1
        //       = home_bytes + tail_bytes + NUL byte -- exactly needed.
        jmp acx_next;

        // ------------------------------------------------------------
        // FINGERPRINT: "/home/" (6 bytes) + tok_bytes[1..len] + NUL.
        // needed = 6 + (tok_length - 1) + 1 = tok_length + 6.
        // ------------------------------------------------------------
      acx_kind_fp:
        mov rax, r14;
        add rax, 6;                              // needed

        mov rcx, [r13 + 40];                     // pool_cap
        mov rdx, r12;
        add rdx, rax;
        cmp rdx, rcx;
        ja acx_pool_overflow;

        // Copy "/home/" (6 bytes) into pool + pool_used.
        lea rdi, [rip + ac_home_prefix];         // rodata prefix
        mov rsi, [r13 + 32];
        add rsi, r12;
        mov rdx, 6;                              // AC_HOME_PREFIX_LEN
        call _ac_copy_bytes;

        // Advance to r8 = pool_used + 6.
        mov r8, r12;
        add r8, 6;

        // Copy tok_bytes[1..tok_length] into pool + r8.
        mov rdx, r14;
        sub rdx, 1;
        cmp rdx, 0;
        je acx_fp_nul;

        mov rdi, r15;
        add rdi, 1;
        mov rsi, [r13 + 32];
        add rsi, r8;
        call _ac_copy_bytes;

      acx_fp_nul:
        // NUL at pool + r8 + (tok_length - 1) = pool + pool_used + 6 + tok_length - 1.
        mov rax, [r13 + 32];
        add rax, r8;
        mov rcx, r14;
        sub rcx, 1;
        add rax, rcx;
        xor rcx, rcx;
        mov_b [rax], rcx;

        // pool_used += 6 + tok_length (= 6 + (tok_length-1) + 1).
        add r12, 6;
        add r12, r14;
        jmp acx_next;

        // ------------------------------------------------------------
        // ALIAS: unconditional AC_ERR_ALIAS_UNRESOLVED at R106.
        // ------------------------------------------------------------
      acx_kind_alias:
        mov rax, 0xFFFFEBA4;                     // AC_ERR_ALIAS_UNRESOLVED
        jmp acx_epilogue;

        // ------------------------------------------------------------
        // MALFORMED: bubble as AC_ERR_FP_MALFORMED.
        // ------------------------------------------------------------
      acx_fp_malformed:
        mov rax, 0xFFFFEBA5;                     // AC_ERR_FP_MALFORMED
        jmp acx_epilogue;

      acx_next:
        add rbp, 1;                              // argc++
        add rbx, 1;                              // i++
        jmp acx_loop;

      acx_finish:
        // pool_used_out = r12; argc_out = rbp.
        mov [r13 + 88], r12;
        mov [r13 + 96], rbp;
        xor rax, rax;                            // AC_OK
        jmp acx_epilogue;

      acx_bad_args:
        mov rax, 0xFFFFEBA0;                     // AC_ERR_BAD_ARGS
        jmp acx_epilogue;

      acx_pool_overflow:
        mov rax, 0xFFFFEBA1;                     // AC_ERR_POOL_OVERFLOW
        jmp acx_epilogue;

      acx_argc_overflow:
        mov rax, 0xFFFFEBA2;                     // AC_ERR_ARGC_OVERFLOW
        jmp acx_epilogue;

      acx_home_missing:
        mov rax, 0xFFFFEBA3;                     // AC_ERR_HOME_MISSING
        jmp acx_epilogue;

      acx_epilogue:
        add rsp, 8;                              // undo alignment pad
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
