      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-001 (#28): SC+ ID 85 wrapper. SysV rdi/rsi pass through (arity 2). Kernel body at paideia-os src/kernel/core/syscall/handlers/sys_chdir.pdx (landed R86.M1-002 paideia-os #1959). Effect and capability set match syscall_shim.pdx sys_chdir: {mem, sysreg} + @{fs}; the mem effect covers the kernel's walker read of the path buffer. Sole shell consumer at v2.0: builtin `cd` (ENH-004) -- the monorepo's `cd_builtin` already calls sys_chdir directly at src/user/dispatch.pdx:27, so the shell's builtin body will be a straight port. `path_len_hint = 255` is the standard walker CAP. Leaf function.",
      block: {
        mov rax, 85;
        syscall;
        ret
      }
    }

  // ==========================================================================
  // sys_getcwd(buf, cap) -> u64
  //
  // Returns total bytes written INCLUDING the trailing NUL on success
  // (POSIX getcwd(3) convention: N-1 is the string's strlen). The buffer
  // is always NUL-terminated on the success arm. Negative errno on
  // failure (-ERANGE if the composed path + NUL does not fit in `cap`,
  // -EFAULT / -ENOENT per kernel body). `cap` is the caller's declared
  // output buffer size; the kernel refuses to write past it (-ERANGE)
  // rather than silently truncating.
  //
  // Doc fixed under shell#43 (2026-09): the prior "strlen (excl. NUL)"
  // wording was a wrapper-side docstring bug -- kernel ground truth at
  // paideia-os `src/kernel/core/syscall/sys_getcwd.pdx:44-46,242,251,
  // 280-281` has always returned the inclusive count.
  //
  // SysV rdi/rsi -> SYSCALL rdi/rsi (no shuffle; arity 2).
  // Kernel body: paideia-os `src/kernel/core/syscall/handlers/sys_getcwd.pdx`.
  // ==========================================================================
  pub let sys_getcwd : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (buf: u64) (cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-001 (#28): SC+ ID 86 wrapper. SysV rdi/rsi pass through (arity 2). Kernel body at paideia-os src/kernel/core/syscall/handlers/sys_getcwd.pdx (landed R86.M1-003 paideia-os #1960). Effect and capability set match syscall_shim.pdx sys_getcwd: {mem, sysreg} + @{fs}; the mem effect covers the kernel writing at most `cap` bytes into the caller's buf ending in NUL. Two shell consumers at v2.0: builtin `pwd` (ENH-004) and the prompt render's cwd component (ENH-006 -- the shell prompt at v2.0 renders `<cwd> $ ` per README, so the run loop calls sys_getcwd once per prompt). Leaf function.",
      block: {
        mov rax, 86;
        syscall;
        ret
      }
    }
}
