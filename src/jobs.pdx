// src/jobs.pdx -- R73.M1-006 (paideia-os/shell#26)
//
// Jobs module: job-control observability handle + jobs-table skeleton.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// This lands the observability half of R73 job-control (bg/fg/jobs/
// tab-completion). It ships:
//
//   * `_jb_jobs_table` -- .bss skeleton, 16 rows * 24 bytes each. Row
//     layout: {jid: u64, pid: u64, state: u32, exit_status: u32}. The
//     row size 24 (== 3 qwords) is 8-multiple so `[u64; 48]` (48 * 8 =
//     384 bytes) covers the whole table with u64-aligned access. Empty
//     today (no reader / writer); the row-add wire lands with #22
//     (sys_setpgid, pgrp mint) and the row-complete wire with #23
//     (bg/fg + wait4 tracking).
//
//   * `shell_fp_job_ok(n, pid, state)` -- fingerprint witness that emits
//     the line `shell job ok -- n=<N> pid=<P> state=<S>\n` to fd 2
//     (stderr). Called by the future row-add site in #22/#23 after a
//     state transition (bg foreground->background via ^Z, wait4 return,
//     fg background->foreground, etc.). The witness ONLY emits the
//     fingerprint -- counter bump (SH_ST_JOBS, slot 14) is the caller's
//     responsibility so a caller that emits the fingerprint but does
//     NOT install a new row (e.g. a state-only transition on an
//     existing jid) bumps a different counter than a caller that DOES
//     install a new row.
//
// The `shell complete ok -- prefix=<X> matches=<M>` fingerprint witness
// for R73.M1-005 (#25, tab-completion) lands in src/completion.pdx
// alongside `Completion::completion_encode_record` that it observes.
// The two witnesses live in separate modules so each one sits next to
// the state the fingerprint describes, matching the tree's inline-
// emission convention (issue #26 body: "this repo emits fingerprints
// inline via shell_note at the call site of the feature they
// describe, not from a standalone fingerprint module").
//
// =============================================================================
// FINGERPRINT WIRE FORMAT
// =============================================================================
//
// One emission is the ASCII text:
//
//   shell job ok -- n=<N> pid=<P> state=<S>\n
//
// where <N>, <P>, <S> are decimal-rendered u64 values (leading zeros
// omitted; 0 renders as one '0' byte). Written to fd 2 as ONE
// sys_write of at most 91 bytes (18-byte prefix + 20-byte n + 5-byte
// " pid=" + 20-byte pid + 7-byte " state=" + 20-byte state + 1-byte
// '\n'). One-write atomicity keeps the fingerprint intact even when a
// concurrent writer to stderr (a child stage in the same pipeline, once
// #44 sys_fork lands) is emitting bytes simultaneously.
//
// =============================================================================
// JOBS TABLE LAYOUT (skeleton -- no reader/writer today)
// =============================================================================
//
// 16 rows * 24 bytes = 384 bytes (48 qwords), @align(64) so the table
// starts on a cache-line boundary. Row byte offset i => i * 24. Field
// offsets within a row:
//
//   +0    u64 jid           1..JB_TABLE_MAX; 0 means "row unused"
//   +8    u64 pid           child pid (>= 1 when row is active)
//   +16   u32 state         JB_STATE_* (bg, stopped, waited, ...)
//   +20   u32 exit_status   wait4 low byte on JB_STATE_WAITED; 0 else
//
// The 24-byte row fits 2 fully-populated u64 fields + 1 fused u64
// (state | exit_status << 32), which is the shape #22/#23 will write:
// one qword store for the jid, one for the pid, one for the fused
// state/exit_status pair. All three stores are naturally aligned; no
// intra-row torn writes on x86-64.
//
// JB_STATE_* values are placeholders here; the state vocabulary is
// pinned when #22 lands the actual signal-handling paths (SIGTSTP,
// SIGCONT, SIGCHLD) that drive the transitions.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Jobs`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF (byte-count literals
//     18, 5, 7 fit trivially).
//   - Large immediates: none in this module. sys_write's fd=2 is a
//     small integer, string byte-counts are also small.
//   - r11 reserved as .bss LEA scratch for the rodata prefix / sep
//     blobs (per the shell.pdx pattern of `lea r11, [rip + sym]` for
//     every RIP-relative reach).
//   - Byte reads via `xor rax, rax; mov_b rax, [ptr]`; byte writes via
//     `mov_b [ptr], rax`, both with explicit `* 1` index scale per
//     the #1248 / U1606 mitigation.
//   - `shell_fp_job_ok`: 4 callee-save pushes (rbx cursor, r12 n cache,
//     r13 pid cache, r14 state cache) + `sub rsp, 104` = 136 bytes
//     prologue. Entry rsp%16==8; 4 pushes -> rsp%16==8; sub rsp, 104
//     -> rsp%16==0 (since (8 - 32 - 104) mod 16 == 0). Nested calls to
//     `history_format_u64_dec`, `sys_write` all see rsp%16==0.
//   - Fingerprint-string sizing: `[u8; N]` = strlen + 1 per the
//     paideia-as fingerprint-string rule (feedback_pdx_encoder_pitfalls).
//   - Labels prefixed `jb_` (jb_jw_prefix_head, jb_jw_pid_head, etc.).

module Jobs = structure {

  // ==========================================================================
  // Table capacity + row layout constants
  // ==========================================================================

  // Maximum jobs tracked in _jb_jobs_table. 16 rows chosen so the table
  // fits in 6 cache lines (16 * 24 = 384 bytes). A live shell rarely
  // has > 4 backgrounded jobs at once; 16 is generous. Fits imm <=
  // 0x7FFFFFFF trivially.
  pub let JB_TABLE_MAX : u64 = 16

  // One row size in bytes. 24 = 3 qwords (jid, pid, fused state |
  // exit_status). Row byte offset for i is i * 24; #22/#23 compute this
  // via shl+add+shl (i*3<<3) to avoid the 2-op `imul r,imm` pitfall
  // from feedback_pdx_encoder_pitfalls.
  pub let JB_ROW_SIZE  : u64 = 24

  // Row field byte offsets within one 24-byte row.
  pub let JB_ROW_OFF_JID         : u64 = 0
  pub let JB_ROW_OFF_PID         : u64 = 8
  pub let JB_ROW_OFF_STATE       : u64 = 16
  pub let JB_ROW_OFF_EXIT_STATUS : u64 = 20

  // ==========================================================================
  // Return-code band 0xFFFFECFx (Jobs module: row access helpers)
  //
  // Distinct from the JB_STATE_* constants above (which live in the
  // low 32 bits of the fused state qword). The 0xFFFFECFx band is for
  // helper returns that the caller may want to distinguish from a
  // successful (0) or state-valued (small positive) return.
  //
  //   JB_OK               = 0             success sentinel
  //   JB_ERR_TABLE_FULL   = 0xFFFFECFA    jb_add_job: no free row
  //   JB_ERR_BAD_PID      = 0xFFFFECFB    jb_add_job: pid == 0
  //   JB_ERR_NO_ROW       = 0xFFFFECFC    jb_close_job: no row matched pid
  //   JB_ERR_NO_JOB       = 0xFFFFECFD    bi_bg / bi_fg: jid not active
  // ==========================================================================
  pub let JB_OK              : u64 = 0
  pub let JB_ERR_TABLE_FULL  : u64 = 0xFFFFECFA
  pub let JB_ERR_BAD_PID     : u64 = 0xFFFFECFB
  pub let JB_ERR_NO_ROW      : u64 = 0xFFFFECFC
  pub let JB_ERR_NO_JOB      : u64 = 0xFFFFECFD

  // State vocabulary (placeholders; pinned when #22 lands signal path).
  //
  //   JB_STATE_FREE     row is unused (jid==0 also implies free)
  //   JB_STATE_BG       job running in the background
  //   JB_STATE_STOPPED  job stopped (^Z / SIGTSTP)
  //   JB_STATE_WAITED   wait4 has returned; exit_status is meaningful
  pub let JB_STATE_FREE    : u64 = 0
  pub let JB_STATE_BG      : u64 = 1
  pub let JB_STATE_STOPPED : u64 = 2
  pub let JB_STATE_WAITED  : u64 = 3

  // ==========================================================================
  // .bss jobs table skeleton
  //
  // 16 rows * 24 bytes = 384 bytes total. Declared as [u64; 48] so field
  // access is naturally u64-aligned; the low 24 bytes of each row hold
  // the four documented fields (jid, pid, state|reserved, exit_status
  // fused into the third qword's high 32 bits). @align(64) puts the
  // table on a cache-line boundary so an SMP variant of the row-scan
  // path (unlikely in a single-threaded shell, but cheap) does not
  // straddle a line for row 0.
  //
  // Empty today -- no reader / writer. #22 (sys_setpgid + pgrp mint)
  // and #23 (bg/fg + wait4 tracking) install the writers; the readers
  // are `bg`/`fg`/`jobs` builtins landing in the same wave.
  // ==========================================================================
  pub let mut _jb_jobs_table : [u64; 48] = uninit @align(64)

  // ==========================================================================
  // R73.M1-002 (shell#22): per-job process-group tracking.
  //
  // Parallel array (same idiom as Dispatch::_bi_names / _bi_name_lens /
  // _bi_handlers) rather than widening _jb_jobs_table's 24-byte row --
  // widening the row would ripple the i*24 offset math into every
  // existing consumer (builtins.pdx bi_jb_list / bi_bg / bi_fg, this
  // module's own jb_add_job / jb_close_job / jb_pid_of_jid), all of
  // which are already landed and tested. _jb_jobs_pgid[slot] mirrors
  // _jb_jobs_table's slot indexing 1:1 (slot = jid - 1); a slot's pgid
  // is meaningful exactly when the corresponding _jb_jobs_table row is
  // active (jid != 0).
  //
  // At this landing every job is a single process (no pipeline support
  // yet -- that lands with #2451's pipe/fork-per-stage work), so a
  // job's pgid equals its own leader pid: jb_add_job populates
  // _jb_jobs_pgid[slot] = pid at add-time. jb_set_pgid exists as a
  // separate mutator so a future multi-process-per-job landing (a
  // pipeline where only the FIRST forked child becomes the pgid leader
  // and subsequent stages join it) can override the auto-populated
  // value without changing jb_add_job's signature.
  // ==========================================================================
  pub let mut _jb_jobs_pgid : [u64; 16] = uninit @align(64)

  // The pgid currently holding TTY foreground ownership, or 0 meaning
  // "the shell itself" (no job has been given the foreground via
  // kind_tty_set_fg_pgid). Read by a future bi_fg landing to decide
  // whether an fg target is already foreground; written by the ^Z
  // stop path (jb_stop_job) and by fg/bg builtins (#23) when they hand
  // foreground ownership back and forth.
  pub let mut _jb_foreground_pgid : u64 = uninit @align(8)

  // ==========================================================================
  // Fingerprint rodata blobs
  //
  // Each `[u8; N]` = strlen + 1 per the paideia-as fingerprint-string
  // rule (feedback_pdx_encoder_pitfalls). The trailing NUL is NEVER
  // emitted to sys_write; the sys_write byte count spells the visible
  // strlen and stops before the NUL.
  //
  //   jb_fp_job_ok_prefix        "shell job ok -- n=" (18 bytes)
  //   jb_fp_job_ok_sep_pid       " pid="              (5 bytes)
  //   jb_fp_job_ok_sep_state     " state="            (7 bytes)
  //
  // The overall wire assembles as:
  //   [prefix 18] [n decimal 1..20] [sep_pid 5] [pid decimal 1..20]
  //   [sep_state 7] [state decimal 1..20] [newline 1]
  // Worst case 18 + 20 + 5 + 20 + 7 + 20 + 1 = 91 bytes; the 104-byte
  // stack scratch has 13 bytes of headroom (rounded up to keep the
  // SysV rsp%16==0 invariant across nested calls; see prologue math
  // above).
  // ==========================================================================
  pub let jb_fp_job_ok_prefix    : [u8; 19] = "shell job ok -- n=\0"
  pub let jb_fp_job_ok_sep_pid   : [u8; 6]  = " pid=\0"
  pub let jb_fp_job_ok_sep_state : [u8; 8]  = " state=\0"

  // Wire lengths (excluding the trailing NUL each rodata blob carries
  // for `[u8; strlen+1]` sizing). Named so the sys_write byte count is
  // symbolic and stays in sync with the string above at edit time.
  pub let jb_fp_job_ok_prefix_len    : u64 = 18
  pub let jb_fp_job_ok_sep_pid_len   : u64 = 5
  pub let jb_fp_job_ok_sep_state_len : u64 = 7

  // ==========================================================================
  // shell_fp_job_ok(n, pid, state) -> ()
  //
  // Signature: shell_fp_job_ok : (u64, u64, u64) -> () !{mem, sysreg} @{fs}
  // RDI (input): n      -- job identifier (jid); typically 1..JB_TABLE_MAX
  // RSI (input): pid    -- child pid (>= 1); rendered decimal
  // RDX (input): state  -- JB_STATE_* value; rendered decimal
  //
  // Emits ONE sys_write of the composed line
  //   `shell job ok -- n=<N> pid=<P> state=<S>\n`
  // to fd 2 (stderr). Single-write atomicity so a concurrent stderr
  // writer (future post-fork child, or the R66.M1-003 history witness)
  // cannot interleave bytes with this fingerprint's characters.
  //
  // The witness is a STUB TODAY -- no in-tree caller (job-add wire lands
  // with #22, job-complete wire with #23). The tag byte counts are
  // locked at this landing so future callers just call the helper; the
  // wire format is the public contract a boot-time smoke driver (paideia-
  // os side) can grep for once the caller lands.
  //
  // Register plan:
  //   rbx = scratch cursor into the stack composition buffer (also the
  //         final sys_write count; both roles collapse into one register)
  //   r12 = n cache      (callee-save across format_u64_dec + sys_write)
  //   r13 = pid cache    (same)
  //   r14 = state cache  (same)
  //   rax, rcx, rdi, rsi, rdx = short-scratch (call args / byte load)
  //   r10, r11 = LEA scratch for the three rodata blobs
  //   [rsp + 0 .. rsp + 103] = 104-byte composition scratch
  //
  // Prologue: 4 callee-save pushes + `sub rsp, 104` = 136 bytes. Entry
  // rsp%16==8; 4 pushes -> rsp%16==(8-32) mod 16 == 8; `sub rsp, 104`
  // -> rsp%16 == (8-32-104) mod 16 == 0. Nested calls to
  // history_format_u64_dec + sys_write all see rsp%16==0.
  //
  // No counter bump inside this body. The two counter slots this issue
  // reserves (SH_ST_JOBS = 14, SH_ST_JOBS_COMPLETED = 15 in shell.pdx)
  // are bumped by the CALLER of this witness, so a state-only transition
  // (state change on an already-existing row) and a fresh row-add can
  // bump different counters while sharing this single emit helper.
  //
  // Labels prefixed `jb_jw_`.
  // ==========================================================================
  pub let shell_fp_job_ok : (u64, u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (n: u64) (pid: u64) (state: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.R73.M1-006 (#26): job-control fingerprint witness. Emits the line `shell job ok -- n=<N> pid=<P> state=<S>\\n` to fd 2 in ONE sys_write so a concurrent stderr writer (post-#44 forked child in the same pipeline, or R66.M1-003's own history witness) cannot interleave bytes with this line. Composed in a 104-byte stack scratch: 18-byte prefix + up to 20-byte n decimal + 5-byte ` pid=` + up to 20-byte pid decimal + 7-byte ` state=` + up to 20-byte state decimal + 1-byte '\\n' = 91 bytes worst-case; the 104-byte allocation is rounded up to satisfy the SysV rsp%16==0 invariant across three nested calls (history_format_u64_dec x 3, sys_write x 1). Decimal render via History::history_format_u64_dec (cross-module call resolved by the linker at symbol name; the shell tree already calls it cross-module from Shell::history_ring_witness at src/shell.pdx line ~1147). All byte loads from the rodata prefix / sep blobs use `xor rax, rax; mov_b rax, [r11 + rcx * 1]` per the #1248 / U1606 mitigation; the store into the scratch uses `mov_b [rsp + rbx * 1], rax` at the same discipline. Byte-count literals 18, 5, 7 fit imm <= 0x7FFFFFFF trivially. No counter bump inside this body -- the caller (future #22/#23 job-add or job-complete site) is expected to bump SH_ST_JOBS (slot 14) or SH_ST_JOBS_COMPLETED (slot 15) as a separate call, so a state-transition-only fingerprint (no new row) and a row-add fingerprint can bump different counters while sharing this emit helper. Prologue: 4 callee-save pushes (rbx cursor, r12 n, r13 pid, r14 state) + sub rsp, 104 = 136 bytes; entry rsp%16==8, after 4 pushes rsp%16 stays at 8 (since 32 bytes cancels mod 16), after sub rsp, 104 rsp%16 = (8 - 104) mod 16 = 0, so every nested SysV call sees rsp%16==0. r11 as LEA scratch for the rodata blobs (paideia-as convention). Labels prefixed jb_jw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 104;

        mov r12, rdi;                        // n cache
        mov r13, rsi;                        // pid cache
        mov r14, rdx;                        // state cache
        xor rbx, rbx;                        // cursor = 0

        // ------------------------------------------------------------
        // (1) Copy jb_fp_job_ok_prefix[0..18] into scratch[0..18).
        // ------------------------------------------------------------
      jb_jw_prefix_head:
        cmp rbx, 18;
        jae jb_jw_prefix_done;
        lea r11, [rip + jb_fp_job_ok_prefix];
        xor rax, rax;
        mov_b rax, [r11 + rbx * 1];
        mov_b [rsp + rbx * 1], rax;
        add rbx, 1;
        jmp jb_jw_prefix_head;
      jb_jw_prefix_done:

        // ------------------------------------------------------------
        // (2) Render n decimal at scratch[cursor], advance cursor.
        // ------------------------------------------------------------
        mov rdi, r12;                        // value = n
        mov rsi, rsp;
        add rsi, rbx;                        // out_buf = &scratch[cursor]
        call history_format_u64_dec;
        add rbx, rax;                        // cursor += digit count

        // ------------------------------------------------------------
        // (3) Copy jb_fp_job_ok_sep_pid " pid=" (5 bytes) into scratch.
        // ------------------------------------------------------------
        xor rcx, rcx;                        // inner index 0..5
      jb_jw_pid_head:
        cmp rcx, 5;
        jae jb_jw_pid_done;
        lea r11, [rip + jb_fp_job_ok_sep_pid];
        xor rax, rax;
        mov_b rax, [r11 + rcx * 1];
        mov_b [rsp + rbx * 1], rax;
        add rbx, 1;
        add rcx, 1;
        jmp jb_jw_pid_head;
      jb_jw_pid_done:

        // ------------------------------------------------------------
        // (4) Render pid decimal at scratch[cursor], advance cursor.
        // ------------------------------------------------------------
        mov rdi, r13;                        // value = pid
        mov rsi, rsp;
        add rsi, rbx;
        call history_format_u64_dec;
        add rbx, rax;

        // ------------------------------------------------------------
        // (5) Copy jb_fp_job_ok_sep_state " state=" (7 bytes).
        // ------------------------------------------------------------
        xor rcx, rcx;
      jb_jw_state_head:
        cmp rcx, 7;
        jae jb_jw_state_done;
        lea r11, [rip + jb_fp_job_ok_sep_state];
        xor rax, rax;
        mov_b rax, [r11 + rcx * 1];
        mov_b [rsp + rbx * 1], rax;
        add rbx, 1;
        add rcx, 1;
        jmp jb_jw_state_head;
      jb_jw_state_done:

        // ------------------------------------------------------------
        // (6) Render state decimal at scratch[cursor], advance cursor.
        // ------------------------------------------------------------
        mov rdi, r14;                        // value = state
        mov rsi, rsp;
        add rsi, rbx;
        call history_format_u64_dec;
        add rbx, rax;

        // ------------------------------------------------------------
        // (7) Append '\n' (0x0A) at scratch[cursor].
        // ------------------------------------------------------------
        mov rax, 0x0A;
        mov_b [rsp + rbx * 1], rax;
        add rbx, 1;

        // ------------------------------------------------------------
        // (8) sys_write(fd=2, scratch, cursor).
        // ------------------------------------------------------------
        mov rdi, 2;
        mov rsi, rsp;
        mov rdx, rbx;
        call sys_write;

        add rsp, 104;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // JB_TABLE ROW ACCESS HELPERS (shell#22 / #23 / #24 partial)
  //
  // The row-add / row-complete / row-walk primitives are the writers +
  // reader that the bg/fg/jobs builtins and exec_spawn_and_wait's
  // parent-branch hook consume. Row byte offset for slot i is i*24
  // (JB_ROW_SIZE); computed via `mov rax, i; shl rax, 3; lea rax,
  // [rax + rax * 2]` = i*24 without a 2-op `imul r,imm` pitfall
  // (feedback_pdx_encoder_pitfalls).
  //
  // Rows are u64-aligned via _jb_jobs_table's [u64; 48] declaration;
  // JB_ROW_OFF_JID/PID land on u64 slots (offsets 0/8), while the
  // fused state|exit_status pair at offset 16 also lands on a u64 slot
  // (state in low 32, exit_status in high 32).
  //
  // Job identifiers (jid) run 1..JB_TABLE_MAX. jid==0 means "unused"
  // per the header. Add allocates the lowest free slot; close finds
  // the row by pid; walk visits rows in slot order and emits one text
  // line per active row via a caller-supplied sys_write to fd 1.
  //
  // Alignment: every helper uses 4-push+sub prologues that keep
  // rsp % 16 == 0 for the nested SysV / shell_note calls, per the
  // paideia-as conformance ledger already established by
  // shell_fp_job_ok above.
  // ==========================================================================

  // ==========================================================================
  // jb_add_job(pid) -> u64
  //
  // Signature: jb_add_job : (u64) -> u64 !{mem, sysreg} @{fs}
  // RDI (input): pid  -- child pid (>= 1)
  // RAX (output): allocated jid in 1..JB_TABLE_MAX on success, else
  //               JB_ERR_TABLE_FULL (0xFFFFECFA) if every slot is
  //               occupied, or JB_ERR_BAD_PID (0xFFFFECFB) if pid==0.
  //
  // Walks _jb_jobs_table[0..JB_TABLE_MAX) looking for the first row
  // whose jid==0 (JB_STATE_FREE). Populates row with (jid=slot+1,
  // pid, state=JB_STATE_BG, exit_status=0). Bumps SH_ST_JOBS (slot 14).
  //
  // Emits the fingerprint via shell_fp_job_ok after the row-write
  // completes; caller-side counter bump is SH_ST_JOBS (slot 14) so a
  // state-only transition using shell_fp_job_ok directly can bump
  // SH_ST_JOBS_COMPLETED (slot 15) instead.
  //
  // Register plan (2 pushes + sub rsp,8 = 24 bytes; entry rsp%16==8
  // + 24 = 32; 32 mod 16 == 0 for every nested SysV call):
  //   rbx = pid cache (callee-save across shell_note + shell_fp_job_ok)
  //   r12 = slot index / allocated jid (callee-save across shell_note)
  //   r11 = .bss LEA scratch
  //   rax, rcx, r10 = short-scratch
  //
  // Labels prefixed jb_aj_.
  // ==========================================================================
  pub let jb_add_job : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (pid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell#22 / #23 (partial): allocate the lowest free row in _jb_jobs_table and populate it with (jid, pid, state=JB_STATE_BG, exit_status=0). Return jid in 1..JB_TABLE_MAX or JB_ERR_TABLE_FULL / JB_ERR_BAD_PID. Row byte offset i*24 via shl 3 + lea [rax+rax*2] (no 2-op imul r,imm per feedback_pdx_encoder_pitfalls). Row layout: [+0]=jid u64, [+8]=pid u64, [+16]=state u64 (low 32 = state; high 32 = exit_status left zero at add-time). Bumps SH_ST_JOBS (slot 14) unconditionally on entry. Emits shell_fp_job_ok(jid, pid, JB_STATE_BG) on the success arm; the reject arms (bad pid, table full) bump SH_ST_ERRORS instead and skip the fingerprint. Prologue: 2 callee-save pushes (rbx pid, r12 slot) + sub rsp,8 = 24 bytes; entry rsp%16==8 + 24 = 32; 32 mod 16 == 0 at every nested SysV call (shell_note, shell_fp_job_ok). Labels prefixed jb_aj_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                        // pid cache

        mov rdi, 14;                         // SH_ST_JOBS
        call shell_note;

        cmp rbx, 0;
        je  jb_aj_bad_pid;

        xor r12, r12;                        // slot index = 0
      jb_aj_scan:
        cmp r12, 16;                         // JB_TABLE_MAX
        jae jb_aj_table_full;
        // rax = row_base = &_jb_jobs_table + r12 * 24
        mov rax, r12;
        shl rax, 3;                          // rax = r12 * 8
        lea rax, [rax + rax * 2];            // rax = r12 * 24
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;                        // rax = row_base
        mov rcx, [rax];                      // rcx = jid (0 == free)
        cmp rcx, 0;
        je  jb_aj_found;
        add r12, 1;
        jmp jb_aj_scan;

      jb_aj_found:
        // rax = row_base (still). Write jid, pid, state.
        mov rcx, r12;
        add rcx, 1;                          // jid = slot + 1
        mov [rax], rcx;                      // row[+0] = jid
        mov [rax + 8], rbx;                  // row[+8] = pid
        mov rcx, 1;                          // JB_STATE_BG (exit_status = 0)
        mov [rax + 16], rcx;                 // row[+16] = state fused

        // shell#22: pgid defaults to the job's own leader pid (single-
        // process-per-job model; #2451 pipelines override via
        // jb_set_pgid). Slot index still in r12.
        mov rax, r12;
        shl rax, 3;                          // slot * 8 (pgid array is u64-indexed)
        lea r11, [rip + _jb_jobs_pgid];
        add rax, r11;
        mov [rax], rbx;                      // _jb_jobs_pgid[slot] = pid

        // Emit fingerprint. Order: (jid, pid, state).
        mov rdi, r12;
        add rdi, 1;                          // jid
        mov rsi, rbx;                        // pid
        mov rdx, 1;                          // JB_STATE_BG
        call shell_fp_job_ok;

        mov rax, r12;
        add rax, 1;                          // return jid
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      jb_aj_bad_pid:
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFECFB;                 // JB_ERR_BAD_PID
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      jb_aj_table_full:
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFECFA;                 // JB_ERR_TABLE_FULL
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // jb_close_job(pid, exit_status) -> u64
  //
  // Signature: jb_close_job : (u64, u64) -> u64 !{mem, sysreg} @{fs}
  // RDI (input): pid          -- child pid returned by sys_wait4
  // RSI (input): exit_status  -- low 8 bits of wait4's wstatus
  // RAX (output): JB_OK (0) on hit, JB_ERR_NO_ROW (0xFFFFECFC) if
  //               no row matches the pid (silent-close is fine; caller
  //               ignores the return).
  //
  // Walks _jb_jobs_table looking for the first row whose pid matches.
  // On hit, sets state=JB_STATE_WAITED, stores exit_status in the
  // high 32 bits of the fused qword2 slot, bumps SH_ST_JOBS_COMPLETED
  // (slot 15), and emits shell_fp_job_ok(jid, pid, JB_STATE_WAITED).
  //
  // Row IS freed (jid=0) so a later jb_add_job re-uses the slot.
  //
  // Labels prefixed jb_cj_.
  // ==========================================================================
  pub let jb_close_job : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (pid: u64) (exit_status: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell#22 / #23 (partial): find the row matching pid in _jb_jobs_table, mark it WAITED (state=3), store exit_status in the high 32 bits of the fused state slot, bump SH_ST_JOBS_COMPLETED (slot 15), emit shell_fp_job_ok(jid, pid, JB_STATE_WAITED) as the row-complete witness, and free the slot (jid=0) so jb_add_job can reuse it. No-op (JB_ERR_NO_ROW, distinct from success 0) if no row's pid matches; caller (exec_spawn_and_wait's parent branch) ignores the return since a wait4 return on a pid we never registered as a job is a synchronous foreground-only exec (the current v0.1 shell path -- every exec today goes through the same fork+wait4 whether the job table is populated or not, so a no-row close is expected on the foreground path until jb_add_job is wired in at exec_spawn_and_wait too). Row byte offset i*24 via shl 3 + lea [rax+rax*2]. Fused state store: `mov rcx, exit_status; shl rcx, 32; or rcx, JB_STATE_WAITED (3)`; the OR imm is 3 which fits imm32 trivially. Prologue: 3 callee-save pushes (rbx pid, r12 slot, r13 exit_status) = 24 bytes; entry rsp%16==8 + 24 = rsp%16==0. Labels prefixed jb_cj_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // pid
        mov r13, rsi;                        // exit_status

        xor r12, r12;                        // slot = 0
      jb_cj_scan:
        cmp r12, 16;                         // JB_TABLE_MAX
        jae jb_cj_no_row;
        mov rax, r12;
        shl rax, 3;                          // rax = r12 * 8
        lea rax, [rax + rax * 2];            // rax = r12 * 24
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;                        // rax = row_base
        mov rcx, [rax];                      // jid
        cmp rcx, 0;
        je  jb_cj_next;                      // free row, skip
        mov rcx, [rax + 8];                  // row pid
        cmp rcx, rbx;
        je  jb_cj_found;
      jb_cj_next:
        add r12, 1;
        jmp jb_cj_scan;

      jb_cj_found:
        // Store fused state | (exit_status << 32) at [rax + 16].
        mov rcx, r13;
        shl rcx, 32;
        or  rcx, 3;                          // JB_STATE_WAITED
        mov [rax + 16], rcx;

        // Bump SH_ST_JOBS_COMPLETED.
        mov rdi, 15;                         // SH_ST_JOBS_COMPLETED
        call shell_note;

        // Fingerprint: (jid, pid, JB_STATE_WAITED).
        mov rdi, r12;
        add rdi, 1;                          // jid = slot + 1
        mov rsi, rbx;                        // pid
        mov rdx, 3;                          // JB_STATE_WAITED
        call shell_fp_job_ok;

        // Free the row (jid=0). Recompute row_base from r12 since the
        // shell_note + shell_fp_job_ok calls above are cross-module and
        // do not preserve rax; r12 is callee-save and still holds slot.
        mov rax, r12;
        shl rax, 3;
        lea rax, [rax + rax * 2];
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;
        xor rcx, rcx;
        mov [rax], rcx;                      // jid = 0

        xor rax, rax;                        // JB_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      jb_cj_no_row:
        mov rax, 0xFFFFECFC;                 // JB_ERR_NO_ROW
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // jb_pid_of_jid(jid) -> u64
  //
  // Signature: jb_pid_of_jid : (u64) -> u64 !{mem} @{}
  // RDI (input): jid  -- job identifier (1..JB_TABLE_MAX)
  // RAX (output): pid on success, or 0 if the jid is not active
  //               (jid==0 requested, jid out of range, or the slot
  //               at index jid-1 has jid==0 meaning free).
  //
  // Direct O(1) lookup: row = _jb_jobs_table + (jid-1)*24. Confirms
  // the row's jid field equals the requested jid (row could be free
  // or reassigned) before returning pid.
  //
  // Consumers: bi_bg / bi_fg (map builtin argv[1] jid -> pid before
  // sys_kill / sys_wait4).
  //
  // Leaf function; no push/pop parity. Labels prefixed jb_pj_.
  // ==========================================================================
  pub let jb_pid_of_jid : (u64) -> u64 !{mem} @{} =
    fn (jid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell#23: O(1) jid->pid resolver. Row byte offset (jid-1)*24 via shl 3 + lea [rax+rax*2]. Returns 0 for jid==0 (unused sentinel), jid > JB_TABLE_MAX (out of range), or a free row (jid field == 0). Leaf function; r11 as .bss LEA scratch. Encoder-conservative: cmp/mov/lea/shl/xor/ret only. Labels prefixed jb_pj_.",
      block: {
        cmp rdi, 0;
        je  jb_pj_none;
        cmp rdi, 16;                         // JB_TABLE_MAX
        ja  jb_pj_none;
        // slot = jid - 1
        mov rax, rdi;
        sub rax, 1;
        shl rax, 3;                          // slot * 8
        lea rax, [rax + rax * 2];            // slot * 24
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;                        // row_base
        mov rcx, [rax];                      // stored jid
        cmp rcx, rdi;
        jne jb_pj_none;
        mov rax, [rax + 8];                  // pid
        ret;
      jb_pj_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // jb_pgid_of_jid(jid) -> u64   (shell#22)
  //
  // Signature: jb_pgid_of_jid : (u64) -> u64 !{mem} @{}
  // RDI (input): jid  -- job identifier (1..JB_TABLE_MAX)
  // RAX (output): pgid on success, or 0 if the jid is not active (same
  //               validity rule as jb_pid_of_jid: jid==0, out of range,
  //               or a free row all return 0).
  //
  // O(1) lookup into the parallel _jb_jobs_pgid array, gated by the
  // SAME jid-active check jb_pid_of_jid performs against
  // _jb_jobs_table (a free row's pgid slot is stale, not
  // authoritative, until jb_add_job repopulates it).
  //
  // Leaf function; no push/pop parity. Labels prefixed jb_pg_.
  // ==========================================================================
  pub let jb_pgid_of_jid : (u64) -> u64 !{mem} @{} =
    fn (jid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell#22: O(1) jid->pgid resolver over the parallel _jb_jobs_pgid array. Validity gate mirrors jb_pid_of_jid exactly (jid==0, jid > JB_TABLE_MAX, or _jb_jobs_table row's jid field == 0 all return 0) so a caller cannot read a stale pgid left behind by a freed row. Slot byte offset (jid-1)*8 via a single shl 3 (pgid array is u64-indexed, no *24 row-size multiply needed). Leaf function; r11 as .bss LEA scratch. Labels prefixed jb_pg_.",
      block: {
        cmp rdi, 0;
        je  jb_pg_none;
        cmp rdi, 16;                         // JB_TABLE_MAX
        ja  jb_pg_none;

        // Confirm the row is active (jid field matches) before trusting
        // the pgid slot.
        mov rax, rdi;
        sub rax, 1;
        shl rax, 3;                          // slot * 8
        lea rax, [rax + rax * 2];            // slot * 24 -> _jb_jobs_table row_base offset
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;
        mov rcx, [rax];                      // stored jid
        cmp rcx, rdi;
        jne jb_pg_none;

        // Active: read _jb_jobs_pgid[jid - 1].
        mov rax, rdi;
        sub rax, 1;
        shl rax, 3;                          // slot * 8 (pgid array is u64-indexed)
        lea r11, [rip + _jb_jobs_pgid];
        add rax, r11;
        mov rax, [rax];
        ret;
      jb_pg_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // jb_set_pgid(jid, pgid) -> ()   (shell#22)
  //
  // Signature: jb_set_pgid : (u64, u64) -> () !{mem} @{}
  // RDI (input): jid   -- job identifier (1..JB_TABLE_MAX)
  // RSI (input): pgid  -- new process-group id for the job
  //
  // Unconditional overwrite of _jb_jobs_pgid[jid - 1]; no validity
  // gate against _jb_jobs_table (a caller that races a set against a
  // row free is a caller bug, same as jb_add_job's own no-gate row
  // write pattern). jid outside 1..JB_TABLE_MAX is a silent no-op
  // (defensive: never writes outside the 16-slot array).
  //
  // Sole consumer today: a future #2451 pipeline landing, where the
  // first forked stage becomes the pgid leader and later stages call
  // this to join it. Reserved now so #22's job-table shape does not
  // need a second migration when pipelines land.
  //
  // Leaf function; no push/pop parity. Labels prefixed jb_sp_.
  // ==========================================================================
  pub let jb_set_pgid : (u64, u64) -> () !{mem} @{} =
    fn (jid: u64) (pgid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell#22: mutator for the parallel _jb_jobs_pgid array, reserved for #2451's pipeline landing (first-stage-is-leader join). jid outside 1..JB_TABLE_MAX is a silent no-op (defensive bound check, avoids an out-of-array write); no _jb_jobs_table activity gate since a caller races a set against a row free at its own risk (same discipline jb_add_job's row write already accepts). Leaf function; r11 as .bss LEA scratch. Labels prefixed jb_sp_.",
      block: {
        cmp rdi, 0;
        je  jb_sp_done;
        cmp rdi, 16;                         // JB_TABLE_MAX
        ja  jb_sp_done;

        mov rax, rdi;
        sub rax, 1;
        shl rax, 3;                          // slot * 8
        lea r11, [rip + _jb_jobs_pgid];
        add rax, r11;
        mov [rax], rsi;                      // _jb_jobs_pgid[slot] = pgid
      jb_sp_done:
        ret
      }
    }

  // ==========================================================================
  // jb_stop_job(pid) -> u64   (shell#22)
  //
  // Signature: jb_stop_job : (u64) -> u64 !{mem, sysreg} @{fs} =
  // RDI (input): pid  -- foreground child pid the ^Z path is stopping
  // RAX (output): JB_OK (0) on hit, JB_ERR_NO_ROW (0xFFFFECFC) if no
  //               row matches pid.
  //
  // Peer of jb_close_job for the ^Z (SIGTSTP-shaped) transition: marks
  // the row JB_STATE_STOPPED WITHOUT freeing it (unlike jb_close_job's
  // WAITED transition, a stopped job stays live in the table so a
  // later `bg`/`fg` (#23) can resume it). exit_status is left
  // untouched (a stopped job has not exited; the high-32 bits of the
  // fused state qword keep whatever was there, which is 0 for a job
  // that has never completed). Emits shell_fp_job_ok(jid, pid,
  // JB_STATE_STOPPED) and bumps SH_ST_JOBS_COMPLETED is deliberately
  // NOT bumped here (the job has not completed) -- callers that want a
  // stop-specific counter can add one when the ^Z call site lands
  // above the current documented gap (kernel-side SIGTSTP delivery /
  // async wait4 interruption; see design/architecture.md §4.5).
  //
  // Row byte offset i*24 via shl 3 + lea [rax+rax*2], same shape as
  // jb_close_job. Labels prefixed jb_sj_.
  // ==========================================================================
  pub let jb_stop_job : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (pid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell#22: ^Z (SIGTSTP-shaped) row transition. Peer of jb_close_job but sets state=JB_STATE_STOPPED (2) instead of WAITED (3) and does NOT free the row (jid stays nonzero) since a stopped job remains resumable via #23's bg/fg builtins. Walks _jb_jobs_table for the row matching pid (same scan shape as jb_close_job); JB_ERR_NO_ROW on no match. On hit, ORs the fused state slot's low 32 bits to 2 while preserving the high-32 exit_status bits (which are meaningless for a never-exited job but preserved for symmetry): `mov rcx, [row+16]; mov r10, 0xFFFFFFFF00000000; and rcx, r10; or rcx, 2; mov [row+16], rcx`. Emits shell_fp_job_ok(jid, pid, JB_STATE_STOPPED) as the transition witness. Does not bump SH_ST_JOBS_COMPLETED (job has not completed); a future stop-specific counter is a documented follow-up, not added here to avoid inventing a counter slot ahead of design/architecture.md §5's ledger. Prologue: 3 callee-save pushes (rbx pid, r12 slot, r13 row_base) = 24 bytes; entry rsp%16==8 + 24 = rsp%16==0 at nested SysV calls (shell_fp_job_ok). Labels prefixed jb_sj_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // pid

        xor r12, r12;                        // slot = 0
      jb_sj_scan:
        cmp r12, 16;                          // JB_TABLE_MAX
        jae jb_sj_no_row;
        mov rax, r12;
        shl rax, 3;
        lea rax, [rax + rax * 2];
        lea r11, [rip + _jb_jobs_table];
        add rax, r11;
        mov r13, rax;                         // r13 = row_base
        mov rcx, [rax];                       // jid
        cmp rcx, 0;
        je  jb_sj_next;
        mov rcx, [rax + 8];                   // row pid
        cmp rcx, rbx;
        je  jb_sj_found;
      jb_sj_next:
        add r12, 1;
        jmp jb_sj_scan;

      jb_sj_found:
        // Preserve high-32 exit_status bits; set low-32 state to 2.
        mov rcx, [r13 + 16];
        mov r10, 0xFFFFFFFF00000000;
        and rcx, r10;
        or  rcx, 2;                           // JB_STATE_STOPPED
        mov [r13 + 16], rcx;

        // Fingerprint: (jid, pid, JB_STATE_STOPPED).
        mov rdi, r12;
        add rdi, 1;                           // jid
        mov rsi, rbx;                         // pid
        mov rdx, 2;                           // JB_STATE_STOPPED
        call shell_fp_job_ok;

        xor rax, rax;                         // JB_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      jb_sj_no_row:
        mov rax, 0xFFFFECFC;                  // JB_ERR_NO_ROW
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
