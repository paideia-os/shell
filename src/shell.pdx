// src/shell.pdx -- shell.M1-001 (paideia-os/shell#1)
//
// Shell module: top-level scaffold + constants + stats.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The M1 substrate for the shell binary. Owns:
//
//   * KIND ordinal mirrors (SH_KIND_*) so shell modules do not need to
//     link paideia-os's kernel .o graph to name the KINDs the shell
//     handles. Same mirror discipline libpdx-cap uses for RIGHTS_* --
//     the M4 smoke matrix catches any drift between the mirrored
//     values here and the authoritative kernel values.
//
//   * The shell's error band (SH_* 0xFFFFECxx). Disjoint from the
//     libpdx-cap band (0xFFFFFFxx) and the kernel errno band
//     (-EFAULT = 0xFFFFFFFFFFFFFFF2 ...). The high two bytes of the
//     return tell a downstream consumer which layer refused. (The
//     libpdx-elevate band 0xFFFFEAxx was previously named here as a
//     disjointness anchor; ENH-009 (#36) dropped that dependency,
//     but the shell band's placement inside the 0xFFFFECxx window
//     stays chosen so re-adding elevate later does not collide.)
//
//   * An eight-slot _shell_stats counter table with bounded increment
//     + bounded read (shell_note, shell_stat). Same shape as
//     ElevateBroker._elevate_broker_stats (paideia-os
//     src/kernel/core/ipc/elevate_broker.pdx:70) and libpdx-elevate's
//     _elevate_client_stats. Cache-line aligned so a future SMP
//     variant of the counter path does not straddle a line.
//
//   * shell_reset() -- clears the counter table. Startup + teardown
//     only.
//
// =============================================================================
// WHAT M1 IS DELIBERATELY NOT
// =============================================================================
//
// M1 does NOT ship the _start entry frame -- the loader convention that
// binds argv/envp/InitCap to a userspace binary lands with the R14b
// paideia-os bootstrap; the shell repo's _start lands at M2 alongside
// the pipeline mint (M2-002). M1 ships the three modules the run loop
// calls, so a later _start is a wiring job, not a design job.
//
// M1 does NOT allocate. Every buffer is caller-owned. Every counter
// lives in .bss. This mirrors libpdx-cap M1 discipline -- the shell's
// M1 has no reason to differ.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Shell`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF (SH_ST_MAX = 8 fits
//     easily; the KIND ordinals and error codes are `mov rax, imm32`
//     emissions, not compares).
//   - r11 is scratch (paideia-as conformance) and appears in every
//     `lea r11, [rip + sym]` .bss reach.
//   - No byte reads in this module; the `xor rax, rax; mov_b rax, [ptr]`
//     pattern lands at M2 when line_reader consumes KIND_TTY bytes.
//   - shell_reset and shell_note / shell_stat are leaf functions --
//     no push/pop parity to preserve.

module Shell = structure {

  // ==========================================================================
  // KIND ordinal mirrors
  //
  // Mirror the authoritative values in paideia-os:
  //   SH_KIND_IPC_ENDPOINT      src/kernel/core/cap/kind.pdx:72
  //   SH_KIND_USER              src/kernel/core/cap/kind_user.pdx:122
  //   SH_KIND_PDXFS_FILE        src/kernel/core/cap/kind_pdxfs_file.pdx:82
  //   SH_KIND_SHELL_SESSION     allocated at shell.M2-001 (derived over USER)
  //   SH_KIND_TTY               placeholder ordinal 0x196 -- reserved for
  //                             the KIND_TTY landing in a paideia-os round
  //                             adjacent to R49 (kind_tty.pdx has not
  //                             landed at HEAD 2026-08-21). The shell
  //                             repo's caps.decl names it symbolically,
  //                             and this constant is the numeric hook
  //                             the M2 InitCap sidecar builder will
  //                             stamp into the wire record. Softarch
  //                             pins the real ordinal at the KIND_TTY
  //                             substrate PR; a mismatch is caught at
  //                             M4 by the smoke matrix.
  //
  // KIND_ELEVATE_CHANNEL (0x191, paideia-os
  // src/kernel/core/cap/kind_elevate_channel.pdx:80) was previously
  // mirrored here as `SH_KIND_ELEVATE_CHANNEL`. ENH-009 (#36) dropped
  // the mirror -- caps.decl does not request the KIND and no in-tree
  // caller reads it. A future privileged `.pds` path re-adds the
  // ordinal in the same PR that lands the caps.decl request and the
  // libpdx-elevate consumer inside `Pds`.
  // ==========================================================================
  pub let SH_KIND_IPC_ENDPOINT    : u64 = 5
  pub let SH_KIND_USER            : u64 = 0x190
  pub let SH_KIND_SHELL_SESSION   : u64 = 0x194
  pub let SH_KIND_PDXFS_FILE      : u64 = 0x195
  pub let SH_KIND_TTY             : u64 = 0x196    // provisional, pin at substrate PR

  // ==========================================================================
  // Return-code band 0xFFFFECxx (shell layer)
  //
  // High two bytes = 0xFFFFEC identify the shell layer to a
  // downstream consumer. Full table in design/architecture.md §5.
  // ==========================================================================

  // Generic success -- unused at M1; reserved so consumers can spell
  // `SH_OK` at their call sites now and get real semantics at M2.
  pub let SH_OK                  : u64 = 0xFFFFEC00

  // LineReader errors (0xFFFFEC1x)
  //
  // LR_STUB (formerly 0xFFFFEC10) was RETIRED at ENH-007 (#34) when the
  // M1 stub tail of line_reader_read_line was replaced by the real
  // sys_read(0, ptr, 1) loop. The value 0xFFFFEC10 is intentionally
  // left unallocated -- any external decoder that carried the sentinel
  // in its table now sees the code path as unreachable, which is the
  // correct outcome: the shell never returns LR_STUB again. Do NOT
  // reuse the value for a different meaning without a paired external
  // decoder-refresh sweep.
  pub let LR_ERR_BAD_BUF         : u64 = 0xFFFFEC11   // buf == 0 or buf_len == 0
  pub let LR_ERR_TTY_UNBOUND     : u64 = 0xFFFFEC12   // reserved: cap-typed KIND_TTY(read) seat not yet provisioned (paideia-os#1986 landed the op but KIND_TTY absent from KIND_SEEDABLE_TABLE + no shell-side TTY row seed at boot; see design/architecture.md §3.3, refreshed at #46)
  pub let LR_ERR_EOF             : u64 = 0xFFFFEC13   // sys_read returned 0 with no bytes read
  pub let LR_ERR_READ_FAIL       : u64 = 0xFFFFEC14   // ENH-007: sys_read returned negative errno

  // Exec stubs and errors (0xFFFFEC2x)
  //
  // EX_STUB retired at ENH-005 (#32) -- exec_spawn_and_wait now calls
  // sys_execve for real. The constant is retained here (unchanged
  // value) so any external tool that carried the sentinel in a
  // decoder table keeps decoding correctly; new code paths in the
  // shell no longer return it.
  //
  // EX_ERR_EXECVE_FAIL retired at shell#44: exec_spawn_and_wait now
  // forks before exec, so the CHILD sys_exit(127) on execve failure
  // and the parent's wait4 surfaces the exit code naturally instead
  // of a shell-layer sentinel. The constant is retained (unchanged
  // value) for the old-decoder compat window; the shell no longer
  // returns it from the parent-visible return path.
  pub let EX_STUB                  : u64 = 0xFFFFEC20   // (retired at ENH-005)
  pub let EX_ERR_BAD_ARGV          : u64 = 0xFFFFEC21   // argv == 0, argv_bytes == 0, or argc == 0
  pub let EX_ERR_EXECVE_FAIL       : u64 = 0xFFFFEC22   // (retired at shell#44; child sys_exits 127 now)
  pub let EX_ERR_WAIT_FAIL         : u64 = 0xFFFFEC23   // sys_wait4 returned negative errno
  pub let EX_ERR_MISSING_CAP       : u64 = 0xFFFFEC24   // narrow_child_caps: child needs KIND parent lacks
  pub let EX_ERR_WIDENING          : u64 = 0xFFFFEC25   // narrow_child_caps: child asks for rights parent lacks
  pub let EX_ERR_SIDECAR_FULL      : u64 = 0xFFFFEC26   // narrow_child_caps: dst < child_decl_count
  pub let EX_ERR_ARGV_OVERFLOW     : u64 = 0xFFFFEC27   // ENH-005: build_argv_ptrs argc >= EX_ARGV_PTRS_MAX
  pub let EX_ERR_AUDIT_BEGIN_FAIL  : u64 = 0xFFFFEC28   // ENH-005: command_record_begin returned non-zero (D3 gate)
  pub let EX_ERR_FORK_FAIL         : u64 = 0xFFFFEC29   // shell#44: sys_fork returned negative errno (kernel OOM)

  // Lexer errors (0xFFFFECCx) -- ENH-002 (#29). Authoritative
  // definitions in src/lexer.pdx; mirrored here for the same reason
  // the KIND ordinals are mirrored (shell.pdx is the single point
  // where a downstream consumer can spell every 0xFFFFECxx sentinel
  // without linking every module). Kept in the SH_LX_* namespace so
  // a Shell-level caller can spell them without an explicit Lexer
  // module import.
  pub let SH_LX_OK                      : u64 = 0            // == LX_OK
  pub let SH_LX_ERR_OVERFLOW            : u64 = 0xFFFFECC0
  pub let SH_LX_ERR_UNTERMINATED_QUOTE  : u64 = 0xFFFFECC1
  pub let SH_LX_ERR_INVALID_ESCAPE      : u64 = 0xFFFFECC2
  pub let SH_LX_ERR_BAD_ARGS            : u64 = 0xFFFFECC3

  // Parser errors (0xFFFFECDx) -- ENH-003 (#30). Authoritative
  // definitions in src/parser.pdx; mirrored here for the same reason
  // the Lexer sentinels are mirrored (shell.pdx is the single point
  // where a downstream consumer can spell every 0xFFFFECxx sentinel
  // without linking every module). Kept in the SH_PR_* namespace so
  // a Shell-level caller can spell them without an explicit Parser
  // module import.
  pub let SH_PR_OK                       : u64 = 0            // == PR_OK
  pub let SH_PR_ERR_TOO_MANY_STAGES      : u64 = 0xFFFFECD0
  pub let SH_PR_ERR_LEADING_PIPE         : u64 = 0xFFFFECD1
  pub let SH_PR_ERR_TRAILING_PIPE        : u64 = 0xFFFFECD2
  pub let SH_PR_ERR_EMPTY_STAGE          : u64 = 0xFFFFECD3
  pub let SH_PR_ERR_ARGV_POOL_OVERFLOW   : u64 = 0xFFFFECD4

  // Builtins + Dispatch return codes (0xFFFFECEx) -- ENH-004 (#31).
  // Authoritative definitions in src/dispatch.pdx (BI_MISS/BI_HIT_OK)
  // and src/builtins.pdx (BI_OK, BI_ERR_*); mirrored here in the
  // SH_BI_* namespace so a Shell-level caller can spell every builtin
  // sentinel without explicit Dispatch / Builtins imports. Same
  // pattern the SH_LX_* / SH_PR_* mirrors above use.
  //
  // Note: SH_BI_MISS is NOT an error -- it is the dispatcher's signal
  // to the REPL (ENH-006) that the external command path should be
  // tried next. Sits at the TOP of the 0xFFFFECEx band with the actual
  // handler errors below so a return-code reader can distinguish
  // "dispatch never found the name" from "dispatch found the name but
  // the handler refused" at a glance.
  pub let SH_BI_OK                       : u64 = 0            // == BI_OK / BI_HIT_OK
  pub let SH_BI_MISS                     : u64 = 0xFFFFECE0
  pub let SH_BI_ERR_CD_NO_ARG            : u64 = 0xFFFFECE1
  pub let SH_BI_ERR_CD_FAIL              : u64 = 0xFFFFECE2
  pub let SH_BI_ERR_EXIT_BAD_CODE        : u64 = 0xFFFFECE3
  pub let SH_BI_ERR_EXPORT_MALFORMED     : u64 = 0xFFFFECE4
  pub let SH_BI_ERR_EXPORT_TABLE_FULL    : u64 = 0xFFFFECE5
  pub let SH_BI_ERR_EXPORT_POOL_FULL     : u64 = 0xFFFFECE6
  pub let SH_BI_ERR_PWD_TOO_LONG         : u64 = 0xFFFFECE7

  // ==========================================================================
  // Session-level stats -- sixteen u64 slots, cache-line aligned.
  //
  // Slot map:
  //   0  SH_ST_PROMPTS       line_reader_read_line entries        (M1)
  //   1  SH_ST_LINES         line_reader_read_line successes       (M2+)
  //   2  SH_ST_SPAWNS        exec_spawn_and_wait entries           (M1)
  //   3  SH_ST_EXITS         exec_spawn_and_wait successes         (M2+)
  //   4  SH_ST_ERRORS        any error / reject path (shared)      (M1)
  //   5  SH_ST_SESSIONS      session_mint / _derive_subcap entries (M2-001)
  //   6  SH_ST_PIPELINES     pipeline_plan entries                 (M2-002)
  //   7  SH_ST_HISTORY       history_encode_record entries         (M2-005)
  //   8  SH_ST_PASSTHRU      pipe_passthrough_forward entries      (M3-001)
  //   9  SH_ST_COMPLETIONS   completion_encode_record entries      (M3-002)
  //   10 SH_ST_AUDITS        command_record_begin + _close entries (M3-003)
  //   11 SH_ST_STAGES        shell_repl_step per-stage attempts     (#45)
  //   12..15                 reserved for M4/M5 (audit fingerprints,
  //                          smoke matrix, dual-signed release counters)
  //
  // The table grew from 8 to 16 at M3 to accommodate the three new
  // event classes M3 introduces without another re-layout. 16 fits
  // trivially in imm <= 0x7FFFFFFF; cache-line alignment holds
  // (16 * 8 = 128 bytes = 2 cache lines). Reserved slots read as 0
  // (uninit @align(64) zero-inits at loader time; shell_reset also
  // zeroes them). A caller passing SH_ST_MAX or above is a no-op --
  // same discipline as the M1 shell_note.
  //
  // Cache-line alignment matches _elevate_broker_stats / _elevate_
  // client_stats -- keeps a future SMP counter path a mechanical
  // widening rather than a re-layout.
  // ==========================================================================
  pub let mut _shell_stats : [u64; 16] = uninit @align(64)

  pub let SH_ST_PROMPTS     : u64 = 0
  pub let SH_ST_LINES       : u64 = 1
  pub let SH_ST_SPAWNS      : u64 = 2
  pub let SH_ST_EXITS       : u64 = 3
  pub let SH_ST_ERRORS      : u64 = 4
  pub let SH_ST_SESSIONS    : u64 = 5   // M2-001
  pub let SH_ST_PIPELINES   : u64 = 6   // M2-002
  pub let SH_ST_HISTORY     : u64 = 7   // M2-005
  pub let SH_ST_PASSTHRU    : u64 = 8   // M3-001
  pub let SH_ST_COMPLETIONS : u64 = 9   // M3-002
  pub let SH_ST_AUDITS      : u64 = 10  // M3-003
  pub let SH_ST_STAGES      : u64 = 11  // #45: per-stage attempts in shell_repl_step
  pub let SH_ST_MAX         : u64 = 16

  // ==========================================================================
  // shell_reset() -> ()
  //
  // Clear the eight-word _shell_stats counter table. Called by _start
  // (M2+) before the run loop, and by tests before each fixture. A
  // live counter reset would race any concurrent shell_note, so this
  // is startup + teardown only -- same discipline as
  // elevate_broker_stats_reset and elevate_client_stats_reset.
  //
  // Register plan (leaf):
  //   r10 = base pointer (loaded once via lea)
  //   rcx = loop index (0..8)
  //   rax = zero constant
  // ==========================================================================
  pub let shell_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.M1-001 (#1) / shell.M3 (#9-#11): clear the sixteen-word session stats table. Startup + teardown only; a live counter reset would race any concurrent shell_note (same discipline as elevate_broker_stats_reset paideia-os src/kernel/core/ipc/elevate_broker.pdx:70, and elevate_client_stats_reset libpdx-elevate/src/elevate_client.pdx). Loop: r10 base, rcx index 0..16, rax = 0. `cmp rcx, 16` uses imm <= 0x7FFFFFFF (paideia-as conformance). Loop bound widened from 8 to 16 at M3 to cover SH_ST_PASSTHRU / _COMPLETIONS / _AUDITS + 5 reserved slots without another re-layout. Leaf function -- no push/pop parity. Labels prefixed sh_rs_.",
      block: {
        lea r10, [rip + _shell_stats];
        xor rax, rax;
        xor rcx, rcx;
      sh_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  sh_rs_loop;
        ret
      }
    }

  // ==========================================================================
  // shell_note(which) -> ()
  //
  // Bounded increment of _shell_stats[which]. `which >= SH_ST_MAX` is
  // a no-op (not an error) so a caller passing a slot from a newer
  // library snapshot against an older binary snapshot cannot corrupt
  // live counters. Same shape as elevate_client_note (libpdx-elevate
  // src/elevate_client.pdx).
  //
  // Register plan (leaf):
  //   rdi = which (input; preserved through jae)
  //   r10 = base pointer
  //   rax = counter load / +1 accumulator
  // ==========================================================================
  pub let shell_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.M1-001 (#1) / shell.M3 (#9-#11): bounded increment; out-of-range which is a no-op (not an error sentinel -- a slot that never got incremented reads as 0, which is also the correct 'never touched' value). Same shape as elevate_client_note libpdx-elevate/src/elevate_client.pdx. Bound widened from 8 to 16 at M3 to admit slots 8..10 (PASSTHRU, COMPLETIONS, AUDITS) plus 5 reserved. `cmp rdi, 16` uses imm <= 0x7FFFFFFF. Leaf function -- no push/pop parity. Labels prefixed sh_nt_.",
      block: {
        cmp rdi, 16;
        jae sh_nt_out;
        lea r10, [rip + _shell_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sh_nt_out:
        ret
      }
    }

  // ==========================================================================
  // shell_stat(which) -> u64
  //
  // Bounded read of _shell_stats[which]. `which >= SH_ST_MAX` returns
  // 0 (not an error sentinel -- see shell_note rationale). Same shape
  // as elevate_client_stat.
  //
  // Register plan (leaf):
  //   rdi = which
  //   r10 = base pointer
  //   rax = return value
  // ==========================================================================
  pub let shell_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.M1-001 (#1) / shell.M3 (#9-#11): bounded read; out-of-range which returns 0 (0 is both the 'never touched' value and the 'out of range' value -- an explicit sentinel would force the caller to two loads for a distinction they never need). Same shape as elevate_client_stat libpdx-elevate/src/elevate_client.pdx. Bound widened from 8 to 16 at M3 in lockstep with shell_note. `cmp rdi, 16` uses imm <= 0x7FFFFFFF. Leaf function. Labels prefixed sh_st_.",
      block: {
        cmp rdi, 16;
        jae sh_st_zero;
        lea r10, [rip + _shell_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sh_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ENH-006 (#33): Shell::shell_main + REPL landing.
  //
  // What this section adds:
  //   * SM_ / SR_ return-code sub-bands (0xFFFFECFx).
  //   * .bss singletons for the parsed CLI options, the minted session
  //     cap, the per-child derived sub-cap, the interactive line buf,
  //     and the in-memory history ring (persistence deferred to #35).
  //   * Byte-string helpers (sm_strlen, sm_streq_lit, sm_str_prefix)
  //     used by the argv walker.
  //   * shell_argv_dispatch -- walk argv[1..argc], parse -c / --no-
  //     history / --no-cap:<KIND> / positional <script.pds>.
  //   * shell_repl_step(line_ptr, line_len) -- lex -> parse -> per-stage
  //     (dispatch -> exec) walk for one line. At ENH-006 (#33) this
  //     handled _pr_stages[0] only and silently dropped [1..]; #45
  //     widened the body to loop over all stages. True parallel per-
  //     stage execution + pipe-fd wiring stays deferred until shell#44
  //     lands sys_fork; see the shell_repl_step §FORK-GAP + PIPE-WIRING
  //     DEFERRALS block for what is / is not covered by #45 alone.
  //   * shell_main (@no_frame) -- ELF entry frame. Reads argc/argv from
  //     the initial SysV process stack, mints the session cap, then
  //     enters the interactive REPL (or -c one-shot).
  //
  // As of ENH-007 (#34) the line-reader body reads real bytes from
  // fd 0 via a `sys_read(0, ptr, 1)` byte-at-a-time loop behind a
  // single seam (`lr_read_one_byte`); the LR_STUB tail is retired.
  // shell_main treats a bare 0, LR_ERR_EOF, LR_ERR_READ_FAIL, and
  // LR_ERR_BAD_BUF (defensive) as EOF signals so the REPL terminates
  // cleanly on any non-line return.
  // ==========================================================================
  pub let SM_OK                     : u64 = 0
  pub let SM_ERR_ARG_FLAG_UNKNOWN   : u64 = 0xFFFFECF0
  pub let SM_ERR_LINE_TOO_LONG      : u64 = 0xFFFFECF1
  pub let SM_ERR_SESSION_MINT_FAIL  : u64 = 0xFFFFECF2
  pub let SM_ERR_DISPATCH_INIT_FAIL : u64 = 0xFFFFECF3
  pub let SR_OK                     : u64 = 0
  pub let SR_EOF                    : u64 = 0xFFFFECF8

  // Session-id placeholder handed to session_mint at startup. Real
  // session ids arrive with the InitCap-sidecar runtime introspection
  // wiring in a later enhancement; the placeholder value 1 is non-zero
  // so session_mint does not refuse it as SS_ERR_BAD_ID. Kernel readers
  // of a downstream KIND_SHELL_SESSION cap treat the target_ptr field
  // as opaque today, so a placeholder id is honest about what the shell
  // knows at ENH-006.
  pub let SM_SESSION_ID : u64 = 1

  // Line-buffer cap for one interactive read. 4096 matches Parser's
  // PR_ARGV_POOL_SIZE ceiling -- a line longer than the pool cannot
  // survive parser_parse anyway, so bounding the read to the same
  // ceiling avoids reading bytes we'd immediately refuse.
  pub let SM_LINE_BUF_CAP  : u64 = 4096

  // In-memory history ring for ENH-006. Persistence to
  // `~/.history/<session>-<ts>.pdxhist` is ENH-008 (#35) work; here we
  // just append the wire bytes history_encode_record produces to a
  // .bss ring so the encoder is reachable from the REPL and its bytes
  // exist somewhere for a future flush. When the ring fills, subsequent
  // appends are silently dropped (a shell that lives long enough to
  // fill 8 KiB of history bytes will land ENH-008 before this becomes
  // a real limit).
  pub let SM_HIST_RING_CAP : u64 = 8192

  // ==========================================================================
  // .bss singletons for parsed CLI options + session state
  //
  //   _sm_opt_c_cmd_ptr    argv[i+1] pointer after `-c`, else 0
  //   _sm_opt_c_cmd_len    strlen of the -c command, else 0
  //   _sm_opt_no_history   1 if --no-history seen, else 0
  //   _sm_opt_no_cap_kind  1 if any --no-cap:<KIND> seen; KIND parse +
  //                        cap-narrowing hook lands with ENH-005+ wiring
  //                        (the flag is remembered but its KIND argument
  //                        is not decoded here)
  //   _sm_opt_script_ptr   positional script name, else 0
  //   _sm_session_cap      16-byte session Cap wire record (from
  //                        session_mint at startup)
  //   _sm_child_cap        16-byte per-child derived sub-cap (from
  //                        session_derive_subcap inside shell_repl_step
  //                        before each exec_spawn_and_wait)
  //   _sm_line_buf         the 4096-byte interactive-read scratch
  //   _sm_hist_buf         the 8192-byte in-memory history ring
  //   _sm_hist_used        bytes consumed in _sm_hist_buf
  // ==========================================================================
  pub let mut _sm_opt_c_cmd_ptr   : u64        = uninit @align(8)
  pub let mut _sm_opt_c_cmd_len   : u64        = uninit @align(8)
  pub let mut _sm_opt_no_history  : u64        = uninit @align(8)
  pub let mut _sm_opt_no_cap_kind : u64        = uninit @align(8)
  pub let mut _sm_opt_script_ptr  : u64        = uninit @align(8)
  pub let mut _sm_session_cap     : [u64; 2]   = uninit @align(16)
  pub let mut _sm_child_cap       : [u64; 2]   = uninit @align(16)
  pub let mut _sm_line_buf        : [u8; 4096] = uninit @align(16)
  pub let mut _sm_hist_buf        : [u8; 8192] = uninit @align(16)
  pub let mut _sm_hist_used       : u64        = uninit @align(8)

  // ENH-008 (#35): fd for the per-session ~/.history/<session>-<ts>
  // .pdxhist journal file. Populated at shell_main startup via
  // history_open_file (guarded by --no-history); consumed by
  // history_persist_flush after every REPL step (drains _sm_hist_buf
  // to disk) and closed by history_close_file on EOF. A value with
  // the sign bit set (initialised to -1 == 0xFFFFFFFFFFFFFFFF via the
  // startup path, or a returned HI_ERR_OPEN_FAIL == 0xFFFFEC63 on
  // sys_open refusal) tells the flush/close helpers to no-op. This
  // "invalid fd is silent" discipline lets an open failure (e.g. the
  // persistent-home substrate hasn't landed yet) degrade to "shell
  // still runs, history is not persisted" rather than "shell refuses
  // to start". The persistent-home substrate proof lives in
  // paideia-os boot smoke (paideia-os R106.M5 / R107.M1 pair), not
  // here.
  pub let mut _sm_hist_fd         : u64        = uninit @align(8)

  // ==========================================================================
  // rodata: prompt, newline, flag literals, error messages
  //
  // N in `[u8; N]` = strlen+1 per the paideia-as fingerprint-string
  // rule (feedback_pdx_encoder_pitfalls).
  // ==========================================================================
  pub let sm_prompt_str           : [u8; 3]  = "$ \0"
  pub let sm_nl_str               : [u8; 2]  = "\n\0"
  pub let sm_flag_c_str           : [u8; 3]  = "-c\0"
  pub let sm_flag_no_history_str  : [u8; 13] = "--no-history\0"
  pub let sm_flag_no_cap_prefix   : [u8; 10] = "--no-cap:\0"
  pub let sm_err_unknown_flag_str : [u8; 21] = "shell: unknown flag\n\0"
  pub let sm_err_session_mint_str : [u8; 28] = "shell: session_mint failed\n\0"

  // ENH-006 (#33): entry-frame fingerprint. Emitted once at shell_main
  // entry to stderr so a boot-time smoke driver can prove the ELF entry
  // symbol resolved and the entry body executed (both were the concern
  // in the #33 reopen review). Also grep-able as a rodata string in the
  // built binary before boot -- proves the entry frame compiled with the
  // right symbol name even on a system whose linker cannot yet resolve
  // `entry = Shell::shell_main` from the manifest. Body is 14 bytes
  // ("SHELL MAIN OK\n"); `[u8; 15]` = strlen + NUL per the paideia-as
  // fingerprint-string sizing rule.
  pub let sm_fp_entry_str         : [u8; 15] = "SHELL MAIN OK\n\0"

  // ==========================================================================
  // sm_strlen(ptr) -> u64
  //
  // Byte count until NUL. Leaf function.
  // rdi (input): ptr (caller-owned; caller responsibility for non-null)
  // rax (output): length in bytes, excluding NUL
  //
  // Register plan: rax = accumulator, rcx = byte scratch.
  // ==========================================================================
  pub let sm_strlen : (u64) -> u64 !{mem} @{} =
    fn (ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-006 (#33): NUL-bounded byte count for the argv walker + the line-length reload in the -c path. Byte load via `xor rcx, rcx; mov_b rcx, [rdi + rax * 1]` per #1248 (with explicit * 1 scale to dodge U1606). Leaf function; no callee-save state. Labels prefixed sm_sl_.",
      block: {
        xor rax, rax;
      sm_sl_loop:
        xor rcx, rcx;
        mov_b rcx, [rdi + rax * 1];
        cmp rcx, 0;
        je  sm_sl_done;
        add rax, 1;
        jmp sm_sl_loop;
      sm_sl_done:
        ret
      }
    }

  // ==========================================================================
  // sm_streq_lit(a, b) -> u64
  //
  // Compare two NUL-terminated byte strings. Leaf function.
  // rdi (input): a  -- caller-owned NUL-terminated bytes
  // rsi (input): b  -- caller-owned NUL-terminated bytes (typically a
  //                    rodata literal)
  // rax (output): 0 if bytes match through both NULs, else 1.
  // ==========================================================================
  pub let sm_streq_lit : (u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-006 (#33): pointer-per-side NUL-terminated byte compare. Walker rdi=a and rsi=b advance in lockstep; a mismatch or a one-side-early NUL rejects with rax=1; both-side simultaneous NUL matches with rax=0. Byte loads via `xor <reg>, <reg>; mov_b <reg>, [ptr]` per #1248. Leaf function. Labels prefixed sm_se_.",
      block: {
      sm_se_loop:
        xor rax, rax;
        mov_b rax, [rdi];
        xor rcx, rcx;
        mov_b rcx, [rsi];
        cmp rax, rcx;
        jne sm_se_ne;
        cmp rax, 0;
        je  sm_se_eq;
        add rdi, 1;
        add rsi, 1;
        jmp sm_se_loop;
      sm_se_eq:
        xor rax, rax;
        ret;
      sm_se_ne:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // sm_str_prefix(a, prefix) -> u64
  //
  // Test whether `a`'s bytes begin with `prefix`. Both inputs are
  // NUL-terminated; only prefix's NUL delimits the compare (a may have
  // more bytes after the matched region). Leaf function.
  // rdi (input): a       -- caller-owned NUL-terminated
  // rsi (input): prefix  -- caller-owned NUL-terminated
  // rax (output): 0 if a[0..strlen(prefix)] == prefix, else 1.
  // ==========================================================================
  pub let sm_str_prefix : (u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (prefix: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-006 (#33): NUL-terminated prefix test. Walker rsi=prefix drives; loop exits with rax=0 when rsi hits its NUL (all preceding bytes matched), else compares rdi's byte at the same offset. Byte loads via `xor <reg>, <reg>; mov_b <reg>, [ptr]` per #1248. Leaf function. Labels prefixed sm_sp_.",
      block: {
      sm_sp_loop:
        xor rcx, rcx;
        mov_b rcx, [rsi];
        cmp rcx, 0;
        je  sm_sp_eq;
        xor rax, rax;
        mov_b rax, [rdi];
        cmp rax, rcx;
        jne sm_sp_ne;
        add rdi, 1;
        add rsi, 1;
        jmp sm_sp_loop;
      sm_sp_eq:
        xor rax, rax;
        ret;
      sm_sp_ne:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // shell_argv_dispatch(argc, argv_base) -> u64
  //
  // Walk argv[1..argc] and populate the _sm_opt_* .bss singletons.
  // Recognises:
  //
  //   -c <command>            _sm_opt_c_cmd_ptr / _sm_opt_c_cmd_len
  //   --no-history            _sm_opt_no_history = 1
  //   --no-cap:<KIND>         _sm_opt_no_cap_kind = 1 (KIND parse
  //                           deferred until the cap-narrowing hook
  //                           lands; the flag is remembered but its
  //                           KIND argument is not decoded here)
  //   <positional>            _sm_opt_script_ptr (last one wins;
  //                           multi-script invocation is out of scope
  //                           for ENH-006)
  //
  // Any other argv[i] beginning with '-' returns SM_ERR_ARG_FLAG_UNKNOWN;
  // shell_main then writes an error to stderr and sys_exit(1).
  //
  // Register plan (5 callee-save pushes + sub 8 = 48 bytes; rsp%16==0
  // at every nested SysV call):
  //   r12 = argc
  //   r13 = argv_base
  //   r14 = i (index into argv)
  //   r15 = argv[i] pointer (per iteration)
  //   rbx = scratch (peer index for -c argv[i+1], call arg staging)
  // ==========================================================================
  pub let shell_argv_dispatch : (u64, u64) -> u64 !{mem} @{} =
    fn (argc: u64) (argv_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-006 (#33): CLI flag walker. Walks argv[1..argc] and populates the _sm_opt_* .bss singletons. -c requires argv[i+1] (recorded as (ptr, strlen)); --no-history is a boolean; --no-cap:<KIND> is remembered as a boolean today (the KIND argument is not decoded until the cap-narrowing hook lands with ENH-005+ wiring). Unknown flag or -c-without-argument returns SM_ERR_ARG_FLAG_UNKNOWN. All argv[i] slots (including argv[argc], the NULL sentinel) are read via `mov r15, [r13 + r14 * 8]` (the argv qword array on the SysV initial stack has argv[argc]==NULL by contract; the loop guard against `cmp r15, 0` catches an early NULL if a hostile loader passes fewer than argc pointers). Byte peeks via `xor rax, rax; mov_b rax, [ptr]` per #1248. Prologue: 5 callee-save pushes (rbx scratch, r12 argc, r13 argv_base, r14 i, r15 argv[i]) + `sub rsp, 8` = 48 bytes; rsp%16==0 for the three nested SysV calls (sm_strlen, sm_streq_lit, sm_str_prefix) and any subsequent hookins. Resets all five _sm_opt_* singletons on entry so a repeated invocation (tests) starts from a known-empty state. Large-immediate return sentinel 0xFFFFECF0 stored via `mov rax, imm32` (fits the 32-bit MOV zero-extend). Labels prefixed sm_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                        // argc
        mov r13, rsi;                        // argv_base

        // Reset all _sm_opt_* singletons.
        xor rax, rax;
        lea r11, [rip + _sm_opt_c_cmd_ptr];
        mov [r11], rax;
        lea r11, [rip + _sm_opt_c_cmd_len];
        mov [r11], rax;
        lea r11, [rip + _sm_opt_no_history];
        mov [r11], rax;
        lea r11, [rip + _sm_opt_no_cap_kind];
        mov [r11], rax;
        lea r11, [rip + _sm_opt_script_ptr];
        mov [r11], rax;

        mov r14, 1;                          // i = 1 (skip argv[0])

      sm_ad_loop:
        cmp r14, r12;
        jae sm_ad_done;

        // Load argv[i].
        mov r15, [r13 + r14 * 8];
        cmp r15, 0;
        je  sm_ad_done;                      // NULL argv[i] terminates

        // Peek first byte.
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2D;                       // '-'
        jne sm_ad_positional;

        // Peek second byte.
        xor rax, rax;
        mov_b rax, [r15 + 1];

        cmp rax, 0x2D;                       // second byte is '-'  -> long flag
        je  sm_ad_long_flag;

        // '-<X>' single-dash form. Only -c is recognised.
        mov rdi, r15;
        lea rsi, [rip + sm_flag_c_str];
        call sm_streq_lit;
        cmp rax, 0;
        jne sm_ad_unknown;

        // -c requires argv[i+1].
        mov rbx, r14;
        add rbx, 1;
        cmp rbx, r12;
        jae sm_ad_unknown;                   // no command argument follows

        mov rax, [r13 + rbx * 8];
        cmp rax, 0;
        je  sm_ad_unknown;
        lea r11, [rip + _sm_opt_c_cmd_ptr];
        mov [r11], rax;

        // strlen(argv[i+1])
        mov rdi, rax;
        call sm_strlen;
        lea r11, [rip + _sm_opt_c_cmd_len];
        mov [r11], rax;

        add r14, 2;                          // consume "-c" + command
        jmp sm_ad_loop;

      sm_ad_long_flag:
        // Try --no-history exact match first.
        mov rdi, r15;
        lea rsi, [rip + sm_flag_no_history_str];
        call sm_streq_lit;
        cmp rax, 0;
        jne sm_ad_check_no_cap;

        mov rax, 1;
        lea r11, [rip + _sm_opt_no_history];
        mov [r11], rax;
        add r14, 1;
        jmp sm_ad_loop;

      sm_ad_check_no_cap:
        mov rdi, r15;
        lea rsi, [rip + sm_flag_no_cap_prefix];
        call sm_str_prefix;
        cmp rax, 0;
        jne sm_ad_unknown;

        mov rax, 1;
        lea r11, [rip + _sm_opt_no_cap_kind];
        mov [r11], rax;
        add r14, 1;
        jmp sm_ad_loop;

      sm_ad_positional:
        // Non-dash argv[i] -> script name; last one wins.
        lea r11, [rip + _sm_opt_script_ptr];
        mov [r11], r15;
        add r14, 1;
        jmp sm_ad_loop;

      sm_ad_unknown:
        mov rax, 0xFFFFECF0;                 // SM_ERR_ARG_FLAG_UNKNOWN
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sm_ad_done:
        xor rax, rax;                        // SM_OK
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // shell_repl_step(line_ptr, line_len) -> u64
  //
  // Feed one command line through lex -> parse -> per-stage(dispatch ->
  // exec). #45 removes the pre-fix silent-drop of _pr_stages[1..]:
  // ENH-006 (#33) landed a body that ran only stage[0] and ignored the
  // rest; the parser was already producing N stages (verified by #30's
  // tsm_case_pipeline golden), so a two-stage `ls | cat` line ran only
  // `ls` and `| cat` disappeared without an error. This body now walks
  // i in [0, _pr_stage_count) and, per stage, resolves the argv slice,
  // dispatches builtins, and calls exec_spawn_and_wait on BI_MISS.
  //
  // Return (POSIX pipeline exit-code convention):
  //   SR_OK (0)                empty line, or every stage returned 0
  //   last stage's rc          arbitrary N-stage line -- final stage
  //                             wins (dispatch_line / exec_spawn_and_
  //                             wait's return, whichever ran that
  //                             stage's body)
  //   LX_ERR_*                 lexer refused the input line
  //   PR_ERR_*                 parser refused the token stream
  //
  // ------------------------------------------------------------------
  // FORK-GAP + PIPE-WIRING DEFERRALS (documented; not blocking #45)
  // ------------------------------------------------------------------
  // Two pieces of the true pipeline semantics remain deferred:
  //   * sys_fork (SC+56) is not yet in the shell syscall floor
  //     (paideia-os/shell#44 tracks the bump). Without fork,
  //     exec_spawn_and_wait either succeeds and never returns
  //     (kernel replaces the shell image with the child's image --
  //     stages 1..N never run in that timeline, but that is the
  //     fork-gap's structural consequence, NOT a stage-walk bug)
  //     or fails with EX_ERR_EXECVE_FAIL (control returns to this
  //     body, the loop advances to the next stage, and the next
  //     exec attempt happens).
  //   * Pipe fd wiring between stages (sys_pipe + per-stage stdin/
  //     stdout dup) needs the sys_pipe SC+22 wrapper and only
  //     matters once fork lands (a wired pipe between stages 0 and
  //     1 is meaningless when stage 0 replaces the shell image).
  // Post-#44 the fingerprint `ls | cat` produces `ls`'s output
  // routed through `cat` on stdout; today the fingerprint is
  // `SH_ST_STAGES bumps by N for an N-stage line`, which the
  // stage-walk delivers.
  //
  // ------------------------------------------------------------------
  // REGISTER PLAN
  // ------------------------------------------------------------------
  //   During lex+parse (pre-loop):
  //     r12 = line_ptr (from rdi)
  //     r13 = line_len (from rsi)
  //   Post-parse, r12/r13 are repurposed for the loop:
  //     r12 = i (stage index)
  //     r13 = stage_count
  //   Loop body:
  //     rbx = last_rc (starts 0; carries the pipeline's return)
  //     r14 = per-stage argv_ptr (_pr_argv_pool + argv_offset)
  //     r15 = per-stage argv_bytes
  //     [rsp + 0] = per-stage argc (stack scratch; both dispatch_line
  //                                 and exec_spawn_and_wait read argc
  //                                 as their last arg, so we materialise
  //                                 it fresh per call from the stack)
  //     [rsp + 8] = alignment pad (reserved)
  //     r10 = arithmetic scratch (stage-record byte offset compute)
  //     r11 = .bss LEA scratch / large-imm stage
  //
  // Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) + `sub
  // rsp, 16` = 56 bytes. Entry rsp%16==8 (return addr); after 5
  // pushes rsp%16==0; `sub rsp, 16` preserves that, so rsp%16==0 at
  // every nested SysV call. Matched epilogue at every return.
  // ==========================================================================
  pub let shell_repl_step : (u64, u64) -> u64 !{mem, sysreg} @{sched, mem, fs} =
    fn (line_ptr: u64) (line_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem, fs},
      justification: "shell.ENH-006 (#33) + #45: one-line REPL step with FULL stage walk. Runs lexer_reset + lexer_tokenize on the caller's line buffer, then parser_reset + parser_parse over the same buffer (the parser consumes tokens the lexer just published in _lx_tokens). Empty-line and whitespace-only-line short-circuit to SR_OK -- an empty _pr_stage_count is not an error, it is a user pressing Enter on an empty prompt. Non-empty: iterate i in [0, _pr_stage_count), and per stage (a) bump SH_ST_STAGES (slot 11, per-attempt fingerprint), (b) resolve the stage's argv slice from Parser::_pr_argv_pool + _pr_stages[i].argv_offset (stage-rec byte offset = i * 24 computed via r10 shl/add/shl to avoid the 2-op `imul r,imm` pitfall from feedback_pdx_encoder_pitfalls), (c) call dispatch_line first (builtin match returns handler code directly); on BI_MISS derive a KIND_SHELL_SESSION SS_RIGHTS_CHILD sub-cap into _sm_child_cap via session_derive_subcap (the child cap the future InitCap sidecar handoff will carry; today the derivation runs but the wire slot is not yet consumed by sys_execve -- see Exec §DEFERRALS) then invoke exec_spawn_and_wait with the pool-slice signature (pool_ptr, argv_bytes, argc). Each stage's rc overwrites the accumulator; the pipeline's final rc == last stage's rc (POSIX pipeline exit-code convention). The pre-#45 body ran only _pr_stages[0] and silently dropped _pr_stages[1..]; the new stage-walk removes that silent drop. Pipe-fd wiring between stages and true parallel per-stage execution are STILL deferred: without sys_fork (shell#44) each exec_spawn_and_wait call either replaces the shell image (success on stage 0 -> stages 1..N never run in that timeline, structural consequence of the fork-gap not of the stage-walk) or fails with EX_ERR_EXECVE_FAIL (parent continues to the next stage). Post-#44 the fingerprint 'ls | cat' produces piped output; today the fingerprint is 'SH_ST_STAGES bumps by N for an N-stage line' which the stage-walk delivers and TestShellMain::tshm_case_repl_pipe_stages verifies. Non-zero return from lexer_tokenize or parser_parse propagates verbatim (LX_ERR_* / PR_ERR_*). Effect/cap set is the union of every downstream call: {mem, sysreg} + @{sched, mem, fs} (matches exec_spawn_and_wait's widest set). Prologue: 5 callee-save pushes (rbx last_rc, r12 line_ptr then stage index i, r13 line_len then stage_count, r14 per-stage argv_ptr, r15 per-stage argv_bytes) + `sub rsp, 16` (local scratch [rsp+0] = per-stage argc; [rsp+8] alignment pad) = 56 bytes prologue; rsp%16==0 at every nested SysV call. Repurposing r12/r13 after parse is safe because line_ptr/line_len are unused past the parser_parse call. Large-immediate compare 0xFFFFECE0 (BI_MISS) stages via `mov r11, imm64; cmp rax, r11` per paideia-as imm32 discipline. Stage-index bumps `mov rdi, 11` (SH_ST_STAGES) fit imm32. Scaled memory accesses use explicit `* 1` index scale per the #1248 / U1606 mitigation. Labels prefixed sr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        // Pre-loop: r12 = line_ptr, r13 = line_len (used by lex+parse).
        mov r12, rdi;
        mov r13, rsi;

        // Empty line -> SR_OK without touching the lexer/parser.
        cmp r13, 0;
        je  sr_ok_empty;

        // Lex.
        call lexer_reset;
        mov rdi, r12;
        mov rsi, r13;
        call lexer_tokenize;
        cmp rax, 0;
        jne sr_propagate;

        // Parse.
        call parser_reset;
        mov rdi, r12;
        mov rsi, r13;
        call parser_parse;
        cmp rax, 0;
        jne sr_propagate;

        // Stage count.
        lea r11, [rip + _pr_stage_count];
        mov rax, [r11];
        cmp rax, 0;
        je  sr_ok_empty;                     // whitespace-only line

        // Repurpose r12 = i (stage index), r13 = stage_count.
        // rbx = last_rc.
        xor r12, r12;                        // i = 0
        mov r13, rax;                        // stage_count
        xor rbx, rbx;                        // last_rc = 0

      sr_stage_loop:
        cmp r12, r13;
        jae sr_stage_done;

        // Stage record byte offset r10 = i * 24 = (i * 3) << 3.
        mov r10, r12;
        shl r10, 1;                          // r10 = i * 2
        add r10, r12;                        // r10 = i * 3
        shl r10, 3;                          // r10 = i * 24

        // Load argv_offset, argv_bytes, argc from _pr_stages[i].
        lea r11, [rip + _pr_stages];
        mov r14, [r11 + r10 * 1 + 0];        // argv_offset
        mov r15, [r11 + r10 * 1 + 8];        // argv_bytes
        mov rax, [r11 + r10 * 1 + 16];       // argc
        mov [rsp + 0], rax;                  // stash argc for the two nested calls

        // argv_ptr = _pr_argv_pool + argv_offset (fold into r14).
        lea r11, [rip + _pr_argv_pool];
        add r14, r11;

        // (a) Per-attempt fingerprint bump.
        mov rdi, 11;                         // SH_ST_STAGES
        call shell_note;

        // (b) dispatch_line(argv_ptr, argc).
        mov rdi, r14;
        mov rsi, [rsp + 0];
        call dispatch_line;

        // If not BI_MISS (0xFFFFECE0): builtin hit (BI_OK or BI_ERR_*).
        // Record rc into last_rc and advance to the next stage.
        mov r11, 0xFFFFECE0;                 // BI_MISS
        cmp rax, r11;
        je  sr_stage_exec;
        mov rbx, rax;                        // last_rc = dispatch rc
        jmp sr_stage_next;

      sr_stage_exec:
        // (c) Builtin miss -> derive child sub-cap then external exec.
        // The derived cap lands in _sm_child_cap. Today the wire slot
        // is not consumed by sys_execve (Exec §DEFERRALS: kernel ABI
        // does not accept a sidecar arg yet); the derivation still
        // runs so the session-cap wiring is exercised and complete
        // when the sidecar plumbing lands. Per-stage derivation is
        // correct even under the fork-gap because the target for
        // stage[i] is a distinct child from stage[i-1]; re-deriving
        // per iteration keeps that invariant when #44 lands.
        lea rdi, [rip + _sm_child_cap];
        mov rsi, 1;                          // slot 1 in child's cap_table
        mov rdx, 1;                          // parent session_id placeholder
        call session_derive_subcap;
        // Ignore rax; a failed derivation does not block exec today
        // because the sidecar consumer is not yet plumbed.

        // exec_spawn_and_wait(argv_ptr, argv_bytes, argc).
        mov rdi, r14;
        mov rsi, r15;
        mov rdx, [rsp + 0];
        call exec_spawn_and_wait;
        mov rbx, rax;                        // last_rc = exec rc

      sr_stage_next:
        add r12, 1;
        jmp sr_stage_loop;

      sr_stage_done:
        // Return the last stage's rc (POSIX pipeline convention).
        mov rax, rbx;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sr_propagate:
        // Lex or parse rejected -- rax already holds the sentinel.
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sr_ok_empty:
        xor rax, rax;                        // SR_OK
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // shell_main() -- ELF entry (@no_frame)
  //
  // SysV process entry: rsp is 16-byte aligned; argc at [rsp+0]; argv
  // pointer array at [rsp+8] (one qword per argv[i], argv[argc]==NULL);
  // envp array after argv's NULL terminator; the paideia-os InitCap
  // sidecar follows envp per design/user/execve-abi.md. ENH-006 reads
  // argc + argv only; envp is untouched (D5: shell does not consume
  // environment variables) and the InitCap sidecar is loader-managed
  // today (no runtime cap-table introspection in this repo yet).
  //
  // Sequence:
  //   0. Read argc/argv from initial stack (r15/r14).
  //   0a. Emit `SHELL MAIN OK\n` fingerprint to stderr (once).
  //   1. shell_reset -- clear stats counters.
  //   2. shell_argv_dispatch -- populate _sm_opt_* singletons.
  //   3. dispatch_init -- populate builtin table + reset env table.
  //   4. session_mint -- root session Cap into _sm_session_cap.
  //   5. If -c was set: run one shell_repl_step then sys_exit(0).
  //   6. Otherwise interactive REPL loop:
  //        write prompt -> read line -> shell_repl_step ->
  //        history_encode_record (unless --no-history) -> loop.
  //   7. EOF / LR_ERR_EOF / LR_ERR_READ_FAIL -> newline + sys_exit(0).
  //
  // shell_main never returns; sys_exit terminates the task on every
  // exit path. The `hlt` after each sys_exit is unreachable-belt-and-
  // suspenders, matching init.pdx's own tail-of-_start convention.
  //
  // Register plan:
  //   r15 = argc (survives every nested call: every callee that
  //         touches r15 pushes it in its own prologue per SysV; the
  //         wrappers that do not touch r15 leave it alone).
  //   r14 = argv_base (same discipline).
  //   r13 = interactive line length (set after each line_reader_read_
  //         line; consumed by shell_repl_step + history_encode_record;
  //         both push r13 across their internal use so it survives).
  //
  // Alignment: entry rsp % 16 == 0 (SysV process entry). No push/pop
  // or sub rsp in this body, so rsp % 16 == 0 at every nested `call`.
  // ==========================================================================
  pub let shell_main : () -> () !{mem, sysreg} @{sched, mem, fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem, fs},
      justification: "shell.ENH-006 (#33) + ENH-007 (#34): the shell's ELF entry frame. Reads argc/argv from the SysV initial process stack (argc at [rsp+0], argv qwords at [rsp+8..], argv[argc]==NULL); envp/InitCap follow but are untouched at ENH-006 (D5: no env; sidecar loader-managed). Sequence: SHELL MAIN OK fingerprint sys_write (fd=2, sm_fp_entry_str, 14) -> shell_reset -> shell_argv_dispatch (unknown flag -> stderr `shell: unknown flag\\n` + sys_exit(1)) -> dispatch_init -> session_mint into _sm_session_cap with SM_SESSION_ID (bad-return -> stderr `shell: session_mint failed\\n` + sys_exit(1)) -> either one shell_repl_step (if -c) then sys_exit(0), or the interactive REPL loop. Interactive loop: `$ ` prompt via sys_write(fd=1, 2), line via line_reader_read_line into _sm_line_buf (cap 4096), shell_repl_step, history_encode_record into _sm_hist_buf ring (unless --no-history), repeat. EOF is signalled by line_reader returning 0 (mid-stream EOF caught nowhere else -- shouldn't happen after ENH-007 since 0-byte-at-start returns LR_ERR_EOF, but preserved defensively), LR_ERR_EOF (0xFFFFEC13; 0-byte read at start), or LR_ERR_READ_FAIL (0xFFFFEC14; unrecoverable read errno). LR_ERR_BAD_BUF (0xFFFFEC11) is also treated as EOF defensively -- the alternative is a spin on a misbehaving line reader. LR_STUB is RETIRED at ENH-007 and no longer handled here. Encoder conformance: no `test` mnemonic; every `cmp reg, imm` uses imm <= 0x7FFFFFFF (large-imm sentinels 0xFFFFEC1x stage via `mov r11, imm64; cmp rax, r11`). r15/r14 hold argc/argv_base across nested calls; every callee that uses those regs preserves them per SysV (verified: dispatch_line, exec_spawn_and_wait, lexer_tokenize, parser_parse, session_mint, line_reader_read_line, dispatch_init, shell_reset -- none clobber r14/r15 without a matching push+pop). r13 holds the interactive line length across shell_repl_step + history_encode_record; both push r13 in their prologues so the value survives. @no_frame: this function is the ELF entry point (manifest.pdxproj `entry = Shell::shell_main`), so no push/pop parity is set up; rsp % 16 == 0 at process entry (SysV) and remains so at every nested `call` since no local stack activity happens in this body. History ring append: dst = _sm_hist_buf + _sm_hist_used; skips when _sm_hist_used >= 8192 (ring full or would-underflow the remaining-capacity compute) or when the remaining capacity is < 32 bytes (smallest useful record is 24-byte header + 1 byte + 7 bytes pad = 32). Labels prefixed sm_. Never returns; sys_exit terminates the task on every exit path.",
      block: {
        // Read argc / argv from initial stack.
        mov r15, [rsp + 0];                  // argc
        mov r14, rsp;
        add r14, 8;                          // argv_base = &argv[0]

        // (0) Fingerprint beacon: sys_write(2, "SHELL MAIN OK\n", 14).
        //     One-shot, unconditional, first business after argc/argv are
        //     latched. Proves at runtime that the ELF entry symbol
        //     resolved and the entry frame executed -- the two concerns
        //     the debugger review of 7f3a860 raised when it reopened #33.
        //     sys_write preserves r14/r15 (leaf syscall wrapper: only
        //     rax/rcx/r11 clobbered per SysV syscall convention). The
        //     stderr choice matches the argv/session error paths; a
        //     boot-time smoke can grep either fd 2 or the built binary
        //     for the sm_fp_entry_str rodata blob.
        mov rdi, 2;
        lea rsi, [rip + sm_fp_entry_str];
        mov rdx, 14;                         // strlen (exclude NUL)
        call sys_write;

        // (1) Reset stats.
        call shell_reset;

        // (2) Parse CLI flags into _sm_opt_* singletons.
        mov rdi, r15;
        mov rsi, r14;
        call shell_argv_dispatch;
        cmp rax, 0;
        jne sm_err_argv;

        // (3) Populate the builtin dispatch table + reset env table.
        call dispatch_init;

        // (4) Mint the root KIND_SHELL_SESSION cap.
        lea rdi, [rip + _sm_session_cap];
        xor rsi, rsi;                        // slot 0
        mov rdx, 1;                          // SM_SESSION_ID placeholder
        call session_mint;
        cmp rax, 0;
        jne sm_err_session;

        // (4b) ENH-008 (#35): open the per-session history file, unless
        // --no-history is set. On open failure we store the sentinel
        // (raw HI_ERR_OPEN_FAIL, high bit set) in _sm_hist_fd and
        // continue -- the flush/close helpers no-op on a bad fd, so
        // the shell keeps running even if the persistent-home
        // substrate has not landed yet. `ts` argument: no
        // sys_clock_* wrapper exists in the SC+ floor today (grep
        // of design/user/syscall-table.md returns no clock entry);
        // per issue #35's deferral we pass session_id as `ts` too.
        // When a clock syscall lands, only this call site changes.
        lea r11, [rip + _sm_opt_no_history];
        mov rax, [r11];
        cmp rax, 0;
        jne sm_hist_open_skip;

        mov rdi, 1;                          // session_id = SM_SESSION_ID
        mov rsi, 1;                          // ts placeholder (== session_id)
        call history_open_file;
        // rax = fd (>=0) or HI_ERR_OPEN_FAIL (high bit set).
        lea r11, [rip + _sm_hist_fd];
        mov [r11], rax;
        jmp sm_hist_open_done;

      sm_hist_open_skip:
        // --no-history set: store the -1 sentinel so flush + close
        // no-op silently.
        mov rax, 0xFFFFFFFFFFFFFFFF;
        lea r11, [rip + _sm_hist_fd];
        mov [r11], rax;

      sm_hist_open_done:

        // (5) -c one-shot path.
        lea r11, [rip + _sm_opt_c_cmd_ptr];
        mov rdi, [r11];
        cmp rdi, 0;
        je  sm_repl_loop;

        // Run one line then sys_exit(0).
        lea r11, [rip + _sm_opt_c_cmd_len];
        mov rsi, [r11];
        call shell_repl_step;

        // ENH-008 (#35): close the history fd before -c exit for
        // symmetry with the interactive-mode EOF path. The -c path
        // does not itself append to _sm_hist_buf today (history_encode_
        // record is only reached from the interactive loop), so no
        // flush is needed; a future -c "record the -c command in
        // history" polish would call flush here before close.
        lea r11, [rip + _sm_hist_fd];
        mov rdi, [r11];
        call history_close_file;

        xor rdi, rdi;
        call sys_exit;
        hlt;

      sm_repl_loop:
        // Prompt: sys_write(1, "$ ", 2)
        mov rdi, 1;
        lea rsi, [rip + sm_prompt_str];
        mov rdx, 2;
        call sys_write;

        // Read line: line_reader_read_line(_sm_line_buf, 4096)
        lea rdi, [rip + _sm_line_buf];
        mov rsi, 4096;
        call line_reader_read_line;

        // EOF sentinels: rax == 0, LR_ERR_EOF (0xFFFFEC13),
        // LR_ERR_READ_FAIL (0xFFFFEC14), or LR_ERR_BAD_BUF
        // (0xFFFFEC11, defensive) all route to a clean exit.
        // LR_STUB was retired at ENH-007 (#34) and is no longer checked.
        cmp rax, 0;
        je  sm_eof;
        mov r11, 0xFFFFEC13;                 // LR_ERR_EOF
        cmp rax, r11;
        je  sm_eof;
        mov r11, 0xFFFFEC14;                 // LR_ERR_READ_FAIL
        cmp rax, r11;
        je  sm_eof;
        mov r11, 0xFFFFEC11;                 // LR_ERR_BAD_BUF (defensive)
        cmp rax, r11;
        je  sm_eof;

        // Bound the returned length to the buffer cap.
        mov r13, rax;                        // r13 = line_len
        cmp r13, 4096;
        ja  sm_eof;                          // overflow -> clean exit

        // shell_repl_step(_sm_line_buf, r13). rc ignored for ENH-006.
        lea rdi, [rip + _sm_line_buf];
        mov rsi, r13;
        call shell_repl_step;

        // History append (skip if --no-history).
        lea r11, [rip + _sm_opt_no_history];
        mov rax, [r11];
        cmp rax, 0;
        jne sm_hist_skip;

        // Skip if ring is at capacity (also guards the sub below from
        // underflowing the remaining-capacity compute).
        lea r11, [rip + _sm_hist_used];
        mov rcx, [r11];
        cmp rcx, 8192;
        jae sm_hist_skip;

        // dst = &_sm_hist_buf + _sm_hist_used;
        // dst_len = 8192 - _sm_hist_used
        lea r11, [rip + _sm_hist_buf];
        mov rdi, r11;
        add rdi, rcx;
        mov rsi, 8192;
        sub rsi, rcx;

        // Need at least header(24) + 1 byte + 7 bytes pad = 32 bytes.
        cmp rsi, 32;
        jbe sm_hist_skip;

        lea rdx, [rip + _sm_line_buf];       // cmd_ptr
        mov rcx, r13;                        // cmd_len
        xor r8,  r8;                         // ts_ns = 0 (no clock yet)
        xor r9,  r9;                         // flags = 0
        call history_encode_record;
        cmp rax, 0;
        jne sm_hist_skip;                    // encoder refused -> drop

        // Advance _sm_hist_used by history_bytes_written.
        lea r11, [rip + history_bytes_written];
        mov rax, [r11];
        lea r11, [rip + _sm_hist_used];
        mov rcx, [r11];
        add rcx, rax;
        mov [r11], rcx;

        // ENH-008 (#35): drain the ring to disk. history_persist_flush
        // internally checks --no-history and fd validity, so we call
        // unconditionally and ignore the return: a failed flush is
        // silent-with-counter-bump today (SH_ST_ERRORS incremented by
        // the flush's own reject path); a future error-surfacing polish
        // can promote it to a user-visible message.
        lea r11, [rip + _sm_hist_fd];
        mov rdi, [r11];
        call history_persist_flush;

      sm_hist_skip:
        jmp sm_repl_loop;

      sm_eof:
        // ENH-008 (#35): close the history fd before exiting so the
        // last-batch data reaches the filesystem cleanly. close_file
        // no-ops on a bad fd; return code ignored.
        lea r11, [rip + _sm_hist_fd];
        mov rdi, [r11];
        call history_close_file;

        // Trailing newline so the terminal cursor lands on a fresh line.
        mov rdi, 1;
        lea rsi, [rip + sm_nl_str];
        mov rdx, 1;
        call sys_write;
        xor rdi, rdi;
        call sys_exit;
        hlt;

      sm_err_argv:
        // stderr "shell: unknown flag\n" then sys_exit(1).
        mov rdi, 2;
        lea rsi, [rip + sm_err_unknown_flag_str];
        mov rdx, 20;                         // exclude trailing NUL
        call sys_write;
        mov rdi, 1;
        call sys_exit;
        hlt;

      sm_err_session:
        mov rdi, 2;
        lea rsi, [rip + sm_err_session_mint_str];
        mov rdx, 27;                         // exclude trailing NUL
        call sys_write;
        mov rdi, 1;
        call sys_exit;
        hlt
      }
    } @no_frame
}
