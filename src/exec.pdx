// src/exec.pdx -- shell.M1-003 + M2-003 + ENH-005 (paideia-os/shell#3, #6, #32)
//
// Exec module: real sys_execve + sys_wait4 exec path (ENH-005 landing).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The shell's exec path. Through v1.0.0 exec_spawn_and_wait was a
// gate-and-stub (returned EX_STUB after argv validation). ENH-005
// (paideia-os/shell#32) replaced that tail with the real 7-step
// sequence the module's own §"M2 CALL GRAPH" (below) has documented
// since M1. shell#44 then closes the last substrate gap by inserting
// sys_fork (SC+ 56) between command_record_begin and sys_execve: the
// shell now forks BEFORE exec so the parent's timeline survives to
// wait on the child, close the audit record, and return the child's
// exit code to the REPL. D3 audit-first stays intact as a running-
// system property (see test_audit_first.pdx for the encoder half of
// the same invariant); the parent-visible fingerprint proving fork
// worked end-to-end is a `SHELL FORK OK pid=<n>\n` emission via
// sys_write(1) between fork and wait4 (asserted by the QEMU boot
// smoke; see design/architecture.md §4.3 and paideia-os
// design/roadmap/rows-4-5-6-scoping.md §4.2).
//
// Post-shell#44 the shell is a POSIX-shaped fork/exec/wait shell.
// The v1.0.0 walk-back ("shell has never spawned a process") and the
// ENH-005 walk-back ("shell has spawned but never survives the spawn")
// are both retired. STATUS.md carries the historical notes; the exec
// path is now substrate-complete.
//
// =============================================================================
// M2 CALL GRAPH (LIVE after shell#44; see §DEFERRALS below for the
// remaining sidecar-handoff work)
// =============================================================================
//
// exec_spawn_and_wait executes this ordered sequence -- the ordering
// itself is the load-bearing property, so a reader reviewing the body
// can walk it top-to-bottom and see each step land in the same order
// as the doc:
//
//   (0) Build the child's argv[] pointer array from the parser's
//       NUL-separated argv pool (exec_build_argv_ptrs); the pool
//       carries "ls\0-la\0/tmp\0" and the built array carries three
//       pointers plus a NULL sentinel that sys_execve consumes as
//       the child's char** argv. This step lives INSIDE
//       exec_spawn_and_wait because the pool -> ptr-array shape
//       change is called-once per spawn and does not warrant a
//       separate public API today. When the REPL (ENH-006) or a
//       future pipeline wiring needs to reuse the marshalling from
//       another caller, exec_build_argv_ptrs is already exported
//       for direct use.
//   (1) Resolve `path` = argv[0] (the first pointer in the built
//       argv array). PATH-search over the InitCap-seeded PATH cap
//       set is deferred to ENH-006 (REPL) -- shell#32 lands the
//       exact-argv[0] path (matches the monorepo's
//       resolve_path fall-through-to-/bin/ semantics's INPUT
//       shape).
//   (2) Populate a minimal parent-cap set + empty child-decl set
//       and call exec_narrow_child_caps (unchanged since M2-003 at
//       src/exec.pdx:205). The narrowing enforces the widen check
//       (child & ~parent) == 0 + rights intersection; on the ENH-005
//       placeholder inputs (1 parent placeholder session cap +
//       child_decl_count=0) the narrowing trivially succeeds and
//       produces an empty sidecar. When libpdx-cap's caps_decl
//       parser is linked and runtime cap-table introspection lands,
//       replace the placeholder parent-cap materialiser with the
//       real ambient cap set + parsed child_decl -- everything else
//       here stays untouched. See §DEFERRALS.
//   (3) cap_manifest_verify: DEFERRED. libpdx-cap is not linked in
//       the shell repo today (see manifest.pdxproj `deps:` -- the
//       library is named but not fetched), and the verifier lives
//       in that library. The narrowing at (2) already carries the
//       load-bearing invariant (a widening child is refused BEFORE
//       exec); cap_manifest_verify would layer a defence-in-depth
//       check on the ALREADY-narrowed sidecar. When libpdx-cap
//       lands, insert the call here between (2) and (4). See
//       §DEFERRALS.
//   (4) command_record_begin -- audit-first, durable BEFORE the
//       fork. This is where D3's "every user-facing operation emits
//       an audit record BEFORE it emits any user-visible output"
//       becomes a property of a running system, not just of the
//       encoder. Failure at this gate (dst too small, argv_bytes >
//       CMDR_ARGV_MAX, audit_id 0) returns EX_ERR_AUDIT_BEGIN_FAIL
//       and DOES NOT PROCEED to fork or exec -- the child never
//       runs if the audit trail cannot record the attempt.
//       audit_id is a placeholder (1) at ENH-005; when libpdx-audit
//       is linked it will be the id returned by audit_begin.
//   (4a) sys_fork (shell#44). Retires the pre-shell#44 §FORK GAP.
//        Three return arms:
//        - rax < 0 (signed): fork failed (kernel OOM). Parent-side
//          only. Close the audit record with exit=127 (fork failed
//          before child image loaded) and return EX_ERR_FORK_FAIL.
//        - rax == 0: this task is the CHILD. Fall through to (5)
//          sys_execve on the same argv. If execve returns (i.e.
//          fails), the child immediately sys_exit(127) so the
//          parent's wait4 observes the POSIX "command not found"
//          exit code. The child MUST NOT call command_record_close
//          -- its aspace is a copy of the parent's, so a close from
//          the child would mutate only the child's copy and the
//          child image is about to be discarded by execve anyway.
//        - rax > 0: this task is the PARENT. rax is the child pid.
//          Emit the `SHELL FORK OK pid=<n>\n` fingerprint via
//          sys_write(1) so the QEMU boot smoke can assert fork
//          worked end-to-end. Then fall through to (6) sys_wait4
//          against the specific child pid.
//   (5) sys_execve(path, argv_ptrs, envp=NULL). Frozen ABI at
//       design/user/execve-abi.md (R62): argc in rdi, argv in rsi,
//       envp in rdx at the child's _start. envp is NULL per D5
//       (shell does not leak env vars to children). CHILD-BRANCH
//       ONLY after shell#44 -- the parent skips (5) entirely. On
//       execve success the child image is replaced and control
//       never returns; on failure the child sys_exit(127) so the
//       parent's wait4 sees the exit code (127 == POSIX
//       "command not found / not executable"). The pre-shell#44
//       EX_ERR_EXECVE_FAIL parent-visible sentinel is superseded
//       by the child's exit-code surface for that failure mode;
//       the sentinel constant is retained in Shell:: for the
//       old-decoder compat window (see shell.pdx sentinel table).
//   (6) sys_wait4(pid=child_pid, wstatus, 0, 0). PARENT-BRANCH
//       ONLY after shell#44. Reaps the specific child forked at
//       (4a) (POSIX-shaped: waiting on the known pid narrows the
//       reap window and future-proofs the body for concurrent
//       children when the pipeline shape lands). Refusal (negative
//       errno) maps to EX_ERR_WAIT_FAIL with an exit=127 audit
//       close before returning.
//   (6a) exec_reconcile_publish(count) -- shell#39. PARENT-BRANCH
//        ONLY, between successful sys_wait4 and command_record_close.
//        R90-XREPO.013.M2-001: the shell must invoke exec-time cap
//        reconciliation for every child and publish the reconciled
//        cap-set to the shell's per-job record. Today the KERNEL-
//        side sys_exec_reconcile_caps syscall wrapper is NOT yet in
//        the SC+ syscall floor (the kernel substrate landed at
//        paideia-os R90-XREPO.013.M0-001 as an internal
//        cap_reconcile_at_exec function; the user-space syscall
//        wrapper waits on a follow-up SC+ ID allocation). Framing +
//        publish landed here so the ordering, the audit surface,
//        and the boot-smoke fingerprint (`SHELL RECONCILE n=<c>\n`)
//        are in place; when the syscall lands, only the body of
//        exec_reconcile_publish acquires a real syscall call. The
//        count published today = child_decl_count (the sidecar
//        entries exec_narrow_child_caps wrote at step 2) which is 0
//        under the ENH-005 placeholder inputs; when the parent-cap
//        materialiser + real caps.decl parser land, the count will
//        reflect the actual narrowed cap-set the kernel reconciled
//        for the child. Non-zero return from the publish helper
//        maps to EX_ERR_RECONCILE_FAIL after an exit=127 audit close
//        (same discipline as EX_ERR_WAIT_FAIL); publish success does
//        not mutate the parent's exit code -- the child's exit
//        remains the value command_record_close records.
//   (7) command_record_close(exit_code). PARENT-BRANCH ONLY. Pairs
//       with (4). CLOSED flag set; HAS_ERROR set iff exit_code
//       != 0. On any failure above (fork fail, wait fail) close
//       is called with exit=127 so the audit journal never
//       carries an orphaned OPEN record.
//
// =============================================================================
// FORK: LIVE (shell#44 retirement of the ENH-005 §FORK GAP)
// =============================================================================
//
// Historical note: through ENH-005 (paideia-os/shell#32) this body
// executed the ordered sequence WITHOUT a fork, so sys_execve either
// succeeded (never returned; shell became child) or failed (returned
// errno; audit close + EX_ERR_EXECVE_FAIL). sys_wait4 was structurally
// reachable only via the execve-failure edge and typically returned
// -ECHILD; the "no child to wait for" outcome was documented in a
// §FORK GAP block that is now retired.
//
// shell#44 makes wait4 meaningful. The kernel-side sys_fork body has
// been live since paideia-os R15-M6-003 (#554) with the R17-M0-724-D6
// child-materialisation completion; the shell repo's ENH-001 Syscall
// floor deliberately omitted the wrapper because the ENH-005 spawn
// path did not need it. shell#44 adds SC+ 56 to the Syscall floor,
// splits exec_spawn_and_wait into fork -> parent-wait / child-exec,
// and emits a boot-smoke-observable fingerprint on the parent's
// timeline between fork and wait4 (`SHELL FORK OK pid=<n>\n` via
// sys_write(1) -- the assertion that the QEMU smoke matches against
// once the shell is wired into paideia-os `bin_seeds.pdx`).
//
// The D3 property (audit-first, durable-before-child) is stronger
// after shell#44 than before: command_record_begin runs BEFORE
// sys_fork so the audit record exists in the parent's aspace before
// the child even exists as a task -- a reader replaying the audit
// journal sees the OPEN record with a timestamp strictly before the
// child's first schedule.
//
// =============================================================================
// DEFERRALS (with follow-up hooks)
// =============================================================================
//
//   - InitCap sidecar materialiser (step 2 real inputs). Replace the
//     placeholder parent-cap MOV with the shell's ambient cap set once
//     runtime cap-table introspection lands. exec_narrow_child_caps
//     already handles the general shape.
//   - cap_manifest_verify (step 3). Link libpdx-cap; call its verifier
//     on the narrowed sidecar between steps 2 and 4.
//   - Sidecar handoff to sys_execve (step 5). Kernel sys_execve_shim
//     does not currently accept an InitCap sidecar argument (see
//     design/user/execve-abi.md -- argc/argv/envp only). When the
//     kernel ABI grows a sidecar slot, pass _ex_sidecar_buf +
//     _ex_sidecar_count as the fourth arg.
//   - audit_id + timestamps (steps 4, 7). Wire to libpdx-audit's
//     audit_begin / audit_commit and to sys_clock_monotonic once
//     those substrates land.
//   - PATH search (step 1 richer form). Deferred to ENH-006 REPL.
//   - Real sys_exec_reconcile_caps syscall wiring (step 6a). Today
//     exec_reconcile_publish stubs the reconciliation query and
//     publishes the sidecar-derived count as a stand-in. When the
//     kernel's user-space wrapper for cap_reconcile_at_exec lands
//     (SC+ ID TBD; substrate lives at paideia-os
//     src/kernel/core/cap/reconcile.pdx per R90-XREPO.013.M0-001),
//     add SYS_EXEC_RECONCILE_CAPS to src/syscall.pdx and replace
//     the count-only publish body with a real query that reads the
//     kernel-narrowed cap-set for child_pid. The parent-visible
//     publish record (_ex_reconciled_caps_count) stays as the
//     shell-side per-job hand-off; the CommandRecord wire format
//     grows a reconciled_count field when M4-* adopts pdxfs-native
//     record extensions (out of shell#39 scope; the count is exposed
//     as a shell pub let today so a future audit_commit variant can
//     pick it up without another cross-repo signal).
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Exec`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Large immediates
//     (0xFFFFEC21..0xFFFFEC2A error sentinels, the placeholder
//     parent-cap fused qword, negative-errno gate values,
//     sys_wait4 pid==child_pid staging when the pid is <= 0x7FFFFFFF
//     it fits imm32 directly) via mov r10, imm64.
//   - r11 is scratch for .bss LEA reach on the M2 body; never touched
//     by narrow_caps / command_record_* / sys_* wrappers (all
//     documented to preserve r11 or, in the case of syscall wrappers,
//     to clobber only rcx/r11 which we do not carry across the call).
//   - Byte reads in exec_build_argv_ptrs use the #1248 pattern
//     (`xor rax, rax; mov_b rax, [ptr]`) with explicit `* 1` scale
//     to dodge the U1606 index-scale gotcha.
//   - exec_spawn_and_wait: 5 callee-save pushes (rbx, r12, r13, r14,
//     r15) + `sub rsp, 8` = 48 bytes prologue; rsp % 16 == 0 at
//     every nested SysV call.
//   - exec_build_argv_ptrs: leaf function, no push/pop parity.

module Exec = structure {

  // ==========================================================================
  // M2-003 additions: caps environment propagation.
  //
  // The shell hands each child process a cap set assembled by
  // narrowing the shell's own held caps against the child's declared
  // caps.decl requirements. The narrowing enforces two invariants
  // simultaneously:
  //
  //   * MONOTONE: the child's rights are a strict SUBSET of the
  //     parent's rights (`(child & ~parent) == 0`). Any bit the child
  //     requests that the parent does not hold is a widening attempt
  //     and refused with EX_ERR_WIDENING. This is the same discipline
  //     libpdx-cap's cap_pack_narrowed enforces at the byte level
  //     (see libpdx-cap/src/cap.pdx cap_pack_narrowed body).
  //
  //   * NARROWED: the child receives the INTERSECTION of what its
  //     caps.decl asks for and what the parent holds. A child that
  //     asks for KIND_TTY(read) when the parent holds KIND_TTY(write)
  //     receives NOTHING for that KIND (intersection is empty) --
  //     refused with EX_ERR_MISSING_CAP. A child that asks for
  //     KIND_PDXFS_FILE(read) when the parent holds
  //     KIND_PDXFS_FILE(read | write) receives read only.
  //
  // The parent-cap set is passed as a flat wire-record array (16 bytes
  // per Cap, same layout as libpdx-cap's Cap). The child-decl set is
  // ALSO a flat wire-record array -- at M2, the caller (the shell's
  // exec dispatcher) has already parsed the child's caps.decl file
  // through libpdx-cap's caps_decl parser and materialised the
  // requirements as a wire-record array using symbolic rights masks.
  // exec_narrow_child_caps does the narrowing.
  //
  // The output is another flat wire-record array (the child's InitCap
  // sidecar entries for its ambient caps -- excluding the pipe caps
  // pipeline_plan produces separately and the session cap M2-001
  // produces separately). The exec layer concatenates the three
  // buffers (session + pipeline + narrowed caps.decl) into one
  // per-child sidecar at sys_execve time.
  //
  // As with M1, the ACTUAL sys_execve call is a substrate deferral --
  // exec_spawn_and_wait still returns EX_STUB on its happy path.
  // exec_narrow_child_caps is a pure narrowing helper that does not
  // touch the substrate boundary at all; it operates entirely on
  // caller-owned buffers.
  //
  // Wire record layout (matches Cap wire from libpdx-cap):
  //   +0    u16 slot
  //   +2    u16 kind
  //   +4    u32 rights
  //   +8    u64 target_ptr
  //
  // Rights masks used by exec_narrow_child_caps operate on the u32
  // rights lane only; all logic is bitmask AND / bitmask AND-NOT.
  // ==========================================================================

  // Max entries considered in one call. Fits imm <= 0x7FFFFFFF by wide
  // margin; the largest observed caps.decl in the R49 wave has 6
  // requires items (pkg install), so 16 gives 2x headroom for future
  // tools without changing the layout.
  pub let EX_NARROW_MAX_ENTRIES : u64 = 16

  // ==========================================================================
  // exec_narrow_child_caps(parent, parent_count, child_decl,
  //                        child_decl_count, dst, dst_max_entries) -> u64
  //
  // Signature: exec_narrow_child_caps : (u64, u64, u64, u64, u64, u64)
  //                                     -> u64 !{mem} @{}
  // RDI (input): parent            -- VA of parent-cap wire-record array
  // RSI (input): parent_count      -- entries in parent (0..EX_NARROW_MAX)
  // RDX (input): child_decl        -- VA of child-decl wire-record array
  // RCX (input): child_decl_count  -- entries in child_decl (0..EX_NARROW_MAX)
  // R8  (input): dst               -- VA of the destination sidecar buffer
  //                                  (must hold at least child_decl_count
  //                                   16-byte entries; else EX_ERR_SIDECAR_FULL)
  // R9  (input): dst_max_entries   -- entries dst can hold
  // RAX (output): EX_OK (0) on success, else EX_ERR_MISSING_CAP |
  //               EX_ERR_WIDENING | EX_ERR_SIDECAR_FULL |
  //               EX_ERR_BAD_ARGV (reused for null-ptr / count-zero
  //               args in this helper).
  //
  // For each entry in child_decl:
  //   (1) Look up parent-cap entry with matching KIND (linear scan).
  //   (2) If no match: EX_ERR_MISSING_CAP (fail-fast; dst untouched
  //       for entries beyond this point).
  //   (3) Check widen: if (child_rights & ~parent_rights) != 0,
  //       EX_ERR_WIDENING.
  //   (4) Write narrowed Cap to dst[i]: qword0 = slot | (kind << 16)
  //       | ((child_rights & parent_rights) << 32); qword1 =
  //       parent_target_ptr. child_target_ptr in the decl entry is
  //       ignored -- the child's cap must point at the PARENT'S
  //       target, not at a target the decl invented.
  //
  // Bumps SH_ST_SPAWNS (slot 2) on every entry (spawn intent).
  // Bumps SH_ST_ERRORS on any reject path.
  //
  // Register plan:
  //   r12 = parent base            (callee-save)
  //   r13 = parent_count           (callee-save)
  //   r14 = child_decl base        (callee-save)
  //   r15 = child_decl_count       (callee-save)
  //   rbx = i (outer loop; 0..child_decl_count)
  //   rbp = dst base + inner scan cache
  //   rax = compute scratch / return value
  //   r10 = large-imm scratch / lane mask
  //   r11 = inner-loop cursor scratch
  //   rdi = child_kind (cached for inner scan)
  //   rsi = child_rights (cached for widen)
  //
  // Prologue: 6 pushes (rbx, rbp, r12, r13, r14, r15) + `sub rsp, 8`
  // = 56 bytes; rsp % 16 == 0 for shell_note. Matched epilogue at
  // every return. Same idiom as libpdx-argv parse_argv.
  //
  // Note on the two-return-value convention: the destination buffer's
  // filled-entry COUNT equals child_decl_count on success (one output
  // per requirement); on failure the number of GOOD entries written
  // is unspecified because the caller should treat dst as poisoned
  // (matches libpdx-cap cap_manifest_verify's discipline).
  // ==========================================================================
  pub let exec_narrow_child_caps : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (parent_count: u64) (child_decl: u64) (child_decl_count: u64) (dst: u64) (dst_max_entries: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.M2-003 (#6): cap narrowing at exec. For each entry in the child's caps.decl (wire-form), find the matching-KIND parent cap by linear scan, check that child rights are a subset of parent rights (widen check `(child & ~parent) == 0`, same as libpdx-cap cap_pack_narrowed), and write a narrowed Cap to dst carrying rights = (child & parent) and target_ptr = parent's target_ptr (the child cap points at parent's target, not at a decl-invented target). MISSING and WIDENING are both fail-fast; dst may hold partial results on reject and callers must treat it as poisoned (matches libpdx-cap cap_manifest_verify discipline). Wire layout matches libpdx-cap's Cap (16 bytes: slot|kind|rights fused into qword0, target_ptr in qword1). 6 pushes (rbx outer index, rbp inner cursor scratch, r12 parent, r13 parent_count, r14 child_decl, r15 child_decl_count) + `sub rsp, 8` = 56 bytes prologue; rsp%16==0 for shell_note. Same idiom as libpdx-argv parse_argv. r11 scratch (paideia-as reserved) for inner-scan cursor; every compare uses imm <= 0x7FFFFFFF (largest is EX_NARROW_MAX_ENTRIES = 16). Byte reads not needed -- all fields are qword-load / qword-store from wire records. Labels prefixed en_nc_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                        // parent base
        mov r13, rsi;                        // parent_count
        mov r14, rdx;                        // child_decl base
        mov r15, rcx;                        // child_decl_count
        mov rbp, r8;                         // dst base
        // r9 = dst_max_entries stays in r9 for the overflow gate below

        // Bump SH_ST_SPAWNS (attempt counter).
        mov rdi, 2;                          // SH_ST_SPAWNS
        call shell_note;

        // Gate: parent non-null.
        cmp r12, 0;
        je  en_nc_bad_argv;
        // Gate: parent_count non-zero.
        cmp r13, 0;
        je  en_nc_bad_argv;
        // Gate: child_decl non-null.
        cmp r14, 0;
        je  en_nc_bad_argv;
        // dst non-null (child_decl_count == 0 is allowed -- child
        // declares no caps beyond the ambient session cap, valid case).
        cmp rbp, 0;
        je  en_nc_bad_argv;

        // Gate: dst_max_entries >= child_decl_count.
        cmp r9, r15;
        jb  en_nc_sidecar_full;

        // Gate: parent_count <= EX_NARROW_MAX_ENTRIES.
        cmp r13, 16;                         // EX_NARROW_MAX_ENTRIES
        ja  en_nc_bad_argv;
        // Gate: child_decl_count <= EX_NARROW_MAX_ENTRIES.
        cmp r15, 16;
        ja  en_nc_bad_argv;

        // Special case: child_decl_count == 0. Success with zero
        // output; caller may still concat session + pipeline caps.
        cmp r15, 0;
        je  en_nc_done_ok;

        // Outer loop: rbx = 0 ; rbx < child_decl_count ; rbx++
        xor rbx, rbx;

      en_nc_outer_head:
        // Load child_decl[rbx] into rdi (kind) and rsi (rights).
        // decl entry: [+0] slot|kind|rights fused; [+8] target_ptr.
        mov r10, rbx;
        shl r10, 4;                          // r10 = rbx * 16
        mov rax, [r14 + r10 * 1 + 0];            // qword0 = slot|kind|rights (U1606: index needs explicit *1 scale)
        // Extract kind (bits 16..31) and rights (bits 32..63).
        mov rdi, rax;
        shr rdi, 16;
        and rdi, 0xFFFF;                     // rdi = child_kind
        mov rsi, rax;
        shr rsi, 32;                         // rsi = child_rights (u32)
        // Also cache the child's requested slot (bits 0..15) so we
        // preserve it in the narrowed output. The child's caps.decl
        // is the authority on which slot the child expects.
        mov rcx, rax;
        and rcx, 0xFFFF;                     // rcx = child_slot

        // Inner scan: find the parent entry with matching KIND.
        // r11 = inner cursor (0..parent_count).
        xor r11, r11;

      en_nc_inner_head:
        cmp r11, r13;
        jae en_nc_missing;                   // scanned all parents; no match

        // Load parent[r11] qword0 and extract kind.
        mov r10, r11;
        shl r10, 4;                          // r10 = r11 * 16
        mov rax, [r12 + r10 * 1 + 0];
        shr rax, 16;
        and rax, 0xFFFF;                     // rax = parent_kind
        cmp rax, rdi;                        // parent_kind == child_kind?
        je  en_nc_found;

        add r11, 1;
        jmp en_nc_inner_head;

      en_nc_found:
        // r10 = r11 * 16 (parent entry offset, still cached in r10).
        // Load parent's rights (qword0 bits 32..63) and target_ptr.
        mov rax, [r12 + r10 * 1 + 0];
        shr rax, 32;                         // rax = parent_rights (u32)

        // Widen check: (child_rights & ~parent_rights) == 0 ?
        // Compute: rdx = ~parent; and rdx, rsi (child); cmp rdx, 0.
        mov rdx, rax;
        not rdx;                             // rdx = ~parent_rights
        and rdx, rsi;                        // rdx = child & ~parent
        cmp rdx, 0;
        jne en_nc_widening;

        // Narrowed rights = child_rights & parent_rights.
        and rax, rsi;                        // rax = narrowed rights

        // Load parent's target_ptr into rdx.
        mov rdx, [r12 + r10 * 1 + 8];            // rdx = parent target_ptr

        // Assemble dst[rbx] qword0 = child_slot | (child_kind << 16)
        //                          | (narrowed_rights << 32).
        // rcx = child_slot (0..65535 already masked).
        // rdi = child_kind (0..65535 already masked).
        // rax = narrowed_rights (u32).
        mov r10, rdi;
        shl r10, 16;                         // r10 = kind << 16
        or  rcx, r10;                        // rcx = slot | (kind << 16)
        shl rax, 32;                         // rax = rights << 32
        or  rcx, rax;                        // rcx = full qword0

        // dst offset = rbx * 16.
        mov r10, rbx;
        shl r10, 4;                          // r10 = rbx * 16
        mov [rbp + r10 * 1 + 0], rcx;
        mov [rbp + r10 * 1 + 8], rdx;            // parent's target_ptr

        // Advance outer loop.
        add rbx, 1;
        cmp rbx, r15;
        jb  en_nc_outer_head;

      en_nc_done_ok:
        xor rax, rax;                        // EX_OK (0)
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      en_nc_bad_argv:
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFEC21;                 // EX_ERR_BAD_ARGV
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      en_nc_missing:
        mov rdi, 4;
        call shell_note;
        mov rax, 0xFFFFEC24;                 // EX_ERR_MISSING_CAP
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      en_nc_widening:
        mov rdi, 4;
        call shell_note;
        mov rax, 0xFFFFEC25;                 // EX_ERR_WIDENING
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      en_nc_sidecar_full:
        mov rdi, 4;
        call shell_note;
        mov rax, 0xFFFFEC26;                 // EX_ERR_SIDECAR_FULL
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ENH-005 (#32): storage + constants for the real spawn body
  // ==========================================================================

  // Max entries in the child's char** argv array (including the trailing
  // NULL sentinel). 16 gives 15 real args + 1 NULL; comfortably above
  // the Lexer's per-stage word count in practice (a typical interactive
  // command is 2..5 words) and matches the kernel-side sys_execve_shim
  // cap of 16 argv entries (design/user/execve-abi.md §"Layout: where
  // argv/envp actually live"). Fits imm <= 0x7FFFFFFF trivially.
  pub let EX_ARGV_PTRS_MAX  : u64 = 16

  // Audit-record buffer size. CMDR_HEADER_SIZE is 48; the largest
  // per-stage argv the shell will encounter is bounded by the
  // parser's PR_ARGV_POOL_SIZE (4096 bytes; the whole pool spans all
  // stages, but a per-stage slice can consume the entire pool if
  // there is only one stage). Sizing at 4160 (= 4096 + 48 header +
  // 16 pad headroom) leaves 8 bytes of slack past the CMDR encoder's
  // internal (argv_bytes + 7) & ~7 rounding for the worst-case
  // single-stage line. Fits imm <= 0x7FFFFFFF trivially.
  //
  // A caller passing argv_bytes larger than CMDR_ARGV_MAX (8192) is
  // rejected by command_record_begin itself with CMDR_ERR_TOO_LONG
  // before touching this buffer, which routes to
  // EX_ERR_AUDIT_BEGIN_FAIL below. The buffer is sized for the
  // PARSER-BOUNDED case; the CMDR-cap case cannot reach it.
  pub let EX_AUDIT_BUF_SIZE : u64 = 4160

  // Fresh 0xFFFFEC2x sub-band extensions (existing: EX_STUB=..20,
  // EX_ERR_BAD_ARGV=..21, EX_ERR_EXECVE_FAIL=..22, EX_ERR_WAIT_FAIL=..23,
  // EX_ERR_MISSING_CAP=..24, EX_ERR_WIDENING=..25, EX_ERR_SIDECAR_FULL=..26,
  // EX_ERR_ARGV_OVERFLOW=..27, EX_ERR_AUDIT_BEGIN_FAIL=..28,
  // EX_ERR_FORK_FAIL=..29, EX_ERR_RECONCILE_FAIL=..2A).
  //
  // EX_ERR_ARGV_OVERFLOW: exec_build_argv_ptrs was asked to marshal
  // an argc that would not fit in the destination pointer array
  // (argc + 1 > dst_max). At EX_ARGV_PTRS_MAX = 16 that means an
  // input argc > 15 -- refused before any walk of the pool.
  //
  // EX_ERR_AUDIT_BEGIN_FAIL: command_record_begin returned non-zero
  // (dst too small, argv_bytes > CMDR_ARGV_MAX, or audit_id 0). The
  // D3 audit-first invariant forbids proceeding to sys_execve when
  // the audit record cannot be opened.
  //
  // EX_ERR_FORK_FAIL (shell#44): sys_fork returned a negative errno
  // (kernel task_new / aspace_clone_cow OOM -- typically -EAGAIN
  // 0xFFFFFFFFFFFFFFF5 or -ENOMEM 0xFFFFFFFFFFFFFFF4). Fork happens
  // AFTER command_record_begin, so the audit record must be closed
  // with exit=127 before returning this sentinel; otherwise the
  // audit journal leaks an orphaned OPEN record. Distinct from
  // EX_ERR_EXECVE_FAIL because a fork failure is a KERNEL resource
  // exhaustion signal (worth surfacing to callers as its own
  // condition), whereas an execve failure now surfaces as the
  // child's exit code 127 (POSIX "command not found").
  pub let EX_ERR_ARGV_OVERFLOW    : u64 = 0xFFFFEC27
  pub let EX_ERR_AUDIT_BEGIN_FAIL : u64 = 0xFFFFEC28
  pub let EX_ERR_FORK_FAIL        : u64 = 0xFFFFEC29

  // EX_ERR_RECONCILE_FAIL (shell#39): exec_reconcile_publish returned
  // non-zero on the parent's post-wait4 branch. Reserved for the
  // follow-up landing that swaps the count-only stub for a real
  // sys_exec_reconcile_caps query -- today the helper cannot fail
  // (it publishes an in-memory count + emits a fingerprint), but
  // callers may compile their reject branch against this stable name
  // without waiting on the substrate flip. Same close-then-return
  // discipline as EX_ERR_WAIT_FAIL: the audit record was OPENed at
  // step (4) and must be CLOSEd (exit=127) before returning the
  // sentinel, otherwise the audit journal leaks an orphan.
  pub let EX_ERR_RECONCILE_FAIL   : u64 = 0xFFFFEC2A

  // ==========================================================================
  // Singleton buffers (.bss)
  //
  //   _ex_argv_ptrs   [u64; 16]   built char** array for the child; slot
  //                                argc holds the NULL sentinel per the
  //                                execve ABI (argv[argc] == NULL).
  //   _ex_parent_caps [u64; 2]    ENH-005 placeholder for the shell's
  //                                ambient cap set. 1 wire record
  //                                (16 bytes): (slot=1, kind=SH_KIND_
  //                                SHELL_SESSION=0x194, rights=0xFFFFFFFF,
  //                                target_ptr=0). Replaced with the
  //                                real cap-table snapshot when runtime
  //                                introspection lands (see §DEFERRALS).
  //   _ex_child_decl  [u64; 2]    ENH-005 placeholder for the child's
  //                                caps.decl-derived wire array. Used
  //                                only as a non-NULL base pointer;
  //                                child_decl_count=0 is passed so the
  //                                narrowing trivially succeeds. Real
  //                                data lands when libpdx-cap's caps_decl
  //                                parser is linked.
  //   _ex_sidecar_buf [u64; 32]   Room for 16 narrowed 16-byte Cap
  //                                wire records. Currently unused (kernel
  //                                sys_execve does not accept a sidecar
  //                                arg at the frozen ABI); reserved so
  //                                the M2 CALL GRAPH step (5) can grow
  //                                a real handoff without another
  //                                re-layout.
  //   _ex_audit_rec   [u64; 520]  4160 bytes for one ShellCommandRecord
  //                                (48-byte header + up to 4096 argv
  //                                bytes + 16 bytes pad headroom;
  //                                matches PR_ARGV_POOL_SIZE ceiling
  //                                from parser.pdx).
  //   _ex_wstatus     u64         sys_wait4 output slot. Only the low
  //                                8 bits (exit code) are extracted in
  //                                the happy path per the M2 doc.
  // ==========================================================================
  pub let mut _ex_argv_ptrs   : [u64; 16] = uninit @align(16)
  pub let mut _ex_parent_caps : [u64; 2]  = uninit @align(16)
  pub let mut _ex_child_decl  : [u64; 2]  = uninit @align(16)
  pub let mut _ex_sidecar_buf : [u64; 32] = uninit @align(16)
  pub let mut _ex_audit_rec   : [u64; 520] = uninit @align(16)
  pub let mut _ex_wstatus     : u64       = uninit @align(8)

  // shell#39: per-job reconciled cap-set count. Published on the
  // parent's timeline between sys_wait4 and command_record_close by
  // exec_reconcile_publish. Today the count == child_decl_count from
  // step (2) (0 under the ENH-005 placeholder inputs); when the
  // parent-cap materialiser + real caps.decl parser land, this slot
  // holds the count the kernel reconciled for the child. Exposed as
  // `pub let mut` so downstream consumers (a future audit_commit
  // variant, R90-XREPO.013.M4-* boot smoke asserts) can read it
  // without wiring another cross-repo channel. Only ONE spawn is in
  // flight at a time until per-stage fan-out lands; the slot is
  // therefore a shell-global singleton, same discipline as
  // _ex_wstatus / _ex_fp_pid_scratch.
  pub let mut _ex_reconciled_caps_count : u64 = uninit @align(8)

  // ==========================================================================
  // shell#44: live spawn fingerprint scratch + rodata literals
  //
  // Emitted between sys_fork (parent branch) and sys_wait4 as three
  // sys_write(1, ...) calls:
  //   (1) ex_fp_fork_ok_str  -- "SHELL FORK OK pid="  (18 bytes)
  //   (2) _ex_fp_pid_scratch -- decimal pid rendered via
  //                              history_format_u64_dec (up to 20 bytes)
  //   (3) ex_fp_nl_str       -- "\n"                  (1 byte)
  //
  // history_format_u64_dec writes 1..20 ASCII digits without a NUL;
  // 24-byte scratch gives 4 bytes of slack + 8-byte alignment for the
  // sys_write pointer. The scratch buffer is a shell-global singleton
  // (only one spawn is in flight at a time until per-stage fan-out
  // lands in a future pipeline landing) so the sys_write can pass
  // the buffer VA directly.
  //
  // N in `[u8; N]` = strlen+1 per the paideia-as fingerprint-string
  // rule (feedback_pdx_encoder_pitfalls: N includes the trailing NUL).
  // sys_write counts exclude the NUL, so the pid-prefix write passes
  // rdx=18 and the newline write passes rdx=1.
  //
  // Fingerprint format is asserted by the paideia-os QEMU boot smoke
  // (once the shell is wired into `bin_seeds.pdx`; that wiring is
  // paideia-os-side, sequenced after #33 landed in this repo). The
  // shell repo's local build proves the write sequence compiles;
  // matching a grep against the boot log is the paideia-os half of
  // the fingerprint.
  // ==========================================================================
  pub let mut _ex_fp_pid_scratch : [u8; 24] = uninit @align(8)
  pub let ex_fp_fork_ok_str      : [u8; 19] = "SHELL FORK OK pid=\0"
  pub let ex_fp_nl_str           : [u8; 2]  = "\n\0"
  pub let EX_FP_FORK_OK_LEN      : u64 = 18   // "SHELL FORK OK pid=" strlen

  // shell#39: reconcile-publish fingerprint. Emitted from the parent
  // timeline between sys_wait4 and command_record_close as three
  // sys_write(1, ...) calls:
  //   (1) ex_fp_reconcile_str     -- "SHELL RECONCILE n="   (18 bytes)
  //   (2) _ex_fp_reconcile_scratch -- decimal count rendered via
  //                                    history_format_u64_dec (1..20)
  //   (3) ex_fp_nl_str            -- "\n"                   (1 byte)
  //
  // N = strlen + 1 for the trailing NUL per the paideia-as fingerprint-
  // string rule. sys_write counts exclude the NUL, so the prefix write
  // passes rdx=18 and the newline write passes rdx=1. history_format_
  // u64_dec writes 1..20 ASCII digits without a NUL; a 24-byte scratch
  // gives 4 bytes of slack + 8-byte alignment for the sys_write
  // pointer, matching the fork-fingerprint scratch discipline. The
  // scratch is a shell-global singleton (only one spawn is in flight
  // at a time until per-stage fan-out lands in a future pipeline
  // landing) so the sys_write can pass the buffer VA directly. Kept
  // separate from _ex_fp_pid_scratch even though the two runs never
  // overlap in time -- future concurrent-child work will require
  // distinct per-fingerprint scratches, and separating them now is
  // free (24 bytes .bss).
  pub let mut _ex_fp_reconcile_scratch : [u8; 24] = uninit @align(8)
  pub let ex_fp_reconcile_str          : [u8; 19] = "SHELL RECONCILE n=\0"
  pub let EX_FP_RECONCILE_LEN          : u64 = 18   // "SHELL RECONCILE n=" strlen

  // ==========================================================================
  // exec_build_argv_ptrs(pool_ptr, argv_bytes, argc, dst_ptrs, dst_max)
  //                                                            -> u64
  //
  // Signature: exec_build_argv_ptrs : (u64, u64, u64, u64, u64)
  //                                   -> u64 !{mem} @{}
  // RDI (input): pool_ptr     -- VA of the parser's NUL-separated argv
  //                              pool slice for one stage (e.g.
  //                              "ls\0-la\0/tmp\0"; the trailing NUL
  //                              after the last word is part of the
  //                              slice per parser.pdx).
  // RSI (input): argv_bytes   -- total bytes in the slice (includes
  //                              all separator NULs and the trailing
  //                              NUL after the last word).
  // RDX (input): argc         -- number of words in the slice (1..15).
  // RCX (input): dst_ptrs     -- VA of the destination u64[] pointer
  //                              array (typically _ex_argv_ptrs, but
  //                              exported so a future pipeline layer
  //                              can build a per-stage argv without
  //                              sharing the singleton).
  // R8  (input): dst_max      -- entries dst_ptrs can hold (must be
  //                              >= argc + 1 for the NULL sentinel).
  // RAX (output): 0 on success (dst_ptrs[0..argc] carry pointers into
  //               pool_ptr, dst_ptrs[argc] carries NULL), else
  //               EX_ERR_ARGV_OVERFLOW (argc + 1 > dst_max) or
  //               EX_ERR_BAD_ARGV (any of the four required non-NULL
  //               inputs was NULL / zero).
  //
  // Algorithm:
  //   Gates: pool_ptr != 0, argv_bytes > 0, argc > 0, dst_ptrs != 0,
  //          argc + 1 <= dst_max.
  //   dst_ptrs[0] = pool_ptr                (first word starts at pool)
  //   found = 1
  //   for i in 0..argv_bytes:
  //     if found >= argc: break
  //     if pool_ptr[i] == 0:
  //       dst_ptrs[found] = pool_ptr + i + 1
  //       found += 1
  //   dst_ptrs[argc] = 0                    (NULL terminator)
  //   return 0
  //
  // The break on found >= argc means the trailing NUL after the last
  // word never triggers a spurious pointer write past dst_ptrs[argc-1].
  //
  // Register plan (LEAF function; no callee-save):
  //   r9  = i (loop counter; free after inputs land)
  //   r10 = found counter
  //   r11 = per-iteration compute scratch (pool_ptr + i + 1 stash;
  //         also byte-load target -- clobbered on every iteration)
  //   rax = byte-load scratch / return value
  //   rdi, rsi, rdx, rcx, r8 = inputs (all SysV caller-save;
  //                                    consumed in the body)
  //
  // No shell_note bumps here -- the caller (exec_spawn_and_wait) bumps
  // SH_ST_ERRORS on any propagated non-zero return.
  // ==========================================================================
  pub let exec_build_argv_ptrs : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (pool_ptr: u64) (argv_bytes: u64) (argc: u64) (dst_ptrs: u64) (dst_max: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell.ENH-005 (#32): marshal the parser's NUL-separated argv pool slice into the child's char** argv array. The parser's per-stage output at _pr_argv_pool + argv_offset holds argc words with a NUL byte after every word (including the last), e.g. 'ls\\0-la\\0/tmp\\0' for argc=3 argv_bytes=12; sys_execve expects a char** array whose entries point at each word's first byte with a NULL sentinel at argv[argc] (frozen ABI at design/user/execve-abi.md -- argv[argc] == NULL). This helper walks the pool once, records dst_ptrs[0] = pool_ptr (the first word starts at pool base) and appends a new pointer at dst_ptrs[found] whenever a NUL is seen and found < argc; the break on found >= argc prevents the trailing NUL from writing past dst_ptrs[argc-1]. Written as a leaf helper (no push/pop parity, no shell_note bumps) because the marshalling is a byte-level walk with no branch back into the shell subsystem; the caller bumps SH_ST_ERRORS on any propagated non-zero return so per-call attribution stays intact. Byte load via `xor rax, rax; mov_b rax, [pool_ptr + i * 1]` per the #1248 pattern with explicit `* 1` scale (the U1606 index-scale gotcha from feedback_pdx_encoder_pitfalls). All compares use `cmp reg, 0` or `cmp reg, reg` (no `test rN, rN`). The overflow gate uses `cmp r8, r11` where r11 stages argc + 1 (avoiding a `cmp r8, argc+1` compound). Labels prefixed ex_ba_.",
      block: {
        // Gate: pool_ptr non-null.
        cmp rdi, 0;
        je  ex_ba_bad_argv;
        // Gate: argv_bytes non-zero.
        cmp rsi, 0;
        je  ex_ba_bad_argv;
        // Gate: argc non-zero.
        cmp rdx, 0;
        je  ex_ba_bad_argv;
        // Gate: dst_ptrs non-null.
        cmp rcx, 0;
        je  ex_ba_bad_argv;
        // Gate: dst_max >= argc + 1.
        mov r11, rdx;
        add r11, 1;                          // r11 = argc + 1
        cmp r8, r11;
        jb  ex_ba_overflow;

        // dst_ptrs[0] = pool_ptr.
        mov [rcx + 0], rdi;

        // Walk the pool.
        mov r10, 1;                          // found = 1
        xor r9, r9;                          // i = 0

      ex_ba_walk_head:
        cmp r10, rdx;                        // found >= argc ?
        jae ex_ba_walk_done;
        cmp r9, rsi;                         // i >= argv_bytes ?
        jae ex_ba_walk_done;

        // Byte load pool_ptr[i].
        xor rax, rax;
        mov_b rax, [rdi + r9 * 1];
        cmp rax, 0;
        jne ex_ba_step;

        // Found a NUL. dst_ptrs[found * 8] = pool_ptr + i + 1.
        mov r11, rdi;
        add r11, r9;
        add r11, 1;                          // r11 = pool_ptr + i + 1
        mov [rcx + r10 * 8], r11;
        add r10, 1;                          // found++

      ex_ba_step:
        add r9, 1;
        jmp ex_ba_walk_head;

      ex_ba_walk_done:
        // Write NULL terminator at dst_ptrs[argc].
        xor rax, rax;
        mov [rcx + rdx * 8], rax;
        xor rax, rax;                        // return 0
        ret;

      ex_ba_bad_argv:
        mov rax, 0xFFFFEC21;                 // EX_ERR_BAD_ARGV
        ret;

      ex_ba_overflow:
        mov rax, 0xFFFFEC27;                 // EX_ERR_ARGV_OVERFLOW
        ret
      }
    }

  // ==========================================================================
  // exec_reconcile_publish(count) -> u64  (shell#39 — R90-XREPO.013.M2-001)
  //
  // Signature: exec_reconcile_publish : (u64) -> u64 !{mem, sysreg} @{fs}
  // RDI (input): count -- reconciled cap-set count for the just-reaped
  //                       child (today == child_decl_count at
  //                       exec_narrow_child_caps step (2); when the
  //                       real sys_exec_reconcile_caps syscall lands,
  //                       this is the kernel-reported narrowed count).
  // RAX (output): 0 on success (always today; reserves
  //                EX_ERR_RECONCILE_FAIL for the future real-syscall
  //                landing that can genuinely fail).
  //
  // Body:
  //   (a) Store `count` at _ex_reconciled_caps_count -- the shell's
  //       per-job publish slot. A future audit_commit variant or the
  //       R90-XREPO.013.M4-* boot-smoke can read this without wiring
  //       a fresh cross-repo channel.
  //   (b) Emit the fingerprint `SHELL RECONCILE n=<count>\n` as three
  //       sys_write(1, ...) calls (prefix, decimal count, newline).
  //       This is the parent-visible proof the reconciliation gate
  //       was reached on every child; the paideia-os QEMU boot smoke
  //       grep-asserts it once the shell is wired into `bin_seeds.pdx`
  //       (paideia-os-side, sequenced against R90-XREPO.013.M2-001
  //       adoption of the ls / cat / cp / mv / rm / mkdir / doc
  //       tools per §5 of design/round-retrospectives/r90-xrepo-
  //       wave3-plan.md).
  //   (c) Return 0.
  //
  // What is DEFERRED (documented in §DEFERRALS): the real
  // sys_exec_reconcile_caps syscall wrapper. The kernel-side
  // cap_reconcile_at_exec substrate landed at paideia-os R90-XREPO.
  // 013.M0-001 as a kernel-internal function; its user-space syscall
  // wrapper waits on a follow-up SC+ ID allocation. When that lands,
  // this body inserts a `mov rdi, child_pid; call sys_exec_
  // reconcile_caps` between (a) and (b), then substitutes the
  // returned count for the caller-supplied `count` (which becomes
  // the request-count for the wrapper). No caller of this helper
  // changes; the publish-slot + fingerprint shape stay identical.
  //
  // Register plan:
  //   r12 = count (callee-save; carried across sys_write + history_
  //         format_u64_dec so the fingerprint reads a stable value)
  //   rbx = pushed only for 16-byte alignment (rsp % 16 == 0 for
  //         nested SysV calls); unused by the body
  //
  // Prologue: 2 callee-save pushes (rbx, r12) + `sub rsp, 8` = 24
  // bytes. Entry rsp % 16 == 8; after 2 pushes rsp % 16 == 8; `sub
  // rsp, 8` -> 0. rsp % 16 == 0 at every nested SysV call. Matched
  // epilogue.
  //
  // Effect / capability set: {mem, sysreg} + @{fs}. `mem` for the
  // .bss store at (a) and for the byte-level fingerprint compose at
  // (b); `sysreg` for the nested sys_write SYSCALLs; @{fs} for
  // sys_write's kernel-side write path (matches the fork-fingerprint
  // sys_write sequence in exec_spawn_and_wait). history_format_u64_
  // dec contributes only !{mem} @{} (leaf, no syscall) -- subsumed.
  //
  // shell_note is NOT bumped in this helper: this is a publish step,
  // not a spawn attempt / error. The caller (exec_spawn_and_wait)
  // already bumped SH_ST_SPAWNS at entry and will bump SH_ST_EXITS
  // on the happy tail after this call returns; a non-zero return
  // (reserved for the future real-syscall landing) routes to the
  // EX_ERR_RECONCILE_FAIL reject arm which does its own SH_ST_ERRORS
  // bump.
  //
  // Labels prefixed ex_rp_.
  // ==========================================================================
  pub let exec_reconcile_publish : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (count: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell#39 (R90-XREPO.013.M2-001): publish the reconciled cap-set count for the just-reaped child to the shell's per-job record and emit the parent-visible fingerprint. Today the helper stubs the real sys_exec_reconcile_caps query -- the kernel-side substrate (paideia-os R90-XREPO.013.M0-001, src/kernel/core/cap/reconcile.pdx cap_reconcile_at_exec) is landed but its user-space syscall wrapper waits on a follow-up SC+ ID allocation; when that lands, the wrapper body inserts a `call sys_exec_reconcile_caps` between the publish and the fingerprint and substitutes the kernel-returned count. Body: (a) store `count` at _ex_reconciled_caps_count; (b) emit three sys_write(1, ...) calls -- ex_fp_reconcile_str+18 bytes, history_format_u64_dec pid rendering into _ex_fp_reconcile_scratch then sys_write(1, scratch, digit_count), ex_fp_nl_str+1 byte; (c) return 0. r12 carries `count` across the sys_write + history_format_u64_dec sequence so the .bss store and the fingerprint read the same value; both syscall wrappers and history_format_u64_dec preserve r12 per SysV callee-save. 2 pushes (rbx, r12) + `sub rsp, 8` = 24 bytes prologue; rsp % 16 == 0 at every nested SysV call. rbx is pushed only for 16-byte alignment (unused by the body); a 1-push + sub 8 shape would also align but 2 pushes matches the shell.pdx convention for helpers that call four SysV siblings in sequence. No shell_note bumps -- this is a publish step, not a spawn / error; the caller already bumped SH_ST_SPAWNS at entry and bumps SH_ST_EXITS on the happy tail. Every compare uses `cmp reg, 0` (paideia-as reserved -- no `test rN, rN`); no `cmp reg, imm` needed in this leaf-ish body. Large immediates absent from the body (sys_write count 18 fits imm32, EX_FP_RECONCILE_LEN 18 same, fingerprint scratch buffer VA via lea rip-relative). Labels prefixed ex_rp_ per reserved-label discipline (loop/if forbidden).",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;                          // 24-byte prologue; rsp%16==0

        mov r12, rdi;                        // count survives sys_write

        // (a) Publish count to _ex_reconciled_caps_count.
        lea r11, [rip + _ex_reconciled_caps_count];
        mov [r11 + 0], r12;

        // (b) Fingerprint (1): sys_write(1, "SHELL RECONCILE n=", 18).
        mov rdi, 1;                          // stdout
        lea rsi, [rip + ex_fp_reconcile_str];
        mov rdx, 18;                         // EX_FP_RECONCILE_LEN
        call sys_write;
        // Ignore return; a short write here is a boot-log oddity,
        // not a spawn failure (same discipline as the fork
        // fingerprint sys_write ignores).

        // (b) Fingerprint (2): render decimal count into
        //     _ex_fp_reconcile_scratch and sys_write digit count.
        //   history_format_u64_dec(value=r12, out_buf=_ex_fp_reconcile_scratch)
        //     -> rax = digit count (1..20)
        mov rdi, r12;                        // value = count
        lea rsi, [rip + _ex_fp_reconcile_scratch];
        call history_format_u64_dec;

        // sys_write(1, _ex_fp_reconcile_scratch, digit_count)
        mov rdx, rax;                        // count = digit_count
        mov rdi, 1;
        lea rsi, [rip + _ex_fp_reconcile_scratch];
        call sys_write;

        // (b) Fingerprint (3): sys_write(1, "\n", 1).
        mov rdi, 1;
        lea rsi, [rip + ex_fp_nl_str];
        mov rdx, 1;
        call sys_write;

        // (c) Return 0.
        xor rax, rax;
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // exec_spawn_and_wait(argv_pool_ptr, argv_bytes, argc) -> u64
  //
  // Signature: exec_spawn_and_wait : (u64, u64, u64)
  //                                  -> u64 !{mem, sysreg} @{sched, mem, fs}
  // RDI (input): argv_pool_ptr -- VA of one Parser stage's NUL-separated
  //                                argv text pool slice (typically
  //                                _pr_argv_pool + _pr_stages[i].argv_offset).
  // RSI (input): argv_bytes    -- byte length of that slice (parser's
  //                                _pr_stages[i].argv_bytes; includes
  //                                separator NULs and trailing NUL).
  // RDX (input): argc          -- word count in that slice
  //                                (_pr_stages[i].argc; 1..15).
  // RAX (output): child exit code (0..255) on the fork+exec+wait
  //                success path (live substrate as of shell#44); the
  //                child's exit code surfaces as-is, including 127
  //                when the child's execve failed (POSIX "command not
  //                found" convention). Otherwise one of the 0xFFFFEC2x
  //                sentinels (EX_ERR_BAD_ARGV, EX_ERR_ARGV_OVERFLOW,
  //                EX_ERR_AUDIT_BEGIN_FAIL, EX_ERR_FORK_FAIL,
  //                EX_ERR_WAIT_FAIL, EX_ERR_RECONCILE_FAIL [shell#39
  //                reserved -- unreachable in the M0-stub landing]) or
  //                a propagated exec_narrow_child_caps sentinel
  //                (EX_ERR_MISSING_CAP, EX_ERR_WIDENING,
  //                EX_ERR_SIDECAR_FULL). EX_ERR_EXECVE_FAIL is retired
  //                as of shell#44 (see the shell.pdx sentinel table);
  //                the parent no longer sees it because the child
  //                sys_exits with 127 on execve failure instead of
  //                bubbling a shell-layer sentinel up to the parent
  //                return path.
  //
  // Signature note: ENH-005 changes the arg shape from (argv, argv_count)
  // to (argv_pool_ptr, argv_bytes, argc). The v1.0.0 M1 skeleton
  // accepted a pre-built char** array + count on the assumption that
  // a caller (never written) would materialise both; ENH-005 makes the
  // materialisation a step in this body, taking the parser's pool slice
  // directly (the only real caller today would be dispatch_line / the
  // future REPL, both of which already own the pool slice). No caller
  // in the shell tree consumes the M1 signature (verified via
  // `grep -rn 'exec_spawn_and_wait('` -- returns only design docs and
  // .plans notes at ENH-005 landing time).
  //
  // Ordered sequence (numbered per the §M2 CALL GRAPH doc above):
  //   0. Gate inputs, bump SH_ST_SPAWNS.
  //   1. Build _ex_argv_ptrs via exec_build_argv_ptrs; on overflow
  //      propagate EX_ERR_ARGV_OVERFLOW.
  //   2. Materialise placeholder parent-cap set + zero-count child
  //      decl; call exec_narrow_child_caps into _ex_sidecar_buf. Any
  //      non-zero return propagates verbatim (the helper already
  //      bumped SH_ST_ERRORS).
  //   3. cap_manifest_verify: DEFERRED (libpdx-cap not linked). See
  //      the §DEFERRALS block at the top of this file.
  //   4. command_record_begin into _ex_audit_rec with the pool slice
  //      as argv text, audit_id=1 placeholder, ts_begin_ns=0. On
  //      failure return EX_ERR_AUDIT_BEGIN_FAIL WITHOUT calling
  //      sys_fork or sys_execve -- the D3 audit-first invariant
  //      forbids proceeding without a durable audit record.
  //   4a. shell#44: sys_fork.
  //      - rax < 0 (signed): fork failed. Parent-side only. Close
  //        audit with exit=127, bump SH_ST_ERRORS, return
  //        EX_ERR_FORK_FAIL.
  //      - rax == 0: this task is the CHILD. Fall through to (5).
  //      - rax > 0: this task is the PARENT with child pid in rax.
  //        Stash pid in rbx. Emit the SHELL FORK OK fingerprint
  //        (three sys_write calls: prefix, decimal pid, newline).
  //        Skip (5), jump directly to (6) sys_wait4(child_pid, ...).
  //   5. sys_execve(path=_ex_argv_ptrs[0], argv=_ex_argv_ptrs, envp=0).
  //      envp=0 per D5 (no env-var leak to children). CHILD-BRANCH
  //      ONLY. On success the kernel replaces the child image and
  //      control never returns; on failure the child sys_exit(127)
  //      so the parent's wait4 sees exit code 127. Child MUST NOT
  //      touch the audit record (its aspace is a cow-copy of the
  //      parent's; a close from the child mutates only the child's
  //      copy and the image is about to be discarded anyway) and
  //      MUST NOT tear down the callee-save prologue (sys_exit
  //      never returns; the child's stack dies with the aspace).
  //   6. sys_wait4(pid=child_pid, &_ex_wstatus, 0, 0). PARENT-BRANCH
  //      ONLY. Reaps the specific child forked at (4a). On negative
  //      errno, close audit with exit=127 and return EX_ERR_WAIT_FAIL.
  //   6a. shell#39 (R90-XREPO.013.M2-001): exec_reconcile_publish
  //       with the child's reconciled cap-set count. PARENT-BRANCH
  //       ONLY. Today count == child_decl_count from step (2) (0
  //       under placeholder inputs); publish slot is _ex_reconciled_
  //       caps_count and the boot-visible fingerprint is `SHELL
  //       RECONCILE n=<c>\n`. Non-zero return -> close audit with
  //       exit=127 + EX_ERR_RECONCILE_FAIL (reserved for the future
  //       real sys_exec_reconcile_caps syscall landing; unreachable
  //       today). See §DEFERRALS for the syscall wire-in follow-up.
  //   7. command_record_close with (wstatus & 0xFF) as exit_code.
  //      PARENT-BRANCH ONLY. Bump SH_ST_EXITS (slot 3). Return
  //      exit_code in rax.
  //
  // Bumps SH_ST_SPAWNS on entry, SH_ST_EXITS on the happy tail, and
  // SH_ST_ERRORS on every reject path (either directly or via a
  // downstream helper's own bump). The child branch performs no
  // shell_note bumps (they would mutate only the child's copy of
  // _shell_stats; a future observability landing could sys_write
  // a tagged bump to a parent-visible channel, but shell#44 keeps
  // scope tight and leaves per-child accounting to sys_wait4's
  // wstatus surface).
  //
  // Register plan:
  //   r12 = argv_pool_ptr (callee-save; carried into command_record_begin
  //         as argv text ptr)
  //   r13 = argv_bytes    (callee-save; carried into command_record_begin
  //         as argv_bytes)
  //   r14 = argc          (callee-save; carried into build_argv_ptrs)
  //   r15 = exit code / temp; carries wstatus low byte on the parent
  //         happy tail so command_record_close and the return see the
  //         same value across the shell_note SH_ST_EXITS bump
  //   rbx = shell#44: child pid on the parent branch of sys_fork,
  //         carried across the fingerprint writes into sys_wait4 as
  //         the reaped-pid arg. Also (pre-shell#44) reserved for the
  //         audit-close "reason exit code" 127 constant when routing
  //         execve/wait fail through the close call; that use is now
  //         inline (mov rcx, 127) so rbx is free for the pid.
  //   r11 = .bss LEA scratch (per paideia-as convention)
  //
  // Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) + `sub
  // rsp, 8` = 48 bytes. Entry rsp % 16 == 8; after 5 pushes rsp %
  // 16 == 0; `sub rsp, 8` preserves that. rsp % 16 == 0 at every
  // nested SysV call. Matched epilogue at every PARENT return; the
  // CHILD branch never reaches an epilogue (sys_exit on execve
  // failure; kernel replaces image on execve success).
  //
  // Effect / capability set: {mem, sysreg} + @{sched, mem, fs} covers
  // the union of every downstream call. sys_execve contributes
  // @{sched, mem}; sys_fork contributes the same; command_record_begin
  // contributes !{mem}; the pool byte reads contribute !{mem}. fs is
  // included for kernel-side filesystem walk during sys_execve's ELF
  // load. history_format_u64_dec (used for the fingerprint pid render)
  // contributes only !{mem} (leaf helper, no syscall) -- already
  // subsumed by the mem effect.
  // ==========================================================================
  pub let exec_spawn_and_wait : (u64, u64, u64) -> u64 !{mem, sysreg} @{sched, mem, fs} =
    fn (argv_pool_ptr: u64) (argv_bytes: u64) (argc: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem, fs},
      justification: "shell.ENH-005 (#32) + shell#44 (fork-before-exec): the exec-path REAL body. shell#44 retires the ENH-005 §FORK GAP by inserting sys_fork between command_record_begin and sys_execve. Sequence: (0) gate + SH_ST_SPAWNS bump; (1) exec_build_argv_ptrs into _ex_argv_ptrs from the parser's NUL-separated pool slice; (2) exec_narrow_child_caps into _ex_sidecar_buf with a placeholder parent cap (SH_KIND_SHELL_SESSION with RIGHTS_ALL, target_ptr=0) and child_decl_count=0; (3) cap_manifest_verify DEFERRED (libpdx-cap not linked); (4) command_record_begin into _ex_audit_rec BEFORE fork (D3 audit-first as a running-system property: the audit record exists in the parent's aspace before the child even exists as a task). A non-zero begin routes to EX_ERR_AUDIT_BEGIN_FAIL WITHOUT proceeding to fork -- the child never runs if the audit record cannot be opened. (4a) sys_fork with three arms: rax<0 (signed jl) -> parent-only fork_fail close+return EX_ERR_FORK_FAIL; rax==0 -> child branch falls through to (5) sys_execve; rax>0 -> parent branch stashes pid in rbx, emits SHELL FORK OK fingerprint via three sys_write(1) calls (ex_fp_fork_ok_str+18 bytes, history_format_u64_dec pid rendering into _ex_fp_pid_scratch then sys_write(1, scratch, digit_count), ex_fp_nl_str+1 byte), then jumps to (6) sys_wait4(child_pid). (5) sys_execve with argv[0] as path, _ex_argv_ptrs as argv, envp=0 (D5). CHILD-BRANCH ONLY. Success never returns (kernel replaces image); failure returns errno and the child sys_exit(127) so the parent's wait4 sees exit code 127 (POSIX 'command not found' convention). Child does NOT touch the audit record or restore the callee-save prologue -- the aspace is a cow-copy that dies with sys_exit / execve. (6) sys_wait4(pid=child_pid, &_ex_wstatus, 0, 0) is now genuinely reachable on the parent timeline; on negative errno (signed jl) close audit with exit=127 and return EX_ERR_WAIT_FAIL. (7) command_record_close with (wstatus & 0xFF) as exit_code; the parent bumps SH_ST_EXITS and returns exit_code. Reject-path close discipline: every parent path that reached command_record_begin AND then failed (fork_fail, wait_fail) calls command_record_close(exit=127) before returning the EX_ERR_* code -- otherwise the audit trail would show OPEN records with no matching CLOSE, defeating replay. The paideia-as no-`test`-mnemonic + `cmp reg, 0` discipline is followed at every branch; large immediates (placeholder parent-cap fused qword 0xFFFFFFFF01940001; error sentinels 0xFFFFEC2x) via mov r64, imm64 or mov r32, imm32 (paideia-as supports MOV imm64 in general; the pitfall is `and r11, imm64` which we do not use here). Byte loads via `xor rax, rax; mov_b rax, [ptr]` with explicit `* 1` scale per #1248 + U1606. The `wstatus & 0xFF` extraction uses `and rax, 0xFF` (imm32 <= 0x7FFFFFFF). rbx is repurposed at shell#44 as the child-pid carrier on the parent branch (previously reserved as a scratch that was never actually used in the ENH-005 body). 5 callee-save pushes (rbx, r12, r13, r14, r15) = 40 bytes prologue; no extra `sub rsp` because 5 pushes alone give rsp % 16 == 0 (entry rsp%16==8 after the CALL). Prior version had `sub rsp, 8` which was arithmetically WRONG — it moved rsp%16 to 8, misaligning every nested SysV call. Debugger caught it 2026-09-08; fix retroactive. Every nested syscall / library call in the parent path (shell_note, exec_build_argv_ptrs, exec_narrow_child_caps, command_record_begin, sys_fork, sys_write, history_format_u64_dec, sys_wait4, command_record_close) preserves r12/r13/r14/rbx per SysV callee-save rules. The child branch's sys_execve / sys_exit run against the same alignment (rsp % 16 == 0). Labels prefixed ex_sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // Prologue: 5 pushes = 40B; entry rsp%16==8 -> after 5 pushes rsp%16==0.
        // No extra sub rsp needed (no local stack slots used). Prior code
        // had `sub rsp, 8` which mis-aligned every nested call to rsp%16==8
        // — a live SSE-alignment landmine on the fork/exec path.
        // Debugger caught 2026-09-08; retroactively fixed post shell#44.

        mov r12, rdi;                        // argv_pool_ptr
        mov r13, rsi;                        // argv_bytes
        mov r14, rdx;                        // argc

        // (0) Bump SH_ST_SPAWNS unconditionally.
        mov rdi, 2;                          // SH_ST_SPAWNS
        call shell_note;

        // (0) Gate: pool != 0.
        cmp r12, 0;
        je  ex_sw_bad_argv;
        // (0) Gate: argv_bytes > 0.
        cmp r13, 0;
        je  ex_sw_bad_argv;
        // (0) Gate: argc > 0.
        cmp r14, 0;
        je  ex_sw_bad_argv;

        // (1) Build argv[] ptr array into _ex_argv_ptrs.
        mov rdi, r12;                        // pool_ptr
        mov rsi, r13;                        // argv_bytes
        mov rdx, r14;                        // argc
        lea rcx, [rip + _ex_argv_ptrs];
        mov r8, 16;                          // EX_ARGV_PTRS_MAX
        call exec_build_argv_ptrs;
        cmp rax, 0;
        jne ex_sw_argv_propagate;

        // (1) Sanity: argv[0] must be non-null (build never writes a
        // null there for argc >= 1, but guard against a corrupted
        // helper contract).
        lea r11, [rip + _ex_argv_ptrs];
        mov rax, [r11 + 0];
        cmp rax, 0;
        je  ex_sw_bad_argv;

        // (2) Materialise the placeholder parent-cap set into
        // _ex_parent_caps. One Cap wire record (16 bytes):
        //   qword0 = slot | (kind << 16) | (rights << 32)
        //          = 1    | (0x194 << 16) | (0xFFFFFFFF << 32)
        //          = 0xFFFFFFFF_01940001
        //   qword1 = target_ptr = 0 (kernel resolves the real session
        //                            endpoint at sidecar-materialiser
        //                            time; see §DEFERRALS)
        lea r11, [rip + _ex_parent_caps];
        mov rax, 0xFFFFFFFF01940001;
        mov [r11 + 0], rax;
        xor rax, rax;
        mov [r11 + 8], rax;

        // (2) Call exec_narrow_child_caps.
        //   parent           = _ex_parent_caps
        //   parent_count     = 1
        //   child_decl       = _ex_child_decl (non-NULL base; content
        //                       unused because child_decl_count=0)
        //   child_decl_count = 0
        //   dst              = _ex_sidecar_buf
        //   dst_max_entries  = 16
        lea rdi, [rip + _ex_parent_caps];
        mov rsi, 1;
        lea rdx, [rip + _ex_child_decl];
        mov rcx, 0;
        lea r8,  [rip + _ex_sidecar_buf];
        mov r9,  16;                         // EX_NARROW_MAX_ENTRIES
        call exec_narrow_child_caps;
        cmp rax, 0;
        jne ex_sw_narrow_propagate;

        // (3) cap_manifest_verify -- DEFERRED (libpdx-cap not linked).

        // (4) command_record_begin -- audit-first, durable BEFORE fork.
        //   dst          = _ex_audit_rec
        //   dst_len      = EX_AUDIT_BUF_SIZE (4160)
        //   argv_ptr     = argv_pool_ptr (r12, the parser's pool slice)
        //   argv_bytes   = r13
        //   audit_id     = 1 (placeholder; libpdx-audit issues real ids)
        //   ts_begin_ns  = 0 (placeholder; sys_clock_monotonic wires here)
        lea rdi, [rip + _ex_audit_rec];
        mov rsi, 4160;                       // EX_AUDIT_BUF_SIZE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  1;                          // audit_id placeholder
        xor r9,  r9;                         // ts_begin_ns placeholder
        call command_record_begin;
        cmp rax, 0;
        jne ex_sw_audit_begin_fail;

        // (4a) sys_fork -- shell#44. Splits parent + child before
        // execve. See §"FORK: LIVE" at the top of this file for why
        // this call must sit AFTER command_record_begin (D3 audit-
        // first: the audit record exists in the parent's aspace
        // before the child even schedules).
        //
        // Return arms:
        //   rax < 0 (signed): fork failed. Parent-only. Close audit
        //                     (exit=127) + return EX_ERR_FORK_FAIL.
        //   rax == 0:         CHILD. Fall through to (5) sys_execve.
        //   rax > 0:          PARENT. rax = child pid. Stash in rbx,
        //                     emit fingerprint, jump to (6) wait4.
        call sys_fork;
        cmp rax, 0;
        jl  ex_sw_fork_fail;
        je  ex_sw_child_exec;

        // (4a-parent) rax > 0 -- we are the parent with child pid.
        mov rbx, rax;                        // rbx = child_pid (survives sys_write)

        // Fingerprint (1): sys_write(1, "SHELL FORK OK pid=", 18).
        mov rdi, 1;                          // stdout
        lea rsi, [rip + ex_fp_fork_ok_str];
        mov rdx, 18;                         // EX_FP_FORK_OK_LEN
        call sys_write;
        // Ignore return; a short write here is a boot-log oddity,
        // not a spawn failure.

        // Fingerprint (2): render decimal pid into _ex_fp_pid_scratch
        // and sys_write the resulting digit count.
        //   history_format_u64_dec(value=rbx, out_buf=_ex_fp_pid_scratch)
        //   -> rax = digit count (1..20)
        mov rdi, rbx;                        // value = child_pid
        lea rsi, [rip + _ex_fp_pid_scratch]; // out_buf
        call history_format_u64_dec;

        // sys_write(1, _ex_fp_pid_scratch, digit_count)
        mov rdx, rax;                        // count = digit_count
        mov rdi, 1;
        lea rsi, [rip + _ex_fp_pid_scratch];
        call sys_write;

        // Fingerprint (3): sys_write(1, "\n", 1).
        mov rdi, 1;
        lea rsi, [rip + ex_fp_nl_str];
        mov rdx, 1;
        call sys_write;

        // Fall through to sys_wait4 on the parent's timeline.
        jmp ex_sw_wait_head;

      ex_sw_child_exec:
        // (5) CHILD branch: sys_execve(path=argv[0], argv=_ex_argv_ptrs,
        // envp=NULL). Success replaces this task's image with the
        // child's; the kernel loads _start and control never returns
        // to this body. Failure returns a negative errno; the child
        // sys_exit(127) so the parent's wait4 sees exit code 127.
        //
        // The child does NOT touch the audit record: its aspace is
        // a cow-copy of the parent's; a close here would mutate only
        // the child's copy of _ex_audit_rec, and the child image is
        // about to be discarded (either replaced by execve or torn
        // down by sys_exit). The child ALSO does NOT restore the
        // 5-callee-save prologue: sys_exit never returns and neither
        // does a successful execve; the stack dies with the aspace.
        lea r11, [rip + _ex_argv_ptrs];
        mov rdi, [r11 + 0];                  // path = argv[0]
        lea rsi, [rip + _ex_argv_ptrs];      // argv
        xor rdx, rdx;                        // envp = NULL (D5)
        call sys_execve;
        // execve returned -> failure. Signal via exit code 127 so
        // the parent's wait4 surfaces it naturally.
        mov rdi, 127;
        call sys_exit;
        // sys_exit does not return; hlt is unreachable belt-and-
        // suspenders in case the kernel ever regresses the exit
        // handler (same discipline as init.pdx's tail-of-_start).
        hlt;

      ex_sw_wait_head:
        // (6) PARENT branch: sys_wait4(pid=child_pid, &_ex_wstatus,
        // 0, 0). rbx carries the child pid from (4a-parent). Wait
        // on the specific pid (not -1) so a future concurrent-
        // pipeline landing observes narrow reap semantics without
        // re-architecting this body.
        mov rdi, rbx;                        // pid = child_pid
        lea rsi, [rip + _ex_wstatus];
        xor rdx, rdx;                        // options = 0
        xor rcx, rcx;                        // rusage = NULL
        call sys_wait4;
        cmp rax, 0;
        jl  ex_sw_wait_fail;

        // (7) Extract exit code from wstatus low byte.
        lea r11, [rip + _ex_wstatus];
        mov rax, [r11];
        and rax, 0xFF;
        mov r15, rax;                        // r15 = exit_code

        // (6a) shell#39 (R90-XREPO.013.M2-001): publish the child's
        // reconciled cap-set count. Today the count == child_decl_
        // count from step (2) (0 under the ENH-005 placeholder
        // inputs); when the real sys_exec_reconcile_caps syscall
        // lands, exec_reconcile_publish substitutes a kernel-
        // reported count without changing this call site.
        //
        // Non-zero return -> EX_ERR_RECONCILE_FAIL after an exit=127
        // audit close (same discipline as EX_ERR_WAIT_FAIL). Success
        // preserves r15 (the child's exit_code) across the publish
        // call: exec_reconcile_publish is a leaf-shaped SysV callee
        // that preserves r15 per callee-save rules.
        xor rdi, rdi;                        // count = 0 (child_decl_count today)
        call exec_reconcile_publish;
        cmp rax, 0;
        jne ex_sw_reconcile_fail;

        // (7) command_record_close(exit_code).
        lea rdi, [rip + _ex_audit_rec];
        mov rsi, 4160;
        xor rdx, rdx;                        // ts_end_ns placeholder
        mov rcx, r15;
        call command_record_close;

        // Bump SH_ST_EXITS.
        mov rdi, 3;                          // SH_ST_EXITS
        call shell_note;

        // Return exit code.
        mov rax, r15;
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_fork_fail:
        // (4a) sys_fork returned a negative errno. Parent-side only.
        // Close audit with exit=127 (fork failed before child image
        // loaded; POSIX has no dedicated exit code for "fork EAGAIN",
        // 127 is the closest generic "spawn refused" surface).
        lea rdi, [rip + _ex_audit_rec];
        mov rsi, 4160;
        xor rdx, rdx;
        mov rcx, 127;
        call command_record_close;
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFEC29;                 // EX_ERR_FORK_FAIL
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_wait_fail:
        // Close audit with exit=127 so the OPEN record does not leak.
        lea rdi, [rip + _ex_audit_rec];
        mov rsi, 4160;
        xor rdx, rdx;
        mov rcx, 127;
        call command_record_close;
        mov rdi, 4;
        call shell_note;
        mov rax, 0xFFFFEC23;                 // EX_ERR_WAIT_FAIL
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_reconcile_fail:
        // shell#39: exec_reconcile_publish returned non-zero. Today
        // the stub cannot fail; this arm is reserved for the future
        // sys_exec_reconcile_caps landing when the syscall can
        // genuinely refuse (kernel OOM on the reconciled-set copy,
        // or a mandatory-cap-missing sentinel promoted to the shell
        // surface). Close audit with exit=127 so the OPEN record
        // does not leak (same discipline as ex_sw_wait_fail).
        lea rdi, [rip + _ex_audit_rec];
        mov rsi, 4160;
        xor rdx, rdx;
        mov rcx, 127;
        call command_record_close;
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFEC2A;                 // EX_ERR_RECONCILE_FAIL
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_audit_begin_fail:
        // audit begin failed BEFORE exec -- D3 says do not proceed.
        // No close (the record was never opened durably).
        mov rdi, 4;
        call shell_note;
        mov rax, 0xFFFFEC28;                 // EX_ERR_AUDIT_BEGIN_FAIL
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_narrow_propagate:
        // exec_narrow_child_caps already bumped SH_ST_ERRORS.
        // Return its sentinel verbatim (EX_ERR_MISSING_CAP /
        // EX_ERR_WIDENING / EX_ERR_SIDECAR_FULL / EX_ERR_BAD_ARGV).
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_argv_propagate:
        // exec_build_argv_ptrs did NOT bump SH_ST_ERRORS (leaf helper).
        // rax holds the helper's sentinel (0xFFFFEC21 EX_ERR_BAD_ARGV
        // or 0xFFFFEC27 EX_ERR_ARGV_OVERFLOW) which shell_note would
        // clobber (SysV caller-save), so stash it in r15 (a
        // callee-save the shell_note call preserves) before the bump
        // and restore it into rax immediately after.
        mov r15, rax;
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, r15;
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret;

      ex_sw_bad_argv:
        mov rdi, 4;                          // SH_ST_ERRORS
        call shell_note;
        mov rax, 0xFFFFEC21;                 // EX_ERR_BAD_ARGV
        // (add rsp, 8 removed with sub rsp, 8 above — no stack slots in use)
        pop r15; pop r14; pop r13; pop r12; pop rbx;
        ret
      }
    }
}
