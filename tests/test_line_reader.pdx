// tests/test_line_reader.pdx -- shell.ENH-007 (paideia-os/shell#34) + R66.M1-001 (paideia-os/shell#17)
//
// TestLineReader module: fingerprint for the LineReader input gates
// + the R66.M1-001 CSI final-byte lookup + the raw/cooked deferral
// sentinel.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Offline input-gate cases for `LineReader::line_reader_read_line`
// (from ENH-007):
//
//   tlr_case_bad_buf_null      -- buf == 0 -> LR_ERR_BAD_BUF
//   tlr_case_bad_buf_len_zero  -- buf_len == 0 -> LR_ERR_BAD_BUF
//
// Offline CSI-final-byte lookup cases for `LineReader::lr_csi_final_
// to_key` (from R66.M1-001 / #17). This is a pure function -- no
// syscall, no tty -- so every case runs entirely under the encoder-
// half fingerprint discipline:
//
//   tlr_case_csi_a_up          -- 'A' (0x41) -> LR_KEY_UP
//   tlr_case_csi_b_down        -- 'B' (0x42) -> LR_KEY_DOWN
//   tlr_case_csi_c_right       -- 'C' (0x43) -> LR_KEY_RIGHT
//   tlr_case_csi_d_left        -- 'D' (0x44) -> LR_KEY_LEFT
//   tlr_case_csi_z_unknown     -- 'Z' (0x5A) -> LR_KEY_UNKNOWN
//
// Offline raw/cooked deferral cases for `lr_tty_set_raw` /
// `lr_tty_set_cooked` (from R66.M1-001 / #17). Today both helpers
// return LR_ERR_TTY_UNBOUND (0xFFFFEC12) because the KIND_TTY cap
// seat is not reachable from the shell task (design/architecture.md
// §3.3 items 3a, 3b). Pinning the deferral sentinel in a test
// catches an accidental substrate flip that lands the runtime body
// without also landing the KIND_TTY cap seat -- the sentinel would
// change and this test would flag it before an operator sees a
// stuck-in-raw-mode tty at reboot:
//
//   tlr_case_set_raw_deferred    -- lr_tty_set_raw   -> LR_ERR_TTY_UNBOUND
//   tlr_case_set_cooked_deferred -- lr_tty_set_cooked -> LR_ERR_TTY_UNBOUND
//
// All cases compile-clean and pass on any paideia-as build without
// needing a live kernel.
//
// =============================================================================
// WHAT THIS MODULE DOES NOT EXERCISE
// =============================================================================
//
// The runtime read-loop matrix -- newline-terminated line, EOF-at-
// start, buffer-full-without-newline, mid-stream EOF, unrecoverable
// read error -- is documented as a live-kernel deferral. Reason:
// exercising the sys_read loop requires either
//
//   (a) a test-only mock-shim mechanism that redirects `lr_read_one_
//       byte` to return canned bytes from a fixture buffer, or
//   (b) a live kernel with a scripted stdin byte source.
//
// (a) is out of reach because paideia-as does not carry conditional
// compilation; a mock-inject function-pointer indirection would add
// runtime cost to every real read (the shell's hot path is a byte-at-
// a-time syscall loop where an extra indirection is measurable). The
// single-seam design at ENH-007 is intended for the eventual cap-typed
// KIND_TTY(read) migration (see design/architecture.md §3.3, refreshed
// at #46), not for test-mock injection.
//
// (b) is the same deferral test_syscall_floor.pdx uses for its
// `sys_getcwd` + `sys_write` runtime cases: build against a live
// kernel invocation and let the boot-time smoke harness drive the
// full matrix once the shell satellite is wired into paideia-os as
// a submodule. Runtime read tests here would follow the same shape
// and are tracked as a follow-on when that wiring lands.
//
// The full-FSM walk (`lr_read_key`'s state transitions across
// multi-byte ESC [ A sequences) is likewise a live-kernel deferral --
// exercising it requires the same byte-source mock as the read loop.
// The pure lookup `lr_csi_final_to_key` covers the classification
// half of the FSM offline; the state-machine driving of it is what
// the boot smoke will cover once wired.
//
// =============================================================================
// FAIL-CODE BAND 0xFFFFED9x
// =============================================================================
//
//   0            TLR_PASS                       every case passed
//   0xFFFFED90   TLR_FAIL_BAD_BUF_NULL          buf==0 did not return LR_ERR_BAD_BUF
//   0xFFFFED91   TLR_FAIL_BAD_BUF_LEN_ZERO      buf_len==0 did not return LR_ERR_BAD_BUF
//   0xFFFFED92   TLR_FAIL_CSI_A_UP              'A' did not return LR_KEY_UP
//   0xFFFFED93   TLR_FAIL_CSI_B_DOWN            'B' did not return LR_KEY_DOWN
//   0xFFFFED94   TLR_FAIL_CSI_C_RIGHT           'C' did not return LR_KEY_RIGHT
//   0xFFFFED95   TLR_FAIL_CSI_D_LEFT            'D' did not return LR_KEY_LEFT
//   0xFFFFED96   TLR_FAIL_CSI_Z_UNKNOWN         'Z' did not return LR_KEY_UNKNOWN
//   0xFFFFED97   TLR_FAIL_SET_RAW_DEFERRED      lr_tty_set_raw did not return LR_ERR_TTY_UNBOUND
//   0xFFFFED98   TLR_FAIL_SET_COOKED_DEFERRED   lr_tty_set_cooked did not return LR_ERR_TTY_UNBOUND
//
// The 0xFFFFED9x band extends the family:
//   0xFFFFED0x TestCapsNarrow      0xFFFFED5x TestLexer
//   0xFFFFED1x TestAuditFirst      0xFFFFED6x TestParser
//   0xFFFFED2x TestSmokeMatrix     0xFFFFED7x TestBuiltins
//   0xFFFFED3x TestReleaseManifest 0xFFFFED8x TestShellMain
//   0xFFFFED4x TestSyscallFloor    0xFFFFED9x TestLineReader  <-- this module
//
// so an operator reading a boot-time smoke log can distinguish which
// test module refused the invariant by the high two bytes of the
// return.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`TestLineReader`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF; large-imm sentinel
//     compares stage via `mov r11, imm64; cmp rax, r11`.
//   - r11 scratch for the large-imm sentinel compares (LR_ERR_BAD_BUF,
//     LR_KEY_*, LR_ERR_TTY_UNBOUND).
//   - No byte reads in this driver; the gate checks return sentinels
//     the driver compares as qwords.
//   - Each case: `sub rsp, 8` prologue (no callee-save pushes; the
//     args and return value ride through the caller-save registers).
//     Entry rsp%16==8 (return addr from parent's call); sub 8 gives
//     rsp%16==0 for the nested call. Matched `add rsp, 8` at every
//     return.

module TestLineReader = structure {

  // ==========================================================================
  // Fail codes (0xFFFFED9x band)
  // ==========================================================================
  pub let TLR_PASS                       : u64 = 0
  pub let TLR_FAIL_BAD_BUF_NULL          : u64 = 0xFFFFED90
  pub let TLR_FAIL_BAD_BUF_LEN_ZERO      : u64 = 0xFFFFED91
  pub let TLR_FAIL_CSI_A_UP              : u64 = 0xFFFFED92
  pub let TLR_FAIL_CSI_B_DOWN            : u64 = 0xFFFFED93
  pub let TLR_FAIL_CSI_C_RIGHT           : u64 = 0xFFFFED94
  pub let TLR_FAIL_CSI_D_LEFT            : u64 = 0xFFFFED95
  pub let TLR_FAIL_CSI_Z_UNKNOWN         : u64 = 0xFFFFED96
  pub let TLR_FAIL_SET_RAW_DEFERRED      : u64 = 0xFFFFED97
  pub let TLR_FAIL_SET_COOKED_DEFERRED   : u64 = 0xFFFFED98

  // ==========================================================================
  // Fixture (.bss)
  //
  // _tlr_scratch -- 32 qwords = 256 bytes; a plausibly-sized line
  // buffer that gets passed as a non-null buf on the buf_len==0 gate
  // case. Never actually written on any offline path (both gate cases
  // return before the read loop). Aligned @16 to match the alignment
  // discipline the shell's own _sm_line_buf uses.
  // ==========================================================================
  pub let mut _tlr_scratch : [u64; 32] = uninit @align(16)

  // ==========================================================================
  // tlr_case_bad_buf_null() -> u64
  //
  // Invoke line_reader_read_line(0, 256) and assert the return is
  // LR_ERR_BAD_BUF (0xFFFFEC11). Any other return is a gate regression.
  //
  // Prologue: `sub rsp, 8` aligns rsp%16==0 for the nested SysV call.
  // No callee-save pushes -- rax/rdi/rsi/r11 are all caller-save.
  // ==========================================================================
  pub let tlr_case_bad_buf_null : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-007 (#34) offline gate case A: line_reader_read_line(0, 256) must return LR_ERR_BAD_BUF -- the fast-fail gate rejects a null buf BEFORE any sys_read issues. Effect/cap set matches the SUT's own {mem, sysreg} @{fs} (the SUT declares them because a real read path exists; this case does not reach the read but the type-level effect set is a compile-time property of the callee's signature). Large-imm sentinel compare against LR_ERR_BAD_BUF (0xFFFFEC11) stages via `mov r11, imm64; cmp rax, r11` per paideia-as imm32 discipline. Prologue: `sub rsp, 8` aligns rsp%16==0 for the nested SysV call (entry rsp%16==8 from parent's return addr). Labels prefixed tlr_bbn_.",
      block: {
        sub rsp, 8;                          // align rsp % 16

        xor rdi, rdi;                        // buf = 0 (NULL)
        mov rsi, 256;                        // buf_len = 256
        call line_reader_read_line;
        // rax = LR_ERR_BAD_BUF on the gate reject.

        // Assert rax == 0xFFFFEC11 via r11 staging.
        mov r11, 0xFFFFEC11;                 // LR_ERR_BAD_BUF
        cmp rax, r11;
        jne tlr_bbn_fail;

        xor rax, rax;                        // TLR_PASS
        add rsp, 8;
        ret;

      tlr_bbn_fail:
        mov rax, 0xFFFFED90;                 // TLR_FAIL_BAD_BUF_NULL
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_bad_buf_len_zero() -> u64
  //
  // Invoke line_reader_read_line(&_tlr_scratch, 0) and assert the
  // return is LR_ERR_BAD_BUF. Non-null buf with zero cap must still
  // fail-fast BEFORE the read loop.
  // ==========================================================================
  pub let tlr_case_bad_buf_len_zero : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-007 (#34) offline gate case B: line_reader_read_line(&_tlr_scratch, 0) must return LR_ERR_BAD_BUF -- a non-null buffer with zero capacity is still refused before any sys_read issues. Effect/cap set matches the SUT. Large-imm sentinel compare against LR_ERR_BAD_BUF stages via `mov r11, imm64; cmp rax, r11`. Prologue: `sub rsp, 8` aligns rsp%16==0 for the nested SysV call. Labels prefixed tlr_bbz_.",
      block: {
        sub rsp, 8;                          // align rsp % 16

        lea rdi, [rip + _tlr_scratch];       // buf = valid pointer
        xor rsi, rsi;                        // buf_len = 0
        call line_reader_read_line;
        // rax = LR_ERR_BAD_BUF on the gate reject.

        mov r11, 0xFFFFEC11;                 // LR_ERR_BAD_BUF
        cmp rax, r11;
        jne tlr_bbz_fail;

        xor rax, rax;                        // TLR_PASS
        add rsp, 8;
        ret;

      tlr_bbz_fail:
        mov rax, 0xFFFFED91;                 // TLR_FAIL_BAD_BUF_LEN_ZERO
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_csi_a_up() -> u64  (R66.M1-001 / #17)
  //
  // Invoke lr_csi_final_to_key(0x41) and assert the return is
  // LR_KEY_UP (0xFFFFEC50). The offline classifier half of the CSI
  // FSM at #17.
  // ==========================================================================
  pub let tlr_case_csi_a_up : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) offline CSI lookup case A: lr_csi_final_to_key(0x41 'A') must return LR_KEY_UP (0xFFFFEC50). The pure lookup half of the CSI FSM is exercisable without a live tty; this case pins the ECMA-48 A->UP mapping. Large-imm sentinel compare stages via `mov r11, imm64; cmp rax, r11`. Prologue: `sub rsp, 8` aligns rsp%16==0 for the nested call. Labels prefixed tlr_cau_.",
      block: {
        sub rsp, 8;

        mov rdi, 0x41;                       // 'A'
        call lr_csi_final_to_key;

        mov r11, 0xFFFFEC50;                 // LR_KEY_UP
        cmp rax, r11;
        jne tlr_cau_fail;

        xor rax, rax;                        // TLR_PASS
        add rsp, 8;
        ret;

      tlr_cau_fail:
        mov rax, 0xFFFFED92;                 // TLR_FAIL_CSI_A_UP
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_csi_b_down() -> u64
  // ==========================================================================
  pub let tlr_case_csi_b_down : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) offline CSI lookup case B: lr_csi_final_to_key(0x42 'B') must return LR_KEY_DOWN (0xFFFFEC51). Prologue: `sub rsp, 8`. Labels prefixed tlr_cbd_.",
      block: {
        sub rsp, 8;

        mov rdi, 0x42;                       // 'B'
        call lr_csi_final_to_key;

        mov r11, 0xFFFFEC51;                 // LR_KEY_DOWN
        cmp rax, r11;
        jne tlr_cbd_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_cbd_fail:
        mov rax, 0xFFFFED93;                 // TLR_FAIL_CSI_B_DOWN
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_csi_c_right() -> u64
  // ==========================================================================
  pub let tlr_case_csi_c_right : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) offline CSI lookup case C: lr_csi_final_to_key(0x43 'C') must return LR_KEY_RIGHT (0xFFFFEC53). Prologue: `sub rsp, 8`. Labels prefixed tlr_ccr_.",
      block: {
        sub rsp, 8;

        mov rdi, 0x43;                       // 'C'
        call lr_csi_final_to_key;

        mov r11, 0xFFFFEC53;                 // LR_KEY_RIGHT
        cmp rax, r11;
        jne tlr_ccr_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_ccr_fail:
        mov rax, 0xFFFFED94;                 // TLR_FAIL_CSI_C_RIGHT
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_csi_d_left() -> u64
  // ==========================================================================
  pub let tlr_case_csi_d_left : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) offline CSI lookup case D: lr_csi_final_to_key(0x44 'D') must return LR_KEY_LEFT (0xFFFFEC52). Prologue: `sub rsp, 8`. Labels prefixed tlr_cdl_.",
      block: {
        sub rsp, 8;

        mov rdi, 0x44;                       // 'D'
        call lr_csi_final_to_key;

        mov r11, 0xFFFFEC52;                 // LR_KEY_LEFT
        cmp rax, r11;
        jne tlr_cdl_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_cdl_fail:
        mov rax, 0xFFFFED95;                 // TLR_FAIL_CSI_D_LEFT
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_csi_z_unknown() -> u64
  //
  // 'Z' is not one of the four recognised arrow finals -- the lookup
  // must fall through to LR_KEY_UNKNOWN. Also covers the extension
  // contract: adding F1-F12 or Home/End later must not accidentally
  // start returning something other than UNKNOWN for a byte the new
  // case does not name.
  // ==========================================================================
  pub let tlr_case_csi_z_unknown : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) offline CSI lookup case Z: lr_csi_final_to_key(0x5A 'Z') must return LR_KEY_UNKNOWN (0xFFFFEC55). Pins the fall-through contract; adding new finals later must not accidentally start returning something other than UNKNOWN for an unnamed byte. Prologue: `sub rsp, 8`. Labels prefixed tlr_czu_.",
      block: {
        sub rsp, 8;

        mov rdi, 0x5A;                       // 'Z'
        call lr_csi_final_to_key;

        mov r11, 0xFFFFEC55;                 // LR_KEY_UNKNOWN
        cmp rax, r11;
        jne tlr_czu_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_czu_fail:
        mov rax, 0xFFFFED96;                 // TLR_FAIL_CSI_Z_UNKNOWN
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_set_raw_deferred() -> u64  (R66.M1-001 / #17)
  //
  // Pin the raw-mode deferral: today lr_tty_set_raw returns
  // LR_ERR_TTY_UNBOUND (0xFFFFEC12) because the KIND_TTY cap seat is
  // not reachable. A substrate flip that lands the runtime body
  // without also landing the cap seat would silently break the raw-
  // mode contract; this case catches that at build fingerprint time.
  // ==========================================================================
  pub let tlr_case_set_raw_deferred : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) deferral pin: lr_tty_set_raw must return LR_ERR_TTY_UNBOUND (0xFFFFEC12) today because the KIND_TTY cap seat is not provisioned (design/architecture.md §3.3). When the substrate lands, this sentinel changes and the case fires -- flagging that the runtime toggle went live and shell_main must now call the toggles at startup / teardown to keep the tty out of a stuck raw state on Ctrl-C. Prologue: `sub rsp, 8`. Labels prefixed tlr_srd_.",
      block: {
        sub rsp, 8;

        call lr_tty_set_raw;

        mov r11, 0xFFFFEC12;                 // LR_ERR_TTY_UNBOUND
        cmp rax, r11;
        jne tlr_srd_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_srd_fail:
        mov rax, 0xFFFFED97;                 // TLR_FAIL_SET_RAW_DEFERRED
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_case_set_cooked_deferred() -> u64  (R66.M1-001 / #17)
  // ==========================================================================
  pub let tlr_case_set_cooked_deferred : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "shell.R66.M1-001 (#17) deferral pin: lr_tty_set_cooked must return LR_ERR_TTY_UNBOUND (0xFFFFEC12) today; same deferral rationale as tlr_case_set_raw_deferred. Prologue: `sub rsp, 8`. Labels prefixed tlr_scd_.",
      block: {
        sub rsp, 8;

        call lr_tty_set_cooked;

        mov r11, 0xFFFFEC12;                 // LR_ERR_TTY_UNBOUND
        cmp rax, r11;
        jne tlr_scd_fail;

        xor rax, rax;
        add rsp, 8;
        ret;

      tlr_scd_fail:
        mov rax, 0xFFFFED98;                 // TLR_FAIL_SET_COOKED_DEFERRED
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // tlr_run_all() -> u64
  //
  // Umbrella: run every case in order; first non-zero return short-
  // circuits and propagates. Same shape as tcn_run_all / taf_run_all
  // / tsm_run_all / trm_run_all / tsf_run_all / tlx_run_all /
  // tpr_run_all / tbi_run_all / tex_run_all / tshm_run_all.
  // ==========================================================================
  pub let tlr_run_all : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "shell.ENH-007 (#34) + R66.M1-001 (#17) umbrella driver: sequential invocation of every tlr_case_* in the module; short-circuit on first non-zero return. Same shape as every other tXX_run_all in tests/ -- a boot-time smoke harness invokes every umbrella in one loop with a uniform return-code contract. The umbrella keeps the SUT's widest effect/cap set ({mem, sysreg} @{fs}) so the type-level annotation covers every nested call (line_reader_read_line's effects dominate the pure-lookup cases). Prologue: `sub rsp, 8` aligns rsp%16==0 for the nested SysV calls. Labels prefixed tlr_ra_.",
      block: {
        sub rsp, 8;                          // align rsp % 16

        call tlr_case_bad_buf_null;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_bad_buf_len_zero;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_csi_a_up;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_csi_b_down;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_csi_c_right;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_csi_d_left;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_csi_z_unknown;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_set_raw_deferred;
        cmp rax, 0;
        jne tlr_ra_out;

        call tlr_case_set_cooked_deferred;
        cmp rax, 0;
        jne tlr_ra_out;

        xor rax, rax;                        // TLR_PASS
        add rsp, 8;
        ret;

      tlr_ra_out:
        add rsp, 8;
        ret
      }
    }
}
