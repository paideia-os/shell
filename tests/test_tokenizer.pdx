        cmp rax, 1;
        jne ttk_of_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      ttk_of_fail:
        mov rax, 0xFFFFEDBC;                      // TTK_FAIL_OVERFLOW
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ttk_case_bad_args() -> u64
  //
  // Input: line_ptr = 0, line_len = 1 (non-empty, so tk_done_empty is
  // NOT taken). Expected: TOK_ERR_BAD_ARGS (0xFFFFEB01). Exercises the
  // `cmp r12, 0; je tk_bad_args` gate at src/tokenizer.pdx:181-182.
  //
  // The complementary null-tokens-out case (line_ptr valid, len>0,
  // tokens_out_ptr=0, cap>0) is symmetric and would land the same
  // sentinel; folded here into a single case-per-error-flavour to keep
  // the umbrella band at 14 slots (one per error surface + one per
  // happy-path branch).
  // ==========================================================================
  pub let ttk_case_bad_args : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R106.SHELL-003 (paideia-os/shell#42) case bad_args: line_ptr=0 with non-empty len triggers tk_bad_args at src/tokenizer.pdx:181 (the tk_done_empty short-circuit fires only for len==0, so a null pointer with a non-zero length always reaches the guard). Expected sentinel 0xFFFFEB01. Complementary null-tokens-out variant folded in the same band per the module header comment.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        call ttk_reset;

        mov rdi, 0;                               // deliberately null
        mov rsi, 1;
        lea rdx, [rip + _ttk_tokens_out];
        mov rcx, 16;
        call tokenize;

        mov r10, 0xFFFFEB01;                      // TOK_ERR_BAD_ARGS
        cmp rax, r10;
        jne ttk_ba_fail;

        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      ttk_ba_fail:
        mov rax, 0xFFFFEDBD;                      // TTK_FAIL_BAD_ARGS
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ttk_run_all() -> u64
  //
  // Umbrella: run every case in order; first non-zero return short-
  // circuits and propagates. Same shape as tsf_run_all / tlx_run_all
  // so a boot-time smoke harness can invoke it alongside the existing
  // family with a uniform return-code contract.
  //
  // Prologue: `sub rsp, 8` alone -- no callee-save pushes because each
  // case preserves nothing across its own return (rax carries the
  // per-case verdict directly).
  // ==========================================================================
  pub let ttk_run_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R106.SHELL-003 (paideia-os/shell#42) umbrella driver: sequential invocation of the fourteen ttk_case_* entries; propagate the first non-zero verdict. Effect/cap set is the union of every case (identical: {mem} @{} -- the tokenizer is a pure-function encoder over caller-owned buffers, no syscalls, no cap invokes). `sub rsp, 8` prologue keeps rsp%16==0 for the nested call chain. Labels prefixed ttk_ra_. Same shape as tsf_run_all / tlx_run_all so the paideia-os boot-time smoke can drop ttk_run_all into the same driver loop as the other umbrellas.",
      block: {
        sub rsp, 8;

        call ttk_case_empty;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_ws_only;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_bare;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_two_words;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_single_quote;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_double_quote;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_double_escape;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_bare_escape;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_adjacent;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_unterm_single;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_unterm_double;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_invalid_escape;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_overflow;
        cmp rax, 0;
        jne ttk_ra_out;

        call ttk_case_bad_args;
        cmp rax, 0;
        jne ttk_ra_out;

        xor rax, rax;                             // TTK_PASS
        add rsp, 8;
        ret;

      ttk_ra_out:
        // rax already holds the failing case's sentinel.
        add rsp, 8;
        ret
      }
    }
}
