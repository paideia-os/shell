// tests/test_exec_alignment.pdx -- shell#44 retroactive alignment regression test
//
// TestExecAlignment module: witness the SysV `rsp % 16 == 0`
// invariant that shell#19 commit 88580b5 restored on the fork/exec
// path. Retroactive per the debugger note carried in that commit's
// message: `Exec::exec_spawn_and_wait` had 5 callee-save pushes +
// `sub rsp, 8` = 48-byte prologue; entry rsp%16==8, five pushes take
// it back to 0, the stray `sub rsp, 8` moved it to 8. Every nested
// SysV call (shell_note, sys_fork, sys_execve, sys_wait4, sys_write,
// command_record_*, exec_narrow_child_caps, history_format_u64_dec)
// therefore ran with rsp%16==8 -- a silent landmine that would #GP
// the first time any callee used an SSE-aligned load/store
// (`movaps` / `movdqa`) against an [rsp + K] operand.
//
// paideia-as 0.36 does NOT yet emit `movaps` / `movdqa` (only scalar-
// float SSE lands so far -- #1333 shipped movsd/addsd/etc but the
// packed-128 forms and pxor stay deferred; #1004 added VEX.256
// vmovdqu/vpxor/vpcmpeqb/vpmovmskb but those are unaligned or
// register-only). A movaps-based runtime probe is therefore not
// buildable today. This module falls back to the arithmetic
// equivalent -- `mov rax, rsp; and rax, 15; cmp rax, 0` -- inside a
// FIXTURE REPLICA of the exec_spawn_and_wait prologue and inside a
// FIXTURE REPLICA of the pre-fix (buggy) prologue. Both replicas run
// under the same SysV entry convention as the SUT, so the arithmetic
// witness proves the same alignment property a `movaps [rsp], xmm0`
// probe would prove.
//
// =============================================================================
// TEST MATRIX
// =============================================================================
//
//   1  teal_case_replica_current_prologue    Reproduce the POST-88580b5
//                                             prologue (5 callee-save pushes,
//                                             no `sub rsp, 8`); assert that
//                                             at the point where the SUT
//                                             would fire its first nested
//                                             CALL, rsp % 16 == 0. This is
//                                             the executable form of the
//                                             invariant the SUT's
//                                             justification-comment names
//                                             ("rsp % 16 == 0 at every
//                                             nested SysV call").
//
//   2  teal_case_replica_landmine_prologue   Reproduce the PRE-88580b5
//                                             (buggy) prologue -- 5 pushes
//                                             + `sub rsp, 8` -- and assert
//                                             rsp % 16 == 8. This is the
//                                             counter-example half: proves
//                                             the mechanism by which the
//                                             landmine misaligned every
//                                             nested call. If a future
//                                             refactor reintroduces the
//                                             stray `sub rsp, 8` to
//                                             exec_spawn_and_wait AND
//                                             updates this test's replica
//                                             in sync, case 1 flips to a
//                                             FAIL and case 2 flips to a
//                                             PASS -- either flip is a
//                                             review-time alarm on the
//                                             D5 alignment invariant.
//
//   3  teal_case_sut_gate_roundtrip          Round-trip proof against the
//                                             REAL exec_spawn_and_wait via
//                                             its BAD_ARGV gate path
//                                             (argc=0). The SUT rejects
//                                             with EX_ERR_BAD_ARGV (0x
//                                             FFFFEC21) without reaching
//                                             any substrate call; a clean
//                                             return proves the SUT's
//                                             prologue+epilogue push/pop
//                                             balance survives one full
//                                             traversal. Not a strict
//                                             alignment proof (the gate
//                                             fires before any nested
//                                             CALL, so misalignment would
//                                             not #GP on this path today)
//                                             but a low-cost witness that
//                                             the SUT's stack-frame shape
//                                             is at least consistent
//                                             end-to-end.
//
// =============================================================================
// FUTURE ENHANCEMENT (when paideia-as gains movaps/movdqa)
// =============================================================================
//
// When the paideia-as encoder lands packed-SSE emission
// (`Mnemonic::Movaps` + `Mnemonic::Movdqa`, deferred at #1333 --
// scalar-float only), replace the arithmetic `and rax, 15` witness
// in cases 1 and 2 with a leaf `teal_probe_movaps` that executes
// `movaps [rsp], xmm0` against a 16-byte-reserved stack scratch.
// The probe faults with #GP if rsp % 16 != 0 at the CALL site --
// turning the current documentary witness into a hard-fault
// regression. The fixture shape (5 pushes / no sub 8) already
// prepares rsp for such a probe without further changes.
//
// =============================================================================
// FAIL-CODE BAND 0xFFFFEDFx (TestExecAlignment)
// =============================================================================
//
//   Grep audit at landing time
//     (`grep -oE '0xFFFFED[0-9A-Fa-f][0-9A-Fa-f]' tests/*.pdx src/*.pdx | sort -u`)
//   confirms 0xFFFFEDFx is disjoint from every existing band:
//     0xFFFFED0x  TestCapsNarrow
//     0xFFFFED1x  TestAuditFirst
//     0xFFFFED2x  TestSmokeMatrix
//     0xFFFFED3x  TestReleaseManifest
//     0xFFFFED4x  TestSyscallFloor
//     0xFFFFED5x  TestLineReader
//     0xFFFFED6x  TestBuiltins
//     0xFFFFED7x  TestShellMain
//     0xFFFFED8x  TestExec
//     0xFFFFED9x  TestParser
//     0xFFFFEDAx  TestHistory
//     0xFFFFEDBx  TestTokenizer
//     0xFFFFEDCx  TokenizerTilde
//     0xFFFFEDDx  TokenizerBareCd
//     0xFFFFEDEx  DispatchArgvConstruction
//     0xFFFFEDFx  TestExecAlignment                (this file)
//
//   0            TEAL_PASS                 all cases passed
//   0xFFFFEDF0   TEAL_FAIL_CURRENT         case 1: post-fix replica prologue
//                                            left rsp % 16 != 0 (the invariant
//                                            the SUT depends on is broken).
//   0xFFFFEDF1   TEAL_FAIL_LANDMINE        case 2: pre-fix replica prologue
//                                            gave rsp % 16 != 8 (either the
//                                            SysV entry convention changed
//                                            or the replica no longer matches
//                                            the pre-fix shape).
//   0xFFFFEDF2   TEAL_FAIL_SUT_GATE        case 3: real exec_spawn_and_wait
//                                            (argc=0) returned any value
//                                            other than EX_ERR_BAD_ARGV
//                                            (0xFFFFEC21).
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module basename PascalCase (`TestExecAlignment`); no directory prefix.
//   - No `test` mnemonic; every zero-check via `cmp reg, 0`. The rsp % 16
//     extraction uses `and rax, 15; cmp rax, 0` (not `test rax, 15`).
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF (0, 8, and 15 all fit).
//     Large-imm sentinels (0xFFFFEDFx fail codes, 0xFFFFEC21 EX_ERR_BAD_ARGV)
//     via `mov r10, imm32` (paideia-as accepts imm32 directly; the `and r,
//     imm64` pitfall from feedback_pdx_encoder_pitfalls is avoided by using
//     an imm8 mask (15) in the alignment extraction).
//   - r11 (paideia-as reserved) untouched.
//   - No memory reads or byte writes; no `mov_b` needed.
//   - Every non-leaf test entry balances pushes with pops; the replica
//     cases carry no `sub rsp, K` after their prologue (case 1) or exactly
//     one `sub rsp, 8` + matching `add rsp, 8` (case 2), so the epilogue
//     pop count matches the prologue push count.
//   - Labels prefixed `teal_`. Reserved-word discipline: labels avoid
//     `loop`, `if`, etc. per reference_paideia_as_reserved_labels.
//
// =============================================================================
// FINGERPRINT EMISSION
// =============================================================================
//
// `teal_run_all` emits `EXEC ALIGN OK\n` (14 bytes) via sys_write(1, ...)
// on all-pass. The paideia-os QEMU boot smoke can grep-assert this string
// alongside `SHELL FORK OK pid=<n>` and `SHELL RECONCILE n=<c>` once the
// shell is wired into `bin_seeds.pdx`. The write is skipped on any case
// failure (short-circuit at first non-zero), so a boot log carrying
// `EXEC ALIGN OK` is a positive attestation that the fork/exec-path
// alignment invariant held on this boot.

module TestExecAlignment = structure {

  // ==========================================================================
  // Fail-code band 0xFFFFEDFx (disjoint from every existing 0xFFFFEDxx band
  // per the grep audit in the module header)
  // ==========================================================================
  pub let TEAL_PASS           : u64 = 0
  pub let TEAL_FAIL_CURRENT   : u64 = 0xFFFFEDF0
  pub let TEAL_FAIL_LANDMINE  : u64 = 0xFFFFEDF1
  pub let TEAL_FAIL_SUT_GATE  : u64 = 0xFFFFEDF2

  // ==========================================================================
  // Fingerprint literal for teal_run_all's all-pass emission.
  //
  // N in `[u8; N]` = strlen + 1 per the paideia-as fingerprint-string rule
  // (feedback_pdx_encoder_pitfalls): payload is "EXEC ALIGN OK\n" (14
  // bytes) + trailing NUL = 15. sys_write's count excludes the NUL.
  // ==========================================================================
  pub let teal_fp_align_ok_str : [u8; 15] = "EXEC ALIGN OK\n\0"
  pub let TEAL_FP_ALIGN_OK_LEN : u64 = 14

  // ==========================================================================
  // teal_case_replica_current_prologue() -> u64
  //
  // Reproduce the POST-88580b5 exec_spawn_and_wait prologue:
  //
  //   push rbx;     // \
  //   push r12;     //  \
  //   push r13;     //   > 5 callee-save pushes = 40 bytes.
  //   push r14;     //  /
  //   push r15;     // /
  //   (NO `sub rsp, 8`)
  //
  // Entry rsp % 16 == 8 (SysV: after CALL pushes 8-byte return addr on
  // top of a 16-aligned caller rsp). Five 8-byte pushes take rsp down
  // 40 bytes, which flips rsp % 16 five times (8 -> 0 -> 8 -> 0 -> 8 -> 0).
  // Post-prologue rsp % 16 == 0, which is the invariant every nested
  // SysV CALL below the prologue requires.
  //
  // The witness is `mov rax, rsp; and rax, 15; cmp rax, 0` -- if the
  // and-mask returns 0 the invariant holds; any non-zero result is a
  // FAIL_CURRENT sentinel. This is the arithmetic equivalent of a
  // `movaps [rsp], xmm0` probe against a 16-byte-reserved stack
  // scratch; when paideia-as gains `Mnemonic::Movaps` the arithmetic
  // witness upgrades to a hard-fault probe (see module-header §"FUTURE
  // ENHANCEMENT").
  // ==========================================================================
  pub let teal_case_replica_current_prologue : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell#44 retroactive alignment regression witness: reproduce the POST-88580b5 exec_spawn_and_wait prologue (5 callee-save pushes: rbx, r12, r13, r14, r15; NO trailing `sub rsp, 8`) and assert `rsp % 16 == 0` at the point the SUT would fire its first nested SysV CALL. This is the executable form of the invariant the SUT's justification-comment names ('rsp % 16 == 0 at every nested SysV call'). The arithmetic witness (`mov rax, rsp; and rax, 15; cmp rax, 0`) is the paideia-as-0.36-compatible substitute for a `movaps [rsp], xmm0` probe -- packed-SSE emission is deferred at #1333 (scalar-float only). Effect/capability set is `{mem} @{}` because push/pop touches the stack; no user memory is read or written. Register plan: rax = compare scratch (returned as sentinel on fail); no callee-save state to protect beyond the 5 pushes the prologue itself carries (which the epilogue balances). Labels prefixed `teal_rcp_`. Reserved-word discipline: no `loop`/`if`/etc.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // NO `sub rsp, 8` -- the removal is the fix that shell#19
        // (88580b5) landed retroactively. Entry rsp%16 was 8; after
        // 5 pushes rsp%16 == 0. This IS the invariant the fix
        // restores.

        // Arithmetic alignment witness.
        mov rax, rsp;
        and rax, 15;
        cmp rax, 0;
        jne teal_rcp_fail;

        // Success: rsp % 16 == 0 at the nested-call site.
        xor rax, rax;                        // TEAL_PASS
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      teal_rcp_fail:
        mov rax, 0xFFFFEDF0;                 // TEAL_FAIL_CURRENT
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // teal_case_replica_landmine_prologue() -> u64
  //
  // Reproduce the PRE-88580b5 (buggy) exec_spawn_and_wait prologue:
  //
  //   push rbx;
  //   push r12;
  //   push r13;
  //   push r14;
  //   push r15;
  //   sub  rsp, 8;                          // <-- THIS was the landmine.
  //
  // Entry rsp % 16 == 8; after 5 pushes rsp % 16 == 0; `sub rsp, 8`
  // moves rsp % 16 back to 8. Every nested CALL below this prologue
  // would run with rsp % 16 == 8 -- a silent misalignment that would
  // #GP the first SSE-aligned callee.
  //
  // This case ASSERTS the landmine's mechanism: it must observe
  // rsp % 16 == 8 after the stray `sub rsp, 8`. If the assertion
  // holds, the bug's mechanism is documented executably; if it does
  // NOT hold (e.g. paideia-as changed how push/sub interact with the
  // stack pointer, or the SysV entry rsp % 16 discipline changed
  // upstream), that itself is a review-time alarm.
  //
  // The `add rsp, 8` epilogue restores stack balance so the pop
  // sequence walks the correct addresses. No local slot at [rsp+0..7]
  // is touched -- the sub/add pair is a pure alignment-perturbing
  // no-op, mirroring the pre-fix code's actual shape (the removed
  // `sub rsp, 8` had no dependent local reads either -- that's why
  // 88580b5 could remove it without any other changes).
  // ==========================================================================
  pub let teal_case_replica_landmine_prologue : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "shell#44 retroactive alignment landmine COUNTER-EXAMPLE witness: reproduce the PRE-88580b5 (buggy) exec_spawn_and_wait prologue (5 callee-save pushes + `sub rsp, 8`) and assert `rsp % 16 == 8` at the point the SUT would fire its first nested SysV CALL. Documents the mechanism by which the landmine misaligned every nested call: 5 pushes take entry rsp%16 from 8 to 0, then the stray `sub rsp, 8` moves it back to 8. The `add rsp, 8` epilogue restores stack balance so pop hits the right addresses (this pure sub/add pair is a no-op for balance, and a landmine for alignment). The case PASSES if the counter-example holds (rsp%16 observed as 8 post-`sub rsp, 8`); a FAIL_LANDMINE sentinel fires only if the SysV entry convention itself drifted -- a review-time alarm on the invariant space rather than a bug in this repo. If a future refactor reintroduces the buggy prologue to the SUT AND updates the CURRENT case's replica in sync, this LANDMINE case flips to also reading rsp%16==0, which the assertion here catches as a FAIL. Effect/capability set matches the CURRENT case ({mem} @{}). Labels prefixed `teal_rlp_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                          // THE LANDMINE (documented; removed at 88580b5).

        // Arithmetic alignment witness: expect rsp % 16 == 8.
        mov rax, rsp;
        and rax, 15;
        cmp rax, 8;
        jne teal_rlp_fail;

        // Success: counter-example held -- pre-fix shape misaligned as documented.
        xor rax, rax;                        // TEAL_PASS
        add rsp, 8;                          // balance the sub rsp, 8 above.
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      teal_rlp_fail:
        mov rax, 0xFFFFEDF1;                 // TEAL_FAIL_LANDMINE
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // teal_case_sut_gate_roundtrip() -> u64
  //
  // Round-trip the REAL exec_spawn_and_wait through its BAD_ARGV gate
  // path (argc=0) and verify EX_ERR_BAD_ARGV (0xFFFFEC21) comes back.
  // The gate fires BEFORE any nested substrate call, so this case
  // does NOT strictly probe alignment at the nested-call site --
  // instead it proves the SUT's real prologue/epilogue push+pop
  // balance survives one full traversal on the shortest reject path.
  //
  // (A misaligned prologue with a matching mis-add-rsp epilogue is
  // stack-balanced; the alignment landmine is orthogonal to balance.
  // The strict alignment proof for the real SUT waits on either a
  // movaps-emitting callee or a lint pass over src/exec.pdx that
  // parses the prologue token stream. Cases 1 and 2 cover the
  // arithmetic-shape half in the meantime.)
  //
  // Argc=0 is the smallest gate the SUT catches (SW_GATE_ARGC in
  // tests/test_exec.pdx). The other two inputs are non-null / non-zero
  // so only the argc==0 branch fires.
  //
  // Effect/capability set matches exec_spawn_and_wait's own
  // ({mem, sysreg} @{sched, mem, fs}) even though the call short-
  // circuits before any syscall -- the compiler unions call-graph
  // effects statically. Prologue: 1 push + `sub rsp, 8` = 16 bytes;
  // rsp % 16 == 0 for the SysV call.
  // ==========================================================================
  pub let teal_case_sut_gate_roundtrip : () -> u64 !{mem, sysreg} @{sched, mem, fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem, fs},
      justification: "shell#44 retroactive alignment regression: round-trip proof against the REAL exec_spawn_and_wait via its BAD_ARGV gate path (argc=0). Verifies the SUT returns EX_ERR_BAD_ARGV (0xFFFFEC21) without crashing, proving its prologue/epilogue push+pop balance survives one traversal. This is NOT a strict alignment probe (the gate fires before any nested CALL, so a misaligned prologue with a matching mis-`add rsp` epilogue would still balance-round-trip without #GP) but it's the low-cost witness that at least confirms the SUT's stack frame shape is end-to-end consistent. Cases 1 and 2 carry the arithmetic-shape half of the alignment proof against a REPLICA of the same prologue. The real SUT-alignment probe waits on either paideia-as gaining `Mnemonic::Movaps` (#1333 deferred) so a `movaps [rsp], xmm0` callee can be injected downstream of the SUT's first CALL site, or a lint pass over src/exec.pdx that parses the prologue token stream and rejects a stray `sub rsp, 8` after 5 callee-save pushes. Large-imm 0xFFFFEC21 compare via `mov r10, imm32; cmp rax, r10` (imm32 discipline; the shell repo uses this idiom throughout -- see test_syscall_floor tsf_case_write's 0xFFFFED4x compares). 1 push + `sub rsp, 8` prologue keeps rsp%16==0 for the nested SysV call. Labels prefixed `teal_sgr_`.",
      block: {
        push r12;
        sub rsp, 8;

        // exec_spawn_and_wait(argv_pool_ptr, argv_bytes, argc=0).
        // Any non-null / non-zero values for the first two args are
        // fine -- the argc==0 gate fires first per the SUT's argument-
        // check order (pool != 0, argv_bytes > 0, argc > 0).
        //
        // We pass argv_pool_ptr=1 (arbitrary non-null; the gate reads
        // the compare, not the memory) and argv_bytes=1 (non-zero) so
        // only the argc==0 branch takes.
        mov rdi, 1;
        mov rsi, 1;
        xor rdx, rdx;                        // argc = 0
        call exec_spawn_and_wait;

        // Expect EX_ERR_BAD_ARGV (0xFFFFEC21). imm32 stage.
        mov r10, 0xFFFFEC21;
        cmp rax, r10;
        jne teal_sgr_fail;

        // Success.
        xor rax, rax;                        // TEAL_PASS
        add rsp, 8;
        pop r12;
        ret;

      teal_sgr_fail:
        mov rax, 0xFFFFEDF2;                 // TEAL_FAIL_SUT_GATE
        add rsp, 8;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // teal_run_all() -> u64
  //
  // Umbrella: run all three cases in order; on all-pass emit the
  // `EXEC ALIGN OK\n` fingerprint via sys_write(1, ...). Short-
  // circuit at first non-zero return (same discipline as
  // tsm_run_all / tsf_run_all / tex_run_all).
  //
  // The paideia-os QEMU boot smoke can grep-assert `EXEC ALIGN OK`
  // alongside the `SHELL FORK OK pid=<n>` and `SHELL RECONCILE n=<c>`
  // fingerprints once the shell is wired into `bin_seeds.pdx`; a
  // boot log carrying the string is positive attestation that the
  // fork/exec-path alignment invariant held on this boot.
  //
  // Prologue: 1 push + `sub rsp, 8` = 16 bytes; rsp%16==0 for the
  // nested SysV calls.
  // ==========================================================================
  pub let teal_run_all : () -> u64 !{mem, sysreg} @{sched, mem, fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem, fs},
      justification: "shell#44 retroactive alignment regression umbrella: sequential invocation of teal_case_replica_current_prologue -> teal_case_replica_landmine_prologue -> teal_case_sut_gate_roundtrip; short-circuit at first non-zero return. On all-pass, emit `EXEC ALIGN OK\\n` (14 bytes) via sys_write(1, teal_fp_align_ok_str, 14); the paideia-os QEMU boot smoke greps this alongside SHELL FORK OK / SHELL RECONCILE fingerprints post-#33 shell wiring into bin_seeds.pdx. Effect/capability set is the union of the widest case (case 3: exec_spawn_and_wait's {mem, sysreg} @{sched, mem, fs}) plus sys_write's own {mem, sysreg} @{fs}; the union collapses to case 3's set (superset). Prologue: 1 push + `sub rsp, 8` = 16 bytes; rsp%16==0 for the nested calls. Labels prefixed `teal_ra_`.",
      block: {
        push rbx;
        sub rsp, 8;

        call teal_case_replica_current_prologue;
        cmp rax, 0;
        jne teal_ra_out;

        call teal_case_replica_landmine_prologue;
        cmp rax, 0;
        jne teal_ra_out;

        call teal_case_sut_gate_roundtrip;
        cmp rax, 0;
        jne teal_ra_out;

        // All-pass fingerprint emission.
        mov rdi, 1;                          // fd = stdout
        lea rsi, [rip + teal_fp_align_ok_str];
        mov rdx, 14;                         // TEAL_FP_ALIGN_OK_LEN
        call sys_write;
        // sys_write's return is not checked here -- a short write does
        // not invalidate the alignment property the three cases just
        // proved; it only means the boot-smoke grep may miss the
        // attestation for this boot. The cases have already returned
        // their pass sentinels.

        xor rax, rax;                        // TEAL_PASS
        add rsp, 8;
        pop rbx;
        ret;

      teal_ra_out:
        // rax already holds the failing case's sentinel.
        add rsp, 8;
        pop rbx;
        ret
      }
    }
}
